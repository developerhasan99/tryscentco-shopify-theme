{{ 'fmx-base.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
{{ 'fmx-sections.css' | asset_url | stylesheet_tag }}
{{ 'fmx-s-faq-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .premium .pm-faq--{{ section.id }} .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .premium .pm-faq--{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="premium">
  <div class="pm-faq pm-faq--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="collapsible-content collapsible-none-layout isolate content-container content-container--full-width">
      <div class="collapsible-content__wrapper section-{{ section.id }}-padding">
        <div class="collapsible-content-wrapper-narrow">
          <div class="collapsible-content__header pm-faq__header pm-faq__header--{{ section.settings.heading_alignment }}">
            {%- if section.settings.caption != blank -%}
              <p class="caption-with-letter-spacing">
                {{ section.settings.caption | escape }}
              </p>
            {% endif %}
            {%- if section.settings.heading != blank -%}
              <h2 class="collapsible-content__heading inline-richtext pm-h2">
                {{ section.settings.heading }}
              </h2>
            {%- else -%}
              <h2 class="visually-hidden">Vanliga frågor</h2>
            {% endif %}
          </div>
          <div class="pm-faq__rows">
            {%- for block in section.blocks -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  {% if section.settings.open_first_collapsible_row and forloop.first %}
                    open
                  {% endif %}
                >
                  <summary id="Summary-{{ block.id }}-{{ section.id }}">
                    <h3 class="accordion__title inline-richtext">
                      {{ block.settings.heading | escape }}
                    </h3>
                  </summary>
                  <div
                    class="accordion__content rte"
                    id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                    role="region"
                    aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                  >
                    {{ block.settings.row_content }}
                  </div>
                </details>
              </div>
            {%- endfor -%}
          </div>
          {%- if section.settings.closing_text != blank -%}
            <div class="pm-faq__closing rte">
              {{ section.settings.closing_text }}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FM FAQ (test)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Vanliga frågor"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "closing_text",
      "label": "Closing text",
      "info": "Shown below the rows. Links allowed."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "open_first_collapsible_row",
      "label": "Open the first row",
      "default": false
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "info": "Half of this value below 990px.",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collapsible_row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Question",
          "default": "Fråga"
        },
        {
          "type": "richtext",
          "id": "row_content",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FM FAQ (test)",
      "blocks": [
        { "type": "collapsible_row" },
        { "type": "collapsible_row" },
        { "type": "collapsible_row" }
      ]
    }
  ]
}
{% endschema %}
