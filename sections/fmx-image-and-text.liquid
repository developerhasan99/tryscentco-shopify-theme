        "label": "Content Vertical Alignment",
        "id": "content_alignment",
        "options": [
            {
                "value": "baseline",
                "label": "Baseline"
            },
            {
                "value": "center",
                "label": "Center"
            },
            {
                "value": "end",
                "label": "End"
            }
        ],
