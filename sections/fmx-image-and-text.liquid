{{ 'fmx-base.css' | asset_url | stylesheet_tag }}
{{ 'fmx-s-image-and-text.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  fmx-image-and-text (A/B test, FM look): split / card section with optional video (muted loop, plays when in view).
  Ported from the tryscent.eu premium image-and-text. Colours come from the colour scheme and pm tokens.
{%- endcomment -%}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  assign split_image = section.settings.image
  assign split_video = section.settings.video
  assign has_media = false
  if split_video != blank or split_image != blank
    assign has_media = true
  endif
  assign card_layout = false
  if section.settings.layout == 'card'
    assign card_layout = true
  endif
  assign split_align = 'center'
  if section.settings.content_alignment == 'baseline'
    assign split_align = 'flex-start'
  elsif section.settings.content_alignment == 'end'
    assign split_align = 'flex-end'
  endif
-%}
{%- style -%}
  .premium .pm-split--{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --pm-split-blocks-gap: {{ section.settings.blocks_gap }}px;
    --pm-split-align: {{ split_align }};
    {%- if section.settings.bg_mobile_image != blank %}
    background-image: url('{{ section.settings.bg_mobile_image | image_url: width: 1920 }}');
    background-size: cover;
    background-position: center;
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    .premium .pm-split--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {%- if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      {%- endif %}
    }
  }
{%- endstyle -%}

<div class="premium">
<div id="fmx-split-{{ section.id }}" class="pm-split pm-split--{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.image_placement == '1' %} pm-split--image-second{% endif %}{% if card_layout %} pm-split--card{% else %}{% if section.settings.rounded_image %} pm-split--rounded{% endif %}{% if section.settings.mobile_image_placement == 'under_heading' %} pm-split--image-under-heading{% endif %}{% endif %}">
  <div class="pm-split__grid">
    {%- if has_media -%}
      <div class="pm-split__media">
        {%- if split_video != blank -%}
          {{ split_video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', image_size: '1200x', class: 'pm-split__img pm-split__video' }}
        {%- elsif card_layout -%}
          <img
            class="pm-split__img"
            src="{{ split_image | image_url: width: 900 }}"
            srcset="{{ split_image | image_url: width: 600 }} 600w, {{ split_image | image_url: width: 900 }} 900w, {{ split_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 50vw, (min-width: 750px) 600px, calc(100vw - 40px)"
            alt="{{ split_image.alt | escape }}"
            width="{{ split_image.width }}"
            height="{{ split_image.height }}"
            fetchpriority="{{ fetch_priority }}"
            {% unless fetch_priority == 'high' %}loading="lazy"{% endunless %}>
        {%- else -%}
          <img
            class="pm-split__img"
            src="{{ split_image | image_url: width: 1500 }}"
            srcset="{{ split_image | image_url: width: 750 }} 750w, {{ split_image | image_url: width: 1100 }} 1100w, {{ split_image | image_url: width: 1500 }} 1500w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ split_image.alt | escape }}"
            width="{{ split_image.width }}"
            height="{{ split_image.height }}"
            fetchpriority="{{ fetch_priority }}"
            {% unless fetch_priority == 'high' %}loading="lazy"{% endunless %}>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="pm-split__panel">
      <div class="pm-split__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pm-eyebrow pm-muted pm-split__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- unless card_layout -%}
                {%- style -%}
                  .premium .pm-split .block-{{ block.id }}-class {
                    --pm-split-heading-size: {{ block.settings.mobile_font_size }}px;
                  }

                  @media screen and (min-width: 750px) {
                    .premium .pm-split .block-{{ block.id }}-class {
                      --pm-split-heading-size: {{ block.settings.font_size }}px;
                    }
                  }
                {%- endstyle -%}
              {%- endunless -%}
              <{{ block.settings.heading_type }} class="pm-split__heading block-{{ block.id }}-class" {{ block.shopify_attributes }}>{{ block.settings.content }}</{{ block.settings.heading_type }}>
              {%- if card_layout == false and section.settings.mobile_image_placement == 'under_heading' and has_media -%}
                <div class="pm-split__media pm-split__media--inline">
                  {%- if split_video != blank -%}
                    {{ split_video | video_tag: muted: true, loop: true, playsinline: true, preload: 'none', image_size: '750x', class: 'pm-split__img pm-split__video' }}
                  {%- else -%}
                  <img
                    class="pm-split__img"
                    src="{{ split_image | image_url: width: 750 }}"
                    srcset="{{ split_image | image_url: width: 375 }} 375w, {{ split_image | image_url: width: 750 }} 750w"
                    sizes="100vw"
                    alt="{{ split_image.alt | escape }}"
                    width="{{ split_image.width }}"
                    height="{{ split_image.height }}"
                    loading="lazy">
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- when 'text' -%}
              {%- unless card_layout -%}
                {%- style -%}
                  .premium .pm-split .block-{{ block.id }}-class {
                    --pm-split-text-size: {{ block.settings.font_size }}px;
                  }
                {%- endstyle -%}
              {%- endunless -%}
              <div class="pm-split__text block-{{ block.id }}-class" {{ block.shopify_attributes }}>
                <div class="pm-split__rte rte{% if block.settings.mobile_content != blank %} pm-split__rte--desktop{% endif %}">
                  {{ block.settings.content }}
                </div>
                {%- if block.settings.mobile_content != blank -%}
                  <div class="pm-split__rte rte pm-split__rte--mobile">
                    {{ block.settings.mobile_content }}
                  </div>
                {%- endif -%}
              </div>
            {%- when 'button' -%}
              {%- if card_layout -%}
                {%- if block.settings.button_text != blank and block.settings.button_url != blank -%}
                  <div class="pm-split__cta" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.button_url }}" class="pm-btn pm-btn--primary pm-split__btn">{{ block.settings.button_text }}</a>
                  </div>
                {%- endif -%}
              {%- elsif block.settings.button_text != blank -%}
                <div class="pm-split__cta" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.button_url }}" class="pm-btn pm-btn--link">{{ block.settings.button_text }}</a>
                </div>
              {%- endif -%}
            {%- when 'point' -%}
              <div class="pm-split__point" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <img
                    class="pm-split__point-icon"
                    src="{{ block.settings.icon | image_url: width: 96 }}"
                    alt="{{ block.settings.icon.alt | escape }}"
                    width="32"
                    height="32"
                    loading="lazy">
                {%- endif -%}
                <div class="pm-split__point-body">
                  <h3 class="pm-h3 pm-split__point-heading">{{ block.settings.heading }}</h3>
                  <div class="pm-split__rte rte{% if block.settings.mobile_description != blank %} pm-split__rte--desktop{% endif %}">
                    {{ block.settings.description }}
                  </div>
                  {%- if block.settings.mobile_description != blank -%}
                    <div class="pm-split__rte rte pm-split__rte--mobile">
                      {{ block.settings.mobile_description }}
                    </div>
                  {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if card_layout -%}
          {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
            <div class="pm-split__cta">
              <a href="{{ section.settings.button_url }}" class="pm-btn pm-btn--primary pm-split__btn">{{ section.settings.button_text }}</a>
            </div>
          {%- endif -%}
        {%- elsif section.settings.button_text != blank -%}
          <div class="pm-split__cta">
            <a href="{{ section.settings.button_url }}" class="pm-btn pm-btn--link">{{ section.settings.button_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
</div>

{%- if split_video != blank -%}
  <script>
    (function () {
      var videos = document.querySelectorAll('.pm-split--{{ section.id }} video');
      if (!videos.length) return;
      // First play starts at the section's start point (% of the video), later loops from 0.
      var startAt = {{ section.settings.video_start | default: 0 }} / 100;
      var seek = function (v) {
        if (v.dataset.started) return;
        v.dataset.started = '1';
        if (!startAt) return;
        var go = function () {
          if (v.duration) v.currentTime = v.duration * startAt;
        };
        if (v.readyState >= 1) go();
        else v.addEventListener('loadedmetadata', go, { once: true });
      };
      var play = function (v) {
        v.muted = true;
        seek(v);
        var p = v.play();
        if (p && p.catch) p.catch(function () {});
      };
      if (!('IntersectionObserver' in window)) {
        videos.forEach(play);
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) play(e.target);
            else e.target.pause();
          });
        },
        { rootMargin: '200px 0px' }
      );
      videos.forEach(function (v) {
        io.observe(v);
      });
    })();
  </script>
{%- endif -%}

{% schema %}
  {
    "name": "FM Bild och text (test)",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      },
      {
        "type": "image_picker",
        "id": "bg_image",
