        "type": "image_picker",
        "id": "image",
        "label": "Section Image"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Section Video",
        "info": "Plays muted on a loop in place of the image. Leave empty to show the image."
      },
      {
        "type": "range",
        "id": "video_start",
        "label": "Video starts at",
        "info": "Point of the video where the first play starts. Later loops start from the beginning.",
