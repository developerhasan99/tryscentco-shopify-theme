{%- comment -%}
  fmx (FM payday page test): copy of sections/scent-bundle-builder-single.liquid ("Bundle builder 60% off",
  template product.payday-60) in FM's look, for the A/B template product.payday-60-fm. Markup, settings
  and the Alpine component sbbSingleBuilder are unchanged; generated by scratchpad make_section.py.
  Changes against the live section:
  - output wrapped in <div class="premium fmx-payday"> (FM tokens, assets/fmx-base.css) and restyled by
    assets/fmx-payday.css (loaded after the live builder CSS): white page, ink #232323, hairlines,
    4px radius, ink buttons, sale red only on discounts;
  - search field + 3 selects replaced by the magicperfume.co collection filter bar (pill dropdowns Sortera /
    Tillfälle / Märke / Kön with counts, multi-select, "Rensa alla"; full-screen drawer below 990px; pill
    search field underneath, matching name or brand); Alpine state brands / genders / occasions / sort;
    Unisex added as a gender option;
  - bottle slots in one compact row; a picked slot shows the bottle photo, the scent name is its alt text;
  - gallery = snippets/fmx-payday-gallery.liquid (live gallery without the market's first image);
  - under the buy button the FM product page's payment icons + badge row (snippets fmx-payment-icons,
    fmx-shipping-badges) replace the single guarantee pill;
  - section settings fmx_font_body / fmx_font_heading (font pickers, Figtree) set --fmx-font-body /
    --fmx-font-heading on .premium, as sections/fmx-main-product.liquid does.
{%- endcomment -%}
{%- liquid
  assign fmx_font_body = section.settings.fmx_font_body
  assign fmx_font_heading = section.settings.fmx_font_heading
  assign fmx_font_body_500 = fmx_font_body | font_modify: 'weight', '500'
  assign fmx_font_body_600 = fmx_font_body | font_modify: 'weight', '600'
  assign fmx_font_body_bold = fmx_font_body | font_modify: 'weight', 'bold'
  assign fmx_font_heading_900 = fmx_font_heading | font_modify: 'weight', '900'
-%}
{%- style -%}
  {{ fmx_font_body | font_face: font_display: 'swap' }}
  {%- if fmx_font_body_500 -%}{{ fmx_font_body_500 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if fmx_font_body_600 -%}{{ fmx_font_body_600 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if fmx_font_body_bold -%}{{ fmx_font_body_bold | font_face: font_display: 'swap' }}{%- endif -%}
  {{ fmx_font_heading | font_face: font_display: 'swap' }}
  {%- if fmx_font_heading_900 -%}{{ fmx_font_heading_900 | font_face: font_display: 'swap' }}{%- endif -%}
  .premium {
    --fmx-font-body: {{ fmx_font_body.family }}, {{ fmx_font_body.fallback_families }};
    --fmx-font-heading: {{ fmx_font_heading.family }}, {{ fmx_font_heading.fallback_families }};
  }
{%- endstyle -%}
{%- liquid
  assign st = section.settings
  assign grid_pool = st.grid_collection | default: collections['best-sellers']
  assign variant_ml = '50ml'

  assign b_total = st.bundle_total | plus: 0
  assign b_discount_qty = st.bundle_discount_qty | plus: 0
  assign b_paid = b_total | minus: b_discount_qty
  assign b_percent = st.discount_percent | plus: 0
  assign b_ribbon = 'Köp ' | append: b_paid | append: ', få ' | append: b_discount_qty | append: ' till med ' | append: b_percent | append: '% rabatt'

  assign parent_variant = product.selected_or_first_available_variant
  assign parent_price = parent_variant.price | default: 0
  assign parent_compare_at = parent_variant.compare_at_price | default: 0
  if parent_compare_at <= parent_price
    assign parent_compare_at = parent_price
  endif
  assign product_form_id = 'product-form-' | append: section.id

  assign eligible_handles = ''
  for p in grid_pool.products
    assign has_ml = false
    for v in p.variants
      assign vt = v.title | downcase | replace: ' ml', 'ml'
      if vt == variant_ml and v.available
        assign has_ml = true
        break
      endif
    endfor
    if has_ml
      assign eligible_handles = eligible_handles | append: '|' | append: p.handle | append: '|'
    endif
  endfor

  assign start_counter = st.counter_text | replace: '[selected]', 0 | replace: '[total]', b_total
  assign start_hint = st.hint_text | replace: '[remaining]', b_total
  if b_total == 1
    assign start_hint = st.hint_text_one
  endif
-%}

{{ 'scent-bundle-builder.css' | asset_url | stylesheet_tag }}
{{ 'scent-bundle-builder-single.css' | asset_url | stylesheet_tag }}
{{ 'fmx-base.css' | asset_url | stylesheet_tag }}
{{ 'fmx-payday.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

{% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
<div class="premium fmx-payday">
<div class="sbb sbb--single" x-data="sbbSingleBuilder()">
  <div class="sbb-top">
    {%- if product.images.size > 0 -%}
      <div class="sbb-gallery">
        {% render 'fmx-payday-gallery', variant_images: variant_images %}
      </div>
    {%- endif -%}

    <div class="sbb-content">
      <header class="sbb-head">
        {%- if st.offer_badge != blank -%}
          <span class="sbb-head__badge">{{ st.offer_badge | escape }}</span>
        {%- endif -%}
        {%- if st.heading != blank or st.heading_accent != blank -%}
          <h2 class="sbb-head__title">
            {{- st.heading | escape -}}
            {%- if st.heading_accent != blank %}
              <span class="sbb-head__title-accent">{{ st.heading_accent | escape }}</span>
            {% endif -%}
          </h2>
        {%- endif -%}
        {%- if st.subheading != blank -%}
          <div class="sbb-head__sub">{{ st.subheading }}</div>
        {%- endif -%}
      </header>

      <div class="sbb-builder" x-ref="preview">
        <div class="sbb-builder__main">
          <div class="sbb-slots">
            <template x-for="(s, i) in slotsArray" :key="i">
              <div
                class="sbb-slot"
                :class="{ 'sbb-slot--free': isDiscounted(i), 'sbb-slot--filled': slot(i) }"
                @click="scrollToPool()">
                <span class="sbb-slot__badge" x-text="i + 1"></span>
                <template x-if="slot(i)">
                  <span class="sbb-slot__pick">
                    <img
                      :src="slot(i).image"
                      :alt="slot(i).name"
                      width="80"
                      height="80">
                    <button
                      type="button"
                      class="sbb-slot__x"
                      @click.stop="removeAt(i)"
                      aria-label="Ta bort">&times;</button>
                  </span>
                </template>
                <template x-if="!slot(i)">
                  <svg
                    class="sbb-slot__bottle"
                    width="62"
                    height="120"
                    viewBox="0 0 62 120"
                    aria-hidden="true">
                    <rect
                      x="21.8"
                      y="0.8"
                      width="18.4"
                      height="26"
                      rx="3"></rect>
                    <rect
                      x="0.8"
                      y="26.8"
                      width="60.4"
                      height="92.4"
                      rx="8"></rect>
                  </svg>
                </template>
                <span
                  class="sbb-slot__label"
                  x-show="!slot(i)"
                  x-text="isDiscounted(i) ? {{ st.discount_slot_label | json | escape }} : {{ st.slot_label | json | escape }}"></span>
                <span class="sbb-slot__price" x-html="slotPriceHtml(i)"></span>
              </div>
            </template>
          </div>
          <div class="sbb-progress">
            <div class="sbb-progress__track">
              <div class="sbb-progress__fill" :style="'width: ' + percent + '%'"></div>
            </div>
            <p class="sbb-progress__copy">
              <span x-text="counter">{{ start_counter | escape }}</span>
              <span>&bull;</span>
              <span x-text="message">{{ start_hint | escape }}</span>
            </p>
          </div>
        </div>

        {%- if st.timer_deadline != blank -%}
          <div class="bb-timer" data-deadline="{{ st.timer_deadline | escape }}" hidden>
            <span class="bb-timer__label">{{ st.timer_label | escape }}</span>
            <div class="bb-timer__clock">
              <span class="bb-timer__unit" data-bb-timer-days><b data-bb-timer="d">00</b><small>{{ st.timer_days_label | escape }}</small></span>
              <span class="bb-timer__sep" data-bb-timer-days>:</span>
              <span class="bb-timer__unit"><b data-bb-timer="h">00</b><small>{{ st.timer_hours_label | escape }}</small></span>
              <span class="bb-timer__sep">:</span>
              <span class="bb-timer__unit"><b data-bb-timer="m">00</b><small>{{ st.timer_minutes_label | escape }}</small></span>
              <span class="bb-timer__sep">:</span>
              <span class="bb-timer__unit"><b data-bb-timer="s">00</b><small>{{ st.timer_seconds_label | escape }}</small></span>
            </div>
          </div>
        {%- endif -%}

        <div class="sbb-summary">
          <p class="sbb-summary__original">
            <span>{{ st.total_label | escape }}</span>
            <s x-text="money(ordTotal)">{{ 0 | money }}</s>
          </p>
          <p class="sbb-summary__now">
            <span class="sbb-summary__now-label">{{ st.price_label | escape }}</span>
            <span class="sbb-summary__now-price" x-text="money(yourPrice)">{{ 0 | money }}</span>
            <template x-if="discountPercent > 0">
              <span class="sbb-summary__now-percent" x-text="'(-' + discountPercent + '%)'"></span>
            </template>
          </p>
          <p class="sbb-summary__per-bottle" x-html="perBottleHtml"></p>
          <template x-if="discount > 0">
            <p class="sbb-summary__savings">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 11-14h-7l1-6z"></path></svg>
              <span x-text="savingsText"></span>
            </p>
          </template>
          {%- if parent_variant -%}
            <product-form x-ref="bundleForm" class="sbb-summary__form" data-hide-errors="true" data-section-id="{{ section.id }}">
              {%- form 'product'
                , product
                , id: product_form_id
                , class: 'sbb-summary__form-inner'
                , novalidate: 'novalidate'
                , data-type: 'add-to-cart-form'
              -%}
                <input type="hidden" name="id" value="{{ parent_variant.id }}" class="product-variant-id">
                <input type="hidden" name="properties[_bundle_items]" :value="picks.map(function (p) { return p.variantId; }).join(',')">
                <template x-for="(p, i) in picks" :key="p.id">
                  <input type="hidden" :name="'properties[Bottle ' + (i + 1) + ']'" :value="bottleProperty(p)">
                </template>
                <button
                  type="submit"
                  name="add"
                  class="sbb-summary__cta"
                  :disabled="!full || adding">
                  <span x-text="ctaLabel"></span>
                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
          {%- endif -%}
          <div class="fmx-payday-trust">
            {% render 'fmx-payment-icons' %}
            {% render 'fmx-shipping-badges', product: product %}
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%}
    Filter bar + search: magicperfume.co collection filter (snippets/mgx-filters.liquid + collection-search)
    rebuilt on this builder's own product list (Alpine, no page reload). From 990px a centred row of pill
    dropdowns (Sortera, Tillfälle, Märke, Kön) and a "Rensa alla" pill (greyed out until something is picked); below 990px one "Filtrera och sortera"
    pill that opens a full-screen drawer. Every tick applies at once. Search pill under the bar.
    Every UI label is page text (Weglot translates it); only store data (brand, occasion) and numbers
    come from Alpine.
  {%- endcomment -%}
  {%- capture fmx_fc_chev -%}
    <svg class="fmx-fc__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
  {%- endcapture -%}
  {%- capture fmx_fc_sort -%}
    {%- assign fmx_sorts = '|Bästsäljare;title-ascending|Alfabetiskt, A-Ö;title-descending|Alfabetiskt, Ö-A;price-ascending|Pris, lågt till högt;price-descending|Pris, högt till lågt' | split: ';' -%}
    {%- for s in fmx_sorts -%}
      {%- assign s_parts = s | split: '|' -%}
      {%- assign s_value = s_parts[0] | default: '' -%}
      {%- if s_parts.size == 1 -%}{%- assign s_label = s_parts[0] -%}{%- assign s_value = '' -%}{%- else -%}{%- assign s_label = s_parts[1] -%}{%- endif -%}
      <label class="fmx-fc__opt">
        <input type="radio" :checked="isOn('sort', '{{ s_value }}')" @change="pick('sort', '{{ s_value }}')">
        <span class="fmx-fc__label" data-sort-label="{{ s_value }}">{{ s_label }}</span>
      </label>
    {%- endfor -%}
  {%- endcapture -%}
  {%- capture fmx_fc_occasion -%}
    <template x-for="o in fcOptions('occasion')" :key="o.value">
      <label class="fmx-fc__opt" :class="{ 'is-off': o.off }">
        <input type="checkbox" :checked="isOn('occasion', o.value)" :disabled="o.off" @change="pick('occasion', o.value)">
        <span class="fmx-fc__label" x-text="o.value"></span>
        <span class="fmx-fc__n" x-text="o.count"></span>
      </label>
    </template>
  {%- endcapture -%}
  {%- capture fmx_fc_brand -%}
    <template x-for="o in fcOptions('brand')" :key="o.value">
      <label class="fmx-fc__opt" :class="{ 'is-off': o.off }">
        <input type="checkbox" :checked="isOn('brand', o.value)" :disabled="o.off" @change="pick('brand', o.value)">
        <span class="fmx-fc__label" x-text="o.value"></span>
        <span class="fmx-fc__n" x-text="o.count"></span>
      </label>
    </template>
  {%- endcapture -%}
  {%- capture fmx_fc_gender -%}
    {%- assign fmx_genders = 'men|För män;women|För kvinnor;unisex|Unisex' | split: ';' -%}
    {%- for g in fmx_genders -%}
      {%- assign g_parts = g | split: '|' -%}
      <label class="fmx-fc__opt" x-show="genderOptions.indexOf('{{ g_parts[0] }}') > -1" :class="{ 'is-off': fcIsOff('gender', '{{ g_parts[0] }}') }">
        <input type="checkbox" :checked="isOn('gender', '{{ g_parts[0] }}')" :disabled="fcIsOff('gender', '{{ g_parts[0] }}')" @change="pick('gender', '{{ g_parts[0] }}')">
        <span class="fmx-fc__label" data-gender-label="{{ g_parts[0] }}">{{ g_parts[1] }}</span>
        <span class="fmx-fc__n" x-text="fcCount('gender', '{{ g_parts[0] }}')"></span>
      </label>
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign fmx_fc_groups = 'sort|Sortera;occasion|Tillfälle;brand|Märke;gender|Kön' | split: ';' -%}

  <div
    class="sbb-controls fmx-fc"
    x-ref="pool"
    @keydown.escape.window="fcOpen = ''; fcDrawer = false"
    @click.outside="fcOpen = ''">
    <div class="fmx-fc__bar">
      {%- for grp in fmx_fc_groups -%}
        {%- assign grp_parts = grp | split: '|' -%}
        {%- assign grp_key = grp_parts[0] -%}
        <div
          class="fmx-fc__dd{% if forloop.last %} fmx-fc__dd--end{% endif %}"
          {% if grp_key == 'occasion' %}x-show="occasionOptions.length"{% elsif grp_key == 'brand' %}x-show="brandOptions.length"{% elsif grp_key == 'gender' %}x-show="genderOptions.length"{% endif %}>
          <button
            type="button"
            class="fmx-fc__pill"
            :aria-expanded="fcOpen === '{{ grp_key }}' ? 'true' : 'false'"
            @click="fcOpen = fcOpen === '{{ grp_key }}' ? '' : '{{ grp_key }}'">
            <span>{{ grp_parts[1] }}</span>
            {{ fmx_fc_chev }}
          </button>
          <div class="fmx-fc__panel fmx-fc__panel--{{ grp_key }}" role="group" aria-label="{{ grp_parts[1] }}" x-show="fcOpen === '{{ grp_key }}'" x-cloak>
            {%- case grp_key -%}
              {%- when 'sort' -%}{{ fmx_fc_sort }}
              {%- when 'occasion' -%}{{ fmx_fc_occasion }}
              {%- when 'brand' -%}{{ fmx_fc_brand }}
              {%- when 'gender' -%}{{ fmx_fc_gender }}
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
      <button type="button" class="fmx-fc__pill fmx-fc__reset" :disabled="!fcActive" @click="clearAll()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
        <span>Rensa alla</span>
      </button>
    </div>

    <div class="fmx-fc__mbar">
      <button type="button" class="fmx-fc__trigger" @click="fcDrawer = true">
        <span>Filtrera och sortera</span>
        <span x-show="fcActiveCount" x-cloak x-text="'(' + fcActiveCount + ')'"></span>
      </button>
      <button type="button" class="fmx-fc__mreset" x-show="fcActive" x-cloak @click="clearAll()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
        <span>Rensa alla</span>
      </button>
    </div>

    <div class="fmx-fc__drawer" role="dialog" aria-modal="true" aria-label="Filtrera och sortera" x-show="fcDrawer" x-cloak>
      <div class="fmx-fc__head">
        <span class="fmx-fc__title">Filtrera och sortera</span>
        <button type="button" class="fmx-fc__x" aria-label="Stäng" @click="fcDrawer = false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <div class="fmx-fc__body">
        {%- for grp in fmx_fc_groups -%}
          {%- assign grp_parts = grp | split: '|' -%}
          {%- assign grp_key = grp_parts[0] -%}
          <details
            class="fmx-fc__acc fmx-fc__acc--{{ grp_key }}"
            {% if grp_key == 'occasion' %}x-show="occasionOptions.length"{% elsif grp_key == 'brand' %}x-show="brandOptions.length"{% elsif grp_key == 'gender' %}x-show="genderOptions.length"{% endif %}>
            <summary>
              <span>{{ grp_parts[1] }}<span class="fmx-fc__sel" x-text="selText('{{ grp_key }}')"></span></span>
            </summary>
            <div class="fmx-fc__list">
              {%- case grp_key -%}
                {%- when 'sort' -%}{{ fmx_fc_sort }}
                {%- when 'occasion' -%}{{ fmx_fc_occasion }}
                {%- when 'brand' -%}{{ fmx_fc_brand }}
                {%- when 'gender' -%}{{ fmx_fc_gender }}
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
      <div class="fmx-fc__foot">
        <button type="button" class="fmx-fc__apply" @click="fcDrawer = false">
          <span>Visa</span>
          <span x-text="'(' + filtered.length + ')'"></span>
        </button>
        <button type="button" class="fmx-fc__clearlink" x-show="fcActive" x-cloak @click="clearAll()">Rensa alla</button>
      </div>
    </div>

    <div class="fmx-fc__search" role="search">
      <label class="visually-hidden" for="FmxSearch-{{ section.id }}">{{ st.search_placeholder | escape }}</label>
      <div class="fmx-fc__field">
        <svg class="fmx-fc__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
        <input
          id="FmxSearch-{{ section.id }}"
          class="fmx-fc__input"
          type="search"
          placeholder="{{ st.search_placeholder | escape }}"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="search"
          x-model="q"
          x-ref="searchInput"
          @keydown.enter.prevent>
        <button type="button" class="fmx-fc__xsearch" aria-label="Rensa sökningen" x-show="q" x-cloak @click="q = ''; $refs.searchInput.focus()">&times;</button>
      </div>
      <p class="fmx-fc__status" x-show="q.trim() && filtered.length" x-cloak x-text="searchStatus"></p>
    </div>
  </div>

  <div class="sbb-grid">
    <template x-for="p in visible" :key="p.id">
      <div class="sbb-card" :class="{ 'is-selected': isPicked(p.id) }">
        <button
          type="button"
          class="sbb-card__media"
          :aria-pressed="isPicked(p.id)"
          @click="toggle(p.id)">
          <img
            :src="p.image"
            :alt="p.name"
            width="280"
            height="280"
            loading="lazy">
          <template x-if="ribbon">
            <span class="sbb-card__ribbon" x-text="ribbon"></span>
          </template>
        </button>
        <button
          type="button"
          class="sbb-card__title"
          :aria-pressed="isPicked(p.id)"
          @click="toggle(p.id)"
          x-text="p.name"></button>
        <p class="sbb-card__price">
          <span x-text="money(p.price)"></span>
          <template x-if="p.compareAt > p.price">
            <s x-text="money(p.compareAt)"></s>
          </template>
          <span class="sbb-card__size">50 ml</span>
        </p>
        <button
          type="button"
          class="sbb-card__cta"
          :class="{ 'is-active': isPicked(p.id) }"
          :disabled="!canToggle(p.id)"
          @click="toggle(p.id)">
          <span x-text="isPicked(p.id) ? 'Tillagd' : {{ st.cta_label | json | escape }}"></span>
        </button>
      </div>
    </template>
  </div>
  <p class="sbb-empty" x-show="visible.length === 0">{{ st.empty_text | escape }}</p>
  <div
    class="sbb-load-sentinel"
    x-ref="loadMoreSentinel"
    x-show="visible.length < filtered.length"></div>

  <div class="sbb-sticky" :class="{ 'is-visible': showSticky }">
    <div class="sbb-sticky__container">
      <div class="sbb-sticky__inner">
        <div class="sbb-sticky__slots">
          <template x-for="(s, i) in slotsArray" :key="i">
            <div class="sbb-sticky__slot" :class="{ 'is-filled': slot(i), 'sbb-sticky__slot--free': isDiscounted(i) }">
              <span class="sbb-sticky__pill" x-show="isDiscounted(i)">{{ st.discount_pill_label | escape }}</span>
              <template x-if="slot(i)"><img
                  :src="slot(i).image"
                  alt=""
                  width="60"
                  height="60"></template>
              <template x-if="!slot(i)">
                <svg
                  class="sbb-sticky__bottle"
                  width="24"
                  height="44"
                  viewBox="0 0 24 44"
                  aria-hidden="true">
                  <rect
                    x="8.5"
                    y="0.5"
                    width="7"
                    height="9"
                    rx="1"></rect>
                  <rect
                    x="0.5"
                    y="9.5"
                    width="23"
                    height="34"
                    rx="3"></rect>
                </svg>
              </template>
            </div>
          </template>
        </div>
        <div class="sbb-sticky__mid">
          <p x-text="counter" class="sbb-counter">{{ start_counter | escape }}</p>
          <p x-text="message" class="sbb-message">{{ start_hint | escape }}</p>
        </div>
        <div class="sbb-sticky__buy">
          <span x-text="money(yourPrice)" class="sbb-sticky__price">{{ 0 | money }}</span>
          <button
            type="button"
            class="sbb-sticky__cta"
            :class="{ 'loading': adding }"
            :disabled="!full || adding"
            @click="submitBundleForm()">
            <span x-text="ctaLabel"></span>
            <div class="loading__spinner" :class="{ hidden: !adding }">
              {{ 'loading-spinner.svg' | inline_asset_content }}
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<script>
  document.addEventListener('alpine:init', function () {
    Alpine.data('sbbSingleBuilder', function () {
      return {
        moneyFormat: {{ shop.money_format | json }},
        showSticky: false,
        adding: false,
        q: '',
        brands: [],
        genders: [],
        occasions: [],
        sort: '',
        fcOpen: '',
        fcDrawer: false,
        visibleCount: 8,
        pageSize: 8,
        picks: [],
        total: {{ b_total }},
        discountQty: {{ b_discount_qty }},
        manualDiscountPercent: {{ b_percent }},
        ribbon: {{ b_ribbon | json }},
        parentPrice: {{ parent_price }},
        parentCompareAtPrice: {{ parent_compare_at }},
        products: [
          {%- for p in grid_pool.products -%}
            {%- assign handle_token = '|' | append: p.handle | append: '|' -%}
            {%- unless eligible_handles contains handle_token -%}{%- continue -%}{%- endunless -%}
            {%- assign match = blank -%}
            {%- for v in p.variants -%}
              {%- assign vt = v.title | downcase | replace: ' ml', 'ml' -%}
              {%- if vt == variant_ml and v.available -%}{%- assign match = v -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {
              id: {{ p.id }},
              name: {{ p.title | json }},
              url: {{ p.url | json }},
              image: {{ p.featured_image | image_url: width: 560 | json }},
              price: {{ match.price }},
              compareAt: {{ match.compare_at_price | default: 0 }},
              variantId: {{ match.id | json }},
              brand: {{ p.metafields.custom.brand.value | join: '||' | json }},
              gender: {{ p.type | json }},
              occasion: {{ p.metafields.custom.occasion | json }}
            },
          {%- endfor -%}
        ],
        init() {
          var self = this;
          this.$nextTick(function () {
            // Mirror the real submit button's loading state (set by product-form.js
            // during the actual add-to-cart request) onto `adding`, so the sticky
            // bar's proxy button can reflect the same disabled/spinner state.
            var submitBtn = self.$refs.bundleForm && self.$refs.bundleForm.querySelector('[type="submit"]');
            if (submitBtn && 'MutationObserver' in window) {
              var syncAdding = function () { self.adding = submitBtn.classList.contains('loading'); };
              new MutationObserver(syncAdding).observe(submitBtn, { attributes: true, attributeFilter: ['class'] });
            }
            if (self.$refs.preview && 'IntersectionObserver' in window) {
              var stickyObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                  self.showSticky = !entry.isIntersecting && entry.boundingClientRect.top < 0;
                });
              }, { threshold: 0 });
              stickyObserver.observe(self.$refs.preview);
            } else {
              self.showSticky = true;
            }
            var checkLoadMore = function () {
              if (!self.$refs.loadMoreSentinel || self.visibleCount >= self.filtered.length) return;
              var rect = self.$refs.loadMoreSentinel.getBoundingClientRect();
              if (rect.top < window.innerHeight + 400) {
                self.visibleCount += self.pageSize;
                self.$nextTick(checkLoadMore);
              }
            };
            var ticking = false;
            var onScroll = function () {
              if (ticking) return;
              ticking = true;
              window.requestAnimationFrame(function () {
                ticking = false;
                checkLoadMore();
              });
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll);
            checkLoadMore();
          });
          ['q', 'brands', 'genders', 'occasions', 'sort'].forEach(function (key) {
            self.$watch(key, function () { self.visibleCount = self.pageSize; });
          });
          self.$watch('fcDrawer', function (open) { document.documentElement.classList.toggle('fmx-fc-lock', open); });
        },
        scrollToPool() {
          if (!this.$refs.pool) return;
          this.$refs.pool.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (this.$refs.searchInput) {
            var input = this.$refs.searchInput;
            setTimeout(function () { input.focus({ preventScroll: true }); }, 400);
          }
        },
        get slotsArray() { return Array.from({ length: this.total }); },
        isDiscounted(i) { return i >= this.total - this.discountQty; },
        slotPrice(i) {
          var picked = this.slot(i);
          return picked ? picked.price : this.perBottleOriginal;
        },
        slotPriceHtml(i) {
          var price = this.money(this.slotPrice(i));
          if (!this.isDiscounted(i)) return price;
          var freeLabel = {{ st.discount_pill_label | json }};
          return '<s>' + price + '</s> <span class="sbb-slot__price-free">' + freeLabel + '</span>';
        },
        get brandOptions() {
          var set = new Set();
          this.products.forEach(function (p) { p.brand.split('||').forEach(function (b) { if (b) set.add(b); }); });
          return Array.from(set).sort(function (a, b) { return a.localeCompare(b, 'sv'); });
        },
        genderBucket(raw) {
          var g = (raw || '').trim().toLowerCase();
          if (!g) return '';
          var men = ['voor mannen', 'pour homme', 'für männer', 'fur manner', 'herren', 'för män', 'herr', 'herrar', 'homme', 'men', 'for men'];
          var women = ['voor vrouwen', 'pour femme', 'für frauen', 'fur frauen', 'damen', 'för kvinnor', 'dam', 'damer', 'femme', 'women', 'for women'];
          if (men.indexOf(g) > -1) return 'men';
          if (women.indexOf(g) > -1) return 'women';
          if (g === 'unisex') return 'unisex';
          return '';
        },
        genderLabel(key) {
          return key === 'men' ? 'För män' : key === 'women' ? 'För kvinnor' : key === 'unisex' ? 'Unisex' : '';
        },
        get genderOptions() {
          var self = this;
          var set = new Set();
          this.products.forEach(function (p) { p.gender.split('||').forEach(function (g) { var b = self.genderBucket(g); if (b) set.add(b); }); });
          return ['men', 'women', 'unisex'].filter(function (g) { return set.has(g); });
        },
        get occasionOptions() {
          var set = new Set();
          this.products.forEach(function (p) { if (p.occasion) set.add(p.occasion); });
          return Array.from(set).sort(function (a, b) { return a.localeCompare(b, 'sv'); });
        },
        // Filter bar (magicperfume.co pattern): multi-select per group, counts reflect the other active groups
        hasValue(p, key, value) {
          if (key === 'brand') return p.brand.split('||').indexOf(value) > -1;
          if (key === 'gender') return p.gender.split('||').some(function (g) { return this.genderBucket(g) === value; }, this);
          if (key === 'occasion') return p.occasion === value;
          return false;
        },
        matches(p, skip) {
          var q = this.q.trim().toLowerCase();
          if (q && (p.name + ' ' + p.brand.split('||').join(' ')).toLowerCase().indexOf(q) === -1) return false;
          var groups = { brand: this.brands, gender: this.genders, occasion: this.occasions };
          for (var key in groups) {
            if (key === skip || !groups[key].length) continue;
            if (!groups[key].some(function (v) { return this.hasValue(p, key, v); }, this)) return false;
          }
          return true;
        },
        get filtered() {
          var list = this.products.filter(function (p) { return this.matches(p, ''); }, this);
          var s = this.sort;
          if (!s) return list;
          return list.slice().sort(function (a, b) {
            if (s.indexOf('title') === 0) {
              var r = a.name.localeCompare(b.name, 'sv');
              return s === 'title-ascending' ? r : -r;
            }
            var d = a.price - b.price;
            return s === 'price-ascending' ? d : -d;
          });
        },
        fcCount(key, value) {
          return this.products.filter(function (p) { return this.matches(p, key) && this.hasValue(p, key, value); }, this).length;
        },
        fcOptions(key) {
          var values = key === 'brand' ? this.brandOptions : this.occasionOptions;
          return values.map(function (v) {
            var n = this.fcCount(key, v);
            return { value: v, count: n, off: !n && !this.isOn(key, v) };
          }, this);
        },
        fcIsOff(key, value) { return !this.fcCount(key, value) && !this.isOn(key, value); },
        fcList(key) { return key === 'brand' ? 'brands' : key === 'gender' ? 'genders' : 'occasions'; },
        isOn(key, value) {
          if (key === 'sort') return this.sort === value;
          return this[this.fcList(key)].indexOf(value) > -1;
        },
        pick(key, value) {
          if (key === 'sort') {
            this.sort = value;
            this.fcOpen = '';
            return;
          }
          var list = this.fcList(key);
          var current = this[list];
          this[list] = current.indexOf(value) > -1
            ? current.filter(function (v) { return v !== value; })
            : current.concat([value]);
        },
        get fcActiveCount() { return this.brands.length + this.genders.length + this.occasions.length; },
        get fcActive() { return this.fcActiveCount > 0 || this.sort !== '' || this.q.trim() !== ''; },
        clearAll() {
          this.brands = [];
          this.genders = [];
          this.occasions = [];
          this.sort = '';
          this.q = '';
          this.fcOpen = '';
        },
        // Labels for the drawer summary come from the page text (data-*-label), so Weglot's translation shows
        labelFor(attr, value) {
          var el = this.$root.querySelector('[' + attr + '="' + value + '"]');
          return el ? el.textContent.trim() : value;
        },
        selText(key) {
          if (key === 'sort') return this.sort ? this.labelFor('data-sort-label', this.sort) : '';
          var self = this;
          return this[this.fcList(key)].map(function (v) { return key === 'gender' ? self.labelFor('data-gender-label', v) : v; }).join(', ');
        },
        get searchStatus() {
          var n = this.filtered.length;
          var q = this.q.trim();
          return n + (n === 1 ? ' träff' : ' träffar') + ' för ”' + q + '”';
        },
        get visible() {
          var list = this.filtered;
          return list.filter(function (p, i) { return this.isPicked(p.id) || i < this.visibleCount; }, this);
        },
        slot(i) { return this.picks[i] || null; },
        isPicked(id) { return this.picks.some(function (p) { return p.id === id; }); },
        canToggle(id) { return this.isPicked(id) || this.picks.length < this.total; },
        toggle(id) {
          if (this.isPicked(id)) {
            this.picks = this.picks.filter(function (p) { return p.id !== id; });
            return;
          }
          if (this.picks.length >= this.total) return;
          var product = this.products.find(function (p) { return p.id === id; });
          if (product) this.picks = this.picks.concat([product]);
        },
        removeAt(i) { this.picks.splice(i, 1); },
        get full() { return this.picks.length >= this.total; },
        get percent() { return this.total ? Math.min(100, Math.round((this.picks.length / this.total) * 100)) : 0; },
        get counter() { return {{ st.counter_text | json }}.replace('[selected]', this.picks.length).replace('[total]', this.total); },
        get message() {
          var remaining = Math.max(0, this.total - this.picks.length);
          if (remaining === 0) return {{ st.done_text | json }};
          if (remaining === 1) return {{ st.hint_text_one | json }};
          return {{ st.hint_text | json }}.replace('[remaining]', remaining);
        },
        get ctaLabel() {
          if (this.full) return {{ st.cta_button_label | json }};
          var remaining = Math.max(0, this.total - this.picks.length);
          if (remaining === 1) return {{ st.cta_disabled_label_one | json }};
          return {{ st.cta_disabled_label | json }}.replace('[remaining]', remaining);
        },
        // Rough single-product estimate used only as a fallback below when no
        // parent product is configured — individual 100ml prices actually vary
        // per product, so this is not a reliable stand-in once picks exist.
        get unitPrice() { return this.products.length ? this.products[0].price : 0; },
        // Price and savings shown in the summary come from the parent bundle
        // product (its compare-at price is the "original" total, its price is
        // what the customer actually pays for all {{ b_total }} bottles). If no
        // parent product is set, fall back to estimating from the grid price
        // and the manual discount settings.
        get ordTotal() {
          if (this.parentPrice) return this.parentCompareAtPrice;
          return this.unitPrice * this.total;
        },
        get yourPrice() {
          if (this.parentPrice) return this.parentPrice;
          var fallbackDiscount = Math.round(this.unitPrice * this.discountQty * (this.manualDiscountPercent / 100));
          return this.ordTotal - fallbackDiscount;
        },
        get discount() { return Math.max(0, this.ordTotal - this.yourPrice); },
        get discountPercent() {
          if (!this.ordTotal) return 0;
          return Math.round((this.discount / this.ordTotal) * 100);
        },
        get perBottleOriginal() {
          // Each 100ml bottle has its own regular price, so use the average
          // regular price of the bottles actually picked (falling back to the
          // first eligible product before anything is picked yet).
          if (!this.picks.length) return this.unitPrice;
          var sum = this.picks.reduce(function (acc, p) { return acc + p.price; }, 0);
          return sum / this.picks.length;
        },
        get perBottleNow() { return this.total ? this.yourPrice / this.total : 0; },
        get perBottleHtml() {
          var hasDiscount = this.perBottleOriginal > this.perBottleNow;
          var originalHtml = hasDiscount ? '<s>' + this.money(this.perBottleOriginal) + '</s>' : '';
          var nowHtml = this.money(this.perBottleNow);
          var label = {{ st.per_bottle_label | json }};
          return label
            .replace('[original_price]', originalHtml)
            .replace('[price]', nowHtml)
            .replace(/\s+/g, ' ')
            .trim();
        },
        get savingsText() {
          var label = {{ st.savings_label | json }};
          var amount = this.money(this.discount);
          return label.indexOf('[amount]') > -1 ? label.replace('[amount]', amount) : label + ' ' + amount;
        },
        money(cents) {
          var n = Math.round(Number(cents) || 0);
          var int = String(Math.floor(Math.abs(n) / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          var dec = String(Math.abs(n) % 100).padStart(2, '0');
          var out = String(this.moneyFormat || '{' + '{amount}' + '}').replace(/\{\{\s*amount\w*\s*\}\}/, int + '.' + dec).replace(/<[^>]+>/g, '');
          return (n < 0 ? '-' : '') + out;
        },
        bottleProperty(p) {
          var brand = (p.brand || '').split('||').filter(Boolean)[0];
          var label = p.name;
          if (brand) label += ' Inspired by ' + brand;
          return label + ' - 100ml';
        },
        submitBundleForm() {
          if (!this.full) return;
          var form = this.$refs.bundleForm && this.$refs.bundleForm.querySelector('form');
          if (form) form.requestSubmit();
        }
      };
    });
  });
</script>

<script>
  (function () {
    var timer = document.querySelector('#shopify-section-{{ section.id }} .bb-timer');
    if (!timer) return;

    var end = new Date(timer.dataset.deadline).getTime();
    if (isNaN(end)) return;

    var d = timer.querySelector('[data-bb-timer="d"]');
    var dayEls = timer.querySelectorAll('[data-bb-timer-days]');
    var h = timer.querySelector('[data-bb-timer="h"]');
    var m = timer.querySelector('[data-bb-timer="m"]');
    var s = timer.querySelector('[data-bb-timer="s"]');
    var interval;

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    function tick() {
      var left = Math.floor((end - Date.now()) / 1000);
      if (left <= 0) {
        timer.hidden = true;
        clearInterval(interval);
        return;
      }
      var days = Math.floor(left / 86400);
      // Hide the days box on the last day.
      for (var i = 0; i < dayEls.length; i++) dayEls[i].hidden = days === 0;
      d.textContent = pad(days);
      h.textContent = pad(Math.floor((left % 86400) / 3600));
      m.textContent = pad(Math.floor((left % 3600) / 60));
      s.textContent = pad(left % 60);
      timer.hidden = false;
    }

    tick();
    interval = setInterval(tick, 1000);
  })();
</script>

{%- if product.images.size > 1 -%}
  <script>
    (function () {
      function initSbbGallerySwiper() {
        if (typeof Swiper === 'undefined') return;
        var thumbsEl = document.getElementById('sbbGalleryThumbs-{{ section.id }}');
        var mainEl = document.getElementById('sbbGalleryMain-{{ section.id }}');
        if (!mainEl) return;

        var thumbs = new Swiper(thumbsEl, {
          slidesPerView: 4,
          spaceBetween: 10,
          freeMode: true,
          watchSlidesProgress: true,
        });

        new Swiper(mainEl, {
          slidesPerView: 1,
          spaceBetween: 10,
          navigation: {
            prevEl: document.getElementById('sbbGalleryPrev-{{ section.id }}'),
            nextEl: document.getElementById('sbbGalleryNext-{{ section.id }}'),
          },
          thumbs: {
            swiper: thumbs,
          },
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSbbGallerySwiper);
      } else {
        initSbbGallerySwiper();
      }
    })();
  </script>
{%- endif -%}

