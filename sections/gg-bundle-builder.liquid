{%- comment -%}
  gg-bundle-builder: "Selbst zusammenstellen" set builder of the Gift Guide (pattern: theessencevault.co.uk gift guide,
  #build-your-own). One card: filters (gift-set chips, search, gender, scent family) | scent list | "Dein Set" summary.
  Mobile: one column, the summary turns into a sticky bar at the bottom of the section with a slot rail.
  Data: pool = 50ml variants of the pool collection (same filters as pm-bundle-save), rendered as JSON for
  assets/gg-builder.js (<gg-builder>). Display data per scent from snippets/gg-scent-meta.liquid.
  Cart (assets/gg-core.js): ONE line = parent bundle variant (size from the leading number of option1) +
  "Flasche N" properties + _bundle_items (comma-joined 50ml variant ids), same contract as the store builders.
  Sizes: up to three parent products (default 3 / 6 / 9 bottles), one button each; the active size sets the
  slots, the price and the variant that goes into the cart. Only sizes with a product set are shown.
  Gift cards elsewhere on the page call GG.preset(ids) -> window 'gg:preset' -> this builder loads those scents.
{%- endcomment -%}
{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-builder.css' | asset_url | stylesheet_tag }}
<script>window.ggMoneyFormat = window.ggMoneyFormat || {{ shop.money_format | json }};</script>
<script src="{{ 'gg-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gg-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings

  comment
    Size tiers (default 3 / 6 / 9): one parent product each, empty settings are skipped. Size = the product's
    custom.bundle_size, else 3 / 6 / 9. Variant = the one whose option1 starts with the size ("6 Flaschen"),
    else the first available. bb_tiers = JSON for gg-builder.js; the parallel lists feed the size buttons.
    The first tier with a product is the start size.
  endcomment
  assign bb_keys = 'bundle_product:3,upgrade_product:6,upgrade_product_2:9' | split: ','
  assign bb_tiers = ''
  assign bb_tier_n = 0
  assign bb_tier_pids = ','
  assign bb_t_sizes = ''
  assign bb_t_prices = ''
  assign bb_t_compares = ''
  assign bb_t_avail = ''
  assign bb_base_size = 3
  assign bb_base_price = 0
  for tk in bb_keys
    assign tkp = tk | split: ':'
    assign tp = st[tkp[0]]
    if tp == blank
      continue
    endif
    assign t_size = tkp[1] | plus: 0
    if tp.metafields.custom.bundle_size != blank
      assign bb_ms = tp.metafields.custom.bundle_size.value | plus: 0
      if bb_ms > 1
        assign t_size = bb_ms
      endif
    endif
    assign t_v = blank
    for v in tp.variants
      assign vn = v.option1 | default: '' | split: ' ' | first | plus: 0
      if vn > 0 and vn == t_size
        assign t_v = v
        break
      endif
    endfor
    if t_v == blank
      assign t_v = tp.selected_or_first_available_variant
    endif
    if t_v == blank
      continue
    endif
    assign t_compare = 0
    if t_v.compare_at_price > t_v.price
      assign t_compare = t_v.compare_at_price
    endif
    if bb_tier_n == 0
      assign bb_base_size = t_size
      assign bb_base_price = t_v.price
    else
      assign bb_tiers = bb_tiers | append: ','
      assign bb_t_sizes = bb_t_sizes | append: ','
      assign bb_t_prices = bb_t_prices | append: ','
      assign bb_t_compares = bb_t_compares | append: ','
      assign bb_t_avail = bb_t_avail | append: ','
    endif
    assign bb_tiers = bb_tiers | append: '{"size":' | append: t_size | append: ',"variantId":"' | append: t_v.id | append: '","price":' | append: t_v.price | append: ',"compare":' | append: t_compare | append: ',"available":' | append: t_v.available | append: '}'
    assign bb_t_sizes = bb_t_sizes | append: t_size
    assign bb_t_prices = bb_t_prices | append: t_v.price
    assign bb_t_compares = bb_t_compares | append: t_compare
    assign bb_t_avail = bb_t_avail | append: t_v.available
    assign bb_tier_pids = bb_tier_pids | append: tp.id | append: ','
    assign bb_tier_n = bb_tier_n | plus: 1
  endfor
  if bb_tier_n == 0
    assign bb_tiers = '{"size":' | append: bb_base_size | append: ',"variantId":null,"price":0,"compare":0,"available":false}'
  endif

  comment
    Pool collection: setting, else best-sellers, else all products
  endcomment
  assign bb_coll = st.pool_collection
  if bb_coll == blank
    assign bb_coll = collections['best-sellers']
  endif
  if bb_coll == blank
    assign bb_coll = collections.all
  endif
  assign bb_limit = st.pool_limit | default: 200 | plus: 0
  assign bb_size_tok = st.bottle_size | default: '50ml' | strip | downcase | remove: ' '
  assign bb_word = st.inspired_word | default: 'Inspiriert von'

  assign bb_cta_price = bb_base_price | money_without_trailing_zeros
  assign bb_cta = st.cta | default: 'Set in den Warenkorb · [price]' | replace: '[price]', bb_cta_price
  assign bb_of = st.of_label | default: '[x] von [n]' | replace: '[x]', '0' | replace: '[n]', bb_base_size
  assign bb_choose = st.choose_more | default: 'Wähle noch [n] Düfte' | replace: '[n]', bb_base_size
  assign bb_anchor = st.anchor | default: 'selbst-zusammenstellen' | handleize
-%}

<div class="gg gg--surface-2 gg-bb" id="gg-{{ section.id }}">
  <span class="gg-anchor" id="{{ bb_anchor }}">&#8203;</span>
  <div class="gg__wrap">
    <div class="gg-head">
      {%- if st.eyebrow != blank -%}<span class="gg-eyebrow">{{ st.eyebrow | escape }}</span>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="gg-h2">{{ st.heading | escape }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<p class="gg-sub">{{ st.text | escape }}</p>{%- endif -%}
    </div>

    {%- if bb_tier_n == 0 and request.design_mode -%}
      <p class="gg-bb__notice">Wähle das Set-Produkt in den Einstellungen</p>
    {%- endif -%}

    <gg-builder class="gg-bb__card" data-section="{{ section.id }}">
      <script type="application/json" data-gg-config>
        {
          "tiers": [{{ bb_tiers }}],
          "bottle": {{ st.bottle_size | default: '50ml' | json }},
          "bottleLabel": {{ st.bottle_label | default: 'Flasche' | json }},
          "t": {
            "number": "Nr. [n]",
            "inspired": {{ bb_word | json }},
            "count": {{ st.count_label | default: '[n] Düfte' | json }},
            "add": {{ st.add_label | default: 'Hinzufügen' | json }},
            "isNew": {{ st.new_badge | default: 'Neu' | json }},
            "best": {{ st.best_badge | default: 'Bestseller' | json }},
            "of": {{ st.of_label | default: '[x] von [n]' | json }},
            "more": {{ st.choose_more | default: 'Wähle noch [n] Düfte' | json }},
            "one": {{ st.choose_one | default: 'Wähle noch 1 Duft' | json }},
            "full": "Dein Set ist komplett",
            "empty": {{ st.slot_empty | default: 'Wähle einen Duft' | json }},
            "per": {{ st.per_bottle | default: '[amount] pro Flasche' | json }},
            "was": {{ st.was_label | default: 'Statt [amount]' | json }},
            "save": {{ st.save_label | default: 'Du sparst [amount]' | json }},
            "cta": {{ st.cta | default: 'Set in den Warenkorb · [price]' | json }},
            "loading": "Wird hinzugefügt …",
            "error": {{ st.error | default: 'Das Set konnte nicht hinzugefügt werden. Bitte versuch es noch einmal.' | json }},
            "remove": "Entfernen",
            "none": {{ st.no_results | default: 'Kein Duft gefunden.' | json }}
          }
        }
      </script>
      <script type="application/json" data-gg-pool>
        [
        {%- assign bb_count = 0 -%}
        {%- paginate bb_coll.products by 250 -%}
          {%- for p in bb_coll.products -%}
            {%- if bb_count >= bb_limit -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign skip = false
              assign p_tok = ',' | append: p.id | append: ','
              if p.available == false or bb_tier_pids contains p_tok or p.tags contains 'bundle' or p.has_only_default_variant
                assign skip = true
              endif
              assign v = blank
              unless skip
                for pv in p.variants
                  assign pv_size = pv.title | downcase | remove: ' '
                  assign pv_head = pv_size | slice: 0, bb_size_tok.size
                  if pv.available and pv_head == bb_size_tok
                    assign v = pv
                    break
                  endif
                endfor
                if v == blank
                  assign skip = true
                endif
              endunless
            -%}
            {%- unless skip -%}
              {%- liquid
                assign p_w = false
                if p.tags contains 'Woman' or p.tags contains 'Women' or p.tags contains 'woman' or p.tags contains 'women' or p.tags contains 'Für Frauen' or p.tags contains 'fuer-frauen' or p.tags contains 'FÜR FRAUEN' or p.tags contains 'Frauen'
                  assign p_w = true
                endif
                assign p_m = false
                if p.tags contains 'Man' or p.tags contains 'Men' or p.tags contains 'man' or p.tags contains 'men' or p.tags contains 'Für Männer' or p.tags contains 'fuer-maenner' or p.tags contains 'FÜR MÄNNER'
                  assign p_m = true
                endif
                assign p_g = ''
                if p.tags contains 'unisex' or p.tags contains 'Unisex' or p.tags contains 'UNISEX'
                  assign p_g = 'unisex'
                elsif p_w and p_m
                  assign p_g = 'unisex'
                elsif p_w
                  assign p_g = 'female'
                elsif p_m
                  assign p_g = 'male'
                endif

                # Bestseller badge = the first 20 scents of the pool (Adrian 11.11: "only top 20"). The pool
                # collection is sorted by best-selling, so its order is Shopify's sales rank; the "bestseller" tag
                # sits on 46 products and is not used here. 20 is fixed in code (schema is at 40 settings).
                assign p_best = false
                if bb_count < 20
                  assign p_best = true
                endif
                assign p_new = false
                for t in p.tags
                  assign t_low = t | downcase | strip
                  if t_low == 'new' or t_low == 'neu' or t_low == 'new-arrival'
                    assign p_new = true
                  endif
                endfor

                assign p_fam = ''
                assign mf = p.metafields.custom.fragrance_family
                if mf != blank
                  if mf.type contains 'list.'
                    assign p_fam = mf.value | join: ', '
                  else
                    assign p_fam = mf.value | strip
                  endif
                endif
              -%}
              {%- capture bb_meta -%}{% render 'gg-scent-meta', product: p, variant: v, inspired_word: bb_word %}{%- endcapture -%}
              {%- assign bb_m = bb_meta | split: '~|~' -%}
              {%- if bb_count > 0 -%},{%- endif -%}
              {"v":"{{ v.id }}","n":{{ bb_m[0] | default: '' | strip | json }},"t":{{ p.title | json }},"i":{{ bb_m[1] | default: '' | strip | json }},"o":{{ bb_m[2] | default: '' | strip | json }},"f":{{ p_fam | json }},"g":"{{ p_g }}","b":{{ p_best }},"w":{{ p_new }},"p":{{ v.price }},"img":{%- if p.featured_image != blank -%}{{ p.featured_image | image_url: width: 112 | json }}{%- else -%}""{%- endif -%},"c":{{ bb_m[4] | default: p.title | strip | json }}}
              {%- assign bb_count = bb_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endpaginate -%}
        ]
      </script>

      <div class="gg-bb__filters">
        {%- capture bb_chips -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign pp = block.settings.product
              assign pp_ids = ''
              if pp != blank
                for fv in pp.metafields.custom.fixed_bundle_products.value
                  if fv.id != blank
                    if pp_ids != ''
                      assign pp_ids = pp_ids | append: ','
                    endif
                    assign pp_ids = pp_ids | append: '"' | append: fv.id | append: '"'
                  endif
                endfor
              endif
              assign pp_label = block.settings.label
              if pp_label == blank and pp != blank
                assign pp_label = pp.metafields.custom.gift_title.value | default: pp.title
              endif
            -%}
            {%- if pp_ids != '' -%}
              <button type="button" class="gg-bb__chip" data-preset="[{{ pp_ids | escape }}]" {{ block.shopify_attributes }}>{{ pp_label | escape }}</button>
            {%- elsif request.design_mode -%}
              <button type="button" class="gg-bb__chip" disabled {{ block.shopify_attributes }}>{{ pp_label | default: 'Geschenkset wählen' | escape }}</button>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if bb_chips != blank -%}
          <div class="gg-bb__group gg-bb__group--presets">
            <p class="gg-bb__label" id="ggbb-pre-{{ section.id }}">{{ st.presets_label | escape }}</p>
            <div class="gg-bb__scroller gg-bb__chips" role="group" aria-labelledby="ggbb-pre-{{ section.id }}">
              {{- bb_chips -}}
            </div>
            {%- if st.presets_note != blank -%}<p class="gg-bb__note">{{ st.presets_note | escape }}</p>{%- endif -%}
          </div>
        {%- endif -%}

        <div class="gg-bb__group gg-bb__group--search">
          <label class="gg-vh" for="ggbb-q-{{ section.id }}">{{ st.search_placeholder | escape }}</label>
          <div class="gg-bb__search">
            <svg class="gg-bb__search-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input class="gg-bb__input" type="search" id="ggbb-q-{{ section.id }}" placeholder="{{ st.search_placeholder | escape }}" autocomplete="off" data-q>
          </div>
        </div>

        <div class="gg-bb__group" data-g-group>
          <p class="gg-bb__label" id="ggbb-g-{{ section.id }}">{{ st.gender_label | escape }}</p>
          <div class="gg-bb__scroller gg-bb__opts" role="group" aria-labelledby="ggbb-g-{{ section.id }}">
            <button type="button" class="gg-bb__opt is-active" data-g="all" aria-pressed="true"><span>{{ st.gender_all | escape }}</span> <span class="gg-bb__cnt" data-cnt="all"></span></button>
            <button type="button" class="gg-bb__opt" data-g="unisex" aria-pressed="false"><span>{{ st.gender_unisex | escape }}</span> <span class="gg-bb__cnt" data-cnt="unisex"></span></button>
            <button type="button" class="gg-bb__opt" data-g="male" aria-pressed="false"><span>{{ st.gender_male | escape }}</span> <span class="gg-bb__cnt" data-cnt="male"></span></button>
            <button type="button" class="gg-bb__opt" data-g="female" aria-pressed="false"><span>{{ st.gender_female | escape }}</span> <span class="gg-bb__cnt" data-cnt="female"></span></button>
          </div>
        </div>

        <div class="gg-bb__group" data-f-group>
          <p class="gg-bb__label" id="ggbb-f-{{ section.id }}">{{ st.family_label | escape }}</p>
          <div class="gg-bb__scroller gg-bb__pills" role="group" aria-labelledby="ggbb-f-{{ section.id }}" data-f-list>
            <button type="button" class="gg-bb__pill is-active" data-f="" aria-pressed="true">{{ st.gender_all | escape }}</button>
          </div>
        </div>
      </div>

      <div class="gg-bb__main">
        <div class="gg-bb__listhead">
          <p class="gg-bb__count" data-count aria-live="polite"></p>
          <p class="gg-bb__sort">{{ st.sort_label | escape }}</p>
        </div>
        <div class="gg-bb__list" role="list" data-list tabindex="-1"></div>
      </div>

      <div class="gg-bb__sum" data-sum>
        <div class="gg-bb__sum-head" data-head>
          <div class="gg-bb__sum-titles">
            <p class="gg-bb__sum-line">
              <span class="gg-bb__sum-title">{{ st.set_title | escape }}</span>
              <span class="gg-bb__of" data-of>{{ bb_of | escape }}</span>
            </p>
            <p class="gg-bb__status" data-status aria-live="polite">{{ bb_choose | escape }}</p>
          </div>
          <button type="button" class="gg-bb__chev" data-toggle aria-expanded="false" aria-controls="ggbb-rail-{{ section.id }}">
            <span class="gg-vh">{{ st.set_title | escape }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 15 6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        {%- if bb_tier_n > 1 -%}
          {%- assign tz = bb_t_sizes | split: ',' -%}
          {%- assign tpz = bb_t_prices | split: ',' -%}
          {%- assign tcz = bb_t_compares | split: ',' -%}
          {%- assign taz = bb_t_avail | split: ',' -%}
          {%- comment -%} Each size shows its set price, the struck compare-at and the saving in % (pill on the top
            edge), so the offer reads before anything is picked. No compare-at on a size = price only. {%- endcomment -%}
          <div class="gg-bb__sizes" role="group" aria-label="{{ st.sizes_label | default: 'Wie viele Düfte?' | escape }}">
            {%- for s in tz -%}
              {%- liquid
                assign i = forloop.index0
                assign s_pr = tpz[i] | plus: 0
                assign s_cmp = tcz[i] | plus: 0
                assign s_pct = 0
                if s_cmp > s_pr and s_pr > 0
                  assign s_pct = s_cmp | minus: s_pr | times: 100.0 | divided_by: s_cmp | round
                endif
                assign s_label = st.size_label | default: '[n] Düfte' | replace: '[n]', s
              -%}
              <button type="button" class="gg-bb__size{% if i == 0 %} is-active{% endif %}{% if s_pct > 0 %} has-save{% endif %}" data-tier="{{ i }}" aria-pressed="{% if i == 0 %}true{% else %}false{% endif %}"{% if taz[i] != 'true' %} disabled{% endif %}>
                {%- if s_pct > 0 -%}
                  <span class="gg-bb__size-pct">-{{ s_pct }}%</span>
                {%- endif -%}
                <span class="gg-bb__size-n">{{ s_label | escape }}</span>
                <span class="gg-bb__size-pr">
                  <span class="gg-bb__size-p">{{ s_pr | money_without_trailing_zeros }}</span>
                  {%- if s_pct > 0 -%}
                    {{ ' ' }}<s class="gg-bb__size-was">{{ s_cmp | money_without_trailing_zeros }}</s>
                  {%- endif -%}
                </span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="gg-bb__rail" id="ggbb-rail-{{ section.id }}">
          <ol class="gg-bb__slots" data-slots>
            {%- for i in (1..bb_base_size) -%}
              <li class="gg-bb__slot"><span class="gg-bb__slot-idx">{% if i < 10 %}0{% endif %}{{ i }}</span><span class="gg-bb__slot-txt">{{ st.slot_empty | escape }}</span></li>
            {%- endfor -%}
          </ol>
        </div>
        <div class="gg-bb__totals" data-totals>
          <p class="gg-bb__trow"><span data-tl-size></span><strong data-tl-price>{{ bb_cta_price }}</strong></p>
          <p class="gg-bb__trow gg-bb__trow--small"><span data-tl-per></span><s data-tl-was></s></p>
          <p class="gg-bb__save" data-tl-save></p>
        </div>
        <button type="button" class="gg-btn gg-btn--primary gg-btn--block gg-bb__cta" data-cta disabled>{{ bb_cta | escape }}</button>
        <p class="gg-bb__err" role="alert" data-err hidden></p>
        {%- if st.fine_print != blank -%}<p class="gg-bb__fine">{{ st.fine_print | escape }}</p>{%- endif -%}
      </div>
    </gg-builder>
  </div>
</div>

{% schema %}
{
  "name": "GG Set-Builder",
  "tag": "section",
  "class": "gg-section pm-scope",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker (ohne #)", "default": "selbst-zusammenstellen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Selbst zusammenstellen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Du weißt, was sie mögen? Wähl drei aus." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drei 50-ml-Düfte zum Preis eines Geschenksets, jeder einzeln verpackt. Wähl alle drei selbst aus oder starte mit einem unserer Geschenksets." },
    { "type": "header", "content": "Set-Produkte" },
    { "type": "product", "id": "bundle_product", "label": "Set-Produkt 1 (Start)", "info": "Wird in den Warenkorb gelegt. Flaschenzahl aus custom.bundle_size des Produkts (sonst 3 / 6 / 9)." },
    { "type": "product", "id": "upgrade_product", "label": "Set-Produkt 2", "info": "Optional, z. B. das 6er-Set. Flaschenzahl aus custom.bundle_size des Produkts." },
    { "type": "product", "id": "upgrade_product_2", "label": "Set-Produkt 3", "info": "Optional, z. B. das 9er-Set. Flaschenzahl aus custom.bundle_size des Produkts." },
    { "type": "text", "id": "size_label", "label": "Größen-Button", "default": "[n] Düfte" },
    { "type": "text", "id": "sizes_label", "label": "Größen-Auswahl (Screenreader)", "default": "Wie viele Düfte?" },
    { "type": "header", "content": "Duftauswahl" },
    { "type": "collection", "id": "pool_collection", "label": "Kollektion", "info": "Leer: best-sellers, dann alle Produkte." },
    { "type": "range", "id": "pool_limit", "label": "Max. Düfte", "min": 50, "max": 250, "step": 2, "default": 200 },
    { "type": "text", "id": "bottle_size", "label": "Flaschengröße (Variante)", "default": "50ml" },
    { "type": "text", "id": "bottle_label", "label": "Wort im Warenkorb", "default": "Flasche" },
    { "type": "text", "id": "inspired_word", "label": "Inspiriert-Wort", "default": "Inspiriert von" },
    { "type": "header", "content": "Filter" },
    { "type": "text", "id": "presets_label", "label": "Geschenksets Titel", "default": "Mit einem Geschenkset starten" },
    { "type": "textarea", "id": "presets_note", "label": "Geschenksets Hinweis", "default": "Wir füllen dein Set mit den drei Düften dieses Sets. Tausch jeden davon aus, wie du willst." },
    { "type": "text", "id": "search_placeholder", "label": "Suche", "default": "Nummer, Name oder Note suchen" },
    { "type": "text", "id": "gender_label", "label": "Für wen", "default": "Für wen" },
    { "type": "text", "id": "gender_all", "label": "Alle (Für wen, Duftfamilie)", "default": "Alle" },
    { "type": "text", "id": "gender_unisex", "label": "Unisex", "default": "Unisex" },
    { "type": "text", "id": "gender_male", "label": "Herren", "default": "Herren" },
    { "type": "text", "id": "gender_female", "label": "Damen", "default": "Damen" },
    { "type": "text", "id": "family_label", "label": "Duftfamilie", "default": "Duftfamilie" },
