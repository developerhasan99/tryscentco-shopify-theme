{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-close gg--surface" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  <div class="gg__wrap gg__wrap--narrow gg-close__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-h2 gg-close__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.sub != blank -%}
      <p class="gg-sub gg-close__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="gg-btn gg-btn--primary gg-close__btn" href="{{ section.settings.button_link | default: '#fuer-sie' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.guarantee != blank -%}
      <p class="gg-small gg-close__guarantee">{{ section.settings.guarantee | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Abschluss",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID (optional)" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Geschenke erledigt, mit Zeit zum Durchatmen." },
    { "type": "textarea", "id": "sub", "label": "Untertitel", "default": "Such dir ein Set aus, wir kümmern uns um den Rest." },
    { "type": "text", "id": "button_label", "label": "Button Text", "default": "Geschenksets ansehen" },
    { "type": "text", "id": "button_link", "label": "Button Link (auch #Anker)", "default": "#fuer-sie" },
    { "type": "text", "id": "guarantee", "label": "Garantie-Zeile", "default": "60 Tage Geld-zurück-Garantie." }
  ],
  "presets": [
    { "name": "GG Abschluss" }
  ]
}
{% endschema %}
