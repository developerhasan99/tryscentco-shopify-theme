{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-more" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  <div class="gg__wrap">
    <div class="gg-head gg-head--center">
      {%- if section.settings.heading != blank -%}
        <h2 class="gg-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}
        <p class="gg-sub">{{ section.settings.sub | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="gg-row gg-more__row" style="--gg-cols: 3">
        {%- for block in section.blocks -%}
          {%- assign gg_product = block.settings.product -%}
          <li class="gg-more__card" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}
              <span class="gg-eyebrow gg-more__eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {%- endif -%}
            <h3 class="gg-h3 gg-more__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="gg-more__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if gg_product != blank -%}
              <div class="gg-more__price">
                <span class="gg-more__now">{{ gg_product.price | money_without_trailing_zeros }}</span>
                {%- if gg_product.compare_at_price > gg_product.price -%}
                  <s class="gg-more__was">{{ gg_product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- endif -%}
              </div>
              {%- if block.settings.price_note != blank -%}
                <p class="gg-small gg-more__note">{{ block.settings.price_note | escape }}</p>
              {%- endif -%}
            {%- endif -%}
            {%- assign gg_href = block.settings.link | default: gg_product.url -%}
            {%- if block.settings.button_label != blank and gg_href != blank -%}
              <a class="gg-btn gg-btn--secondary gg-more__btn" href="{{ gg_href }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Mehr Geschenke",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID", "default": "mehr-geschenke" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Noch mehr Geschenkideen" },
    { "type": "textarea", "id": "sub", "label": "Untertitel", "default": "Für alle, die kein Set verschenken möchten oder gleich mehrere Menschen beschenken." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nur ein Geschenk?" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Ein einzelner Duft" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Du weißt, welcher Duft es sein soll? Wähle einen beliebigen Duft." },
        { "type": "product", "id": "product", "label": "Produkt (für den Preis)" },
        { "type": "text", "id": "price_note", "label": "Preis-Hinweis" },
        { "type": "text", "id": "button_label", "label": "Button Text", "default": "Einzeldüfte ansehen" },
        { "type": "url", "id": "link", "label": "Link", "info": "Leer = Produktseite des gewählten Produkts. Ohne Link und ohne Produkt wird kein Button gezeigt." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Mehr Geschenke",
      "blocks": [
        { "type": "card", "settings": { "eyebrow": "Nur ein Geschenk?", "title": "Ein einzelner Duft", "text": "Du weißt, welcher Duft es sein soll? Wähle einen beliebigen Duft.", "button_label": "Einzeldüfte ansehen" } },
        { "type": "card", "settings": { "eyebrow": "Für viele auf einmal", "title": "Der Großpack", "text": "Mehrere Flaschen in einer Bestellung, für alle, die viele Menschen beschenken.", "button_label": "Pack ansehen" } },
        { "type": "card", "settings": { "eyebrow": "Zum Ausprobieren", "title": "Probierset", "text": "Platzhalter, bis das Produkt existiert. Text und Link im Editor anpassen.", "button_label": "Probierset ansehen" } }
      ]
    }
  ]
}
{% endschema %}
