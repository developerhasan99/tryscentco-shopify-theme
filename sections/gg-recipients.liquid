{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-rec" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  <div class="gg__wrap">
    <div class="gg-head gg-head--center">
      {%- if section.settings.heading != blank -%}
        <h2 class="gg-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.sub != blank -%}
        <p class="gg-sub">{{ section.settings.sub | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign has_rec = false -%}
    {%- assign has_budget = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'recipient' -%}{%- assign has_rec = true -%}{%- endif -%}
      {%- if block.type == 'budget' -%}{%- assign has_budget = true -%}{%- endif -%}
    {%- endfor -%}

    {%- if has_rec -%}
      <ul class="gg-rec__grid" style="--gg-rec-cols: {{ section.settings.columns | default: 4 }};">
        {%- for block in section.blocks -%}
          {%- if block.type == 'recipient' -%}
            <li class="gg-rec__item" {{ block.shopify_attributes }}>
              <a class="gg-rec__card" href="{{ block.settings.link | default: '#' }}">
                <span class="gg-rec__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 450, 600, 800', sizes: '(min-width: 1360px) 260px, (min-width: 990px) 20vw, 50vw', class: 'gg-rec__img', alt: block.settings.title }}
                  {%- else -%}
                    {% render 'gg-placeholder', label: 'Empfänger', size: '4:3' %}
                  {%- endif -%}
                </span>
                <span class="gg-rec__body">
                  <span class="gg-rec__title gg-h3">{{ block.settings.title | escape }}</span>
                  {%- if block.settings.meta != blank -%}
                    <span class="gg-rec__meta">{{ block.settings.meta | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.count != blank -%}
                    <span class="gg-rec__count">{{ block.settings.count | escape }} <span aria-hidden="true">&rarr;</span></span>
                  {%- endif -%}
                </span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if has_budget -%}
      <div class="gg-rec__budget">
        {%- if section.settings.budget_label != blank -%}
          <p class="gg-eyebrow gg-rec__budget-label">{{ section.settings.budget_label | escape }}</p>
        {%- endif -%}
        <ul class="gg-rec__chips">
          {%- for block in section.blocks -%}
            {%- if block.type == 'budget' -%}
              <li class="gg-rec__chip-item" {{ block.shopify_attributes }}>
                <a class="gg-rec__chip" href="{{ block.settings.link | default: '#' }}">
                  <span class="gg-rec__chip-price">{{ block.settings.price | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="gg-rec__chip-text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Empfänger",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID (optional)" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Für wen suchst du?" },
    { "type": "textarea", "id": "sub", "label": "Untertitel", "default": "Jedes Set enthält drei 50-ml-Flakons, jeder einzeln verpackt: ein großes Geschenk oder drei kleine." },
    { "type": "text", "id": "budget_label", "label": "Label Budget-Chips", "default": "Geschenke nach Budget" },
    {
      "type": "select",
      "id": "columns",
      "label": "Karten pro Reihe (Desktop)",
      "info": "Auf dem Handy immer 2. Mit 10 Karten passt 5 (zwei volle Reihen).",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    }
  ],
  "blocks": [
    {
      "type": "recipient",
      "name": "Empfänger",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild (4:3)" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Für Sie" },
        { "type": "text", "id": "meta", "label": "Meta-Zeile", "default": "Duftgarderobe · Bestseller · Blumig" },
        { "type": "text", "id": "count", "label": "Anzahl-Text", "default": "3 Sets" },
        { "type": "text", "id": "link", "label": "Link (auch #Anker)", "default": "#fuer-sie" }
      ]
    },
    {
      "type": "budget",
      "name": "Budget-Chip",
      "settings": [
        { "type": "text", "id": "price", "label": "Preis-Label", "default": "Geschenksets" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sets mit drei Düften" },
        { "type": "text", "id": "link", "label": "Link (auch #Anker)", "default": "#fuer-sie" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Empfänger",
      "blocks": [
        { "type": "recipient", "settings": { "title": "Für Sie", "meta": "Duftgarderobe · Bestseller · Blumig", "count": "3 Sets", "link": "#fuer-sie" } },
        { "type": "recipient", "settings": { "title": "Für Ihn", "meta": "Duftgarderobe · Bestseller · Holzig", "count": "2 Sets", "link": "#fuer-ihn" } },
        { "type": "recipient", "settings": { "title": "Für alle", "meta": "Unisex-Düfte für jeden Geschmack", "count": "2 Sets", "link": "#fuer-alle" } },
        { "type": "recipient", "settings": { "title": "Wichteln", "meta": "Eins für sie, eins für ihn, eins für alle", "count": "1 Set", "link": "#wichteln" } },
        { "type": "budget", "settings": { "price": "Geschenksets", "text": "Sets mit drei Düften", "link": "#fuer-sie" } },
        { "type": "budget", "settings": { "price": "Mehr Geschenke", "text": "Einzeldüfte und Großpacks", "link": "#mehr-geschenke" } }
      ]
    }
  ]
}
{% endschema %}
