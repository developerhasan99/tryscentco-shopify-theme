{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-rev gg--surface-2" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  <div class="gg__wrap">
    <div class="gg-head gg-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="gg-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gg-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_line != blank -%}
        <p class="gg-sub gg-rev__rating">{{ section.settings.rating_line | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="gg-row gg-rev__row" style="--gg-cols: 3">
        {%- for block in section.blocks -%}
          <li class="gg-rev__card" {{ block.shopify_attributes }}>
            <div class="gg-rev__stars" role="img" aria-label="{{ block.settings.stars }} von 5 Sternen">
              {%- for i in (1..5) -%}
                <svg class="gg-rev__star{% if i > block.settings.stars %} gg-rev__star--off{% endif %}" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z"/></svg>
              {%- endfor -%}
            </div>
            {%- if block.settings.title != blank -%}
              <p class="gg-rev__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            <blockquote class="gg-rev__text">{{ block.settings.text | escape }}</blockquote>
            <p class="gg-rev__foot">
              <span class="gg-rev__author">{{ block.settings.author | escape }}</span>
              {%- if block.settings.source != blank -%}
                <span class="gg-rev__source">{{ block.settings.source | escape }}</span>
              {%- endif -%}
            </p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Bewertungen",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verschenkt und geliebt" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Zum Verwechseln ähnlich? Das sagen unsere Kunden." },
    { "type": "text", "id": "rating_line", "label": "Bewertungszeile", "default": "Kundenrezensionen · 4,7 von 5 Sternen" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "stars", "label": "Sterne", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Titel (optional)" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Bewertungstext" },
        { "type": "text", "id": "author", "label": "Autor", "default": "Kunde" },
        { "type": "text", "id": "source", "label": "Quelle", "default": "Verifizierte Bewertung" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Bewertungen",
      "blocks": [
        { "type": "quote", "settings": { "stars": 5, "title": "„Riecht super frisch und kommt Aventus ziemlich nah.“", "text": "Wusste erst nicht genau, was mich erwartet, aber der Duft hat mich echt positiv überrascht. Hält ordentlich und der Preis ist einfach deutlich besser.", "author": "Michael T.", "source": "Verifizierte Bewertung" } },
        { "type": "quote", "settings": { "stars": 5, "title": "„Ich hab vorher nie einen Duft-Dupe gefunden, der wirklich authentisch riecht.“", "text": "Das war meine erste Bestellung hier und ich bin echt begeistert. Ich kauf mein Parfüm ab jetzt nirgendwo anders mehr.", "author": "Sebastian Müller", "source": "Verifizierte Bewertung" } },
        { "type": "quote", "settings": { "stars": 5, "title": "„Die Düfte sind wirklich nah an den Originalen.“", "text": "Alle drei Düfte, die ich bestellt habe, riechen echt richtig gut und halten auch lange.", "author": "Clara P.", "source": "Verifizierte Bewertung" } }
      ]
    }
  ]
}
{% endschema %}
