{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- comment -%} Setting "Add to cart on product cards": size chips + button on each card (snippets/product-card.liquid) {%- endcomment -%}
{%- if section.settings.card_atc -%}
  {{ 'ts-card-atc.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ts-card-atc.js' | asset_url }}" defer="defer"></script>
  {%- unless section.settings.quick_add == 'standard' -%}
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- endunless -%}
{%- endif -%}

{%- liquid
  # Setting "Toolbar style" = pills: centred pill dropdowns (Sort + every storefront filter from Search &
  # Discovery) + search field + product count. Port of the tryscent.co redesign (tryscent-co-fm-theme
  # premium-redesign: snippets/facets.liquid filter_type 'pills', snippets/pm-collection-search.liquid,
  # assets/pm-collection-search.js, assets/pm-collection-grid-loader.js, assets/pm-collection-toolbar.css).
  # Default "classic" = the toolbar and infinite scroll this theme always had, unchanged.
  # "mgx" = the magyx.co collection filter bar instead of the pills (snippets/mgx-filters.liquid,
  # assets/mgx-filters.{js,css}, copied from the magyx.co theme): sticky pill dropdowns from 990px, one
  # "Filtrera och sortera" pill + full-screen drawer below. Search field, infinite scroll and the product
  # <li> data are the same as in "pills" (pm_pills is true for both; pm_mgx only swaps the filter bar).
  assign pm_pills = false
  assign pm_mgx = false
  if section.settings.toolbar_style == 'pills'
    assign pm_pills = true
  elsif section.settings.toolbar_style == 'mgx'
    assign pm_pills = true
    assign pm_mgx = true
  endif
-%}
{%- if pm_pills -%}
  {{ 'pm-collection-toolbar.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'pm-collection-grid-loader.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pm-collection-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if pm_mgx -%}
  {{ 'mgx-filters.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'mgx-filters.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if pm_pills -%}
    /* The pill toolbar CSS reads the redesign's --pm-* tokens; the live theme has no global token layer, so they
       are declared here on this section (values of assets/fmx-base.css). */
    .section-{{ section.id }}-padding.premium {
      --pm-ink: #232323;
      --pm-muted: #707070;
      --pm-line: #e7e7e7;
      --pm-surface: #f6f6f6;
      --pm-white: #ffffff;
      --pm-fs-small: 12px;
      --pm-lh-small: 18px;
      /* = this theme's .page-width side padding (base.css: 1.5rem, 5rem from 750px). The pill row bleeds by
         the gutter to the screen edge; the redesign's 20 / 40 / 60 would push it 5px past the screen. */
      --pm-gutter: 1.5rem;
      --pm-radius-sm: 4px;
      --pm-radius-md: 8px;
      --pm-radius-pill: 999px;
      --pm-shadow-float: 0 4px 20px rgba(0, 0, 0, 0.1), 0 1px 3px rgba(0, 0, 0, 0.07);
      --pm-dur: 0.3s;
      --pm-ease: ease;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding.premium {
        --pm-gutter: 5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .section-{{ section.id }}-padding.premium {
        --pm-dur: 0s;
      }
    }
  {%- endif -%}

  {%- if pm_mgx -%}
    /* Search field under the magyx.co filter bar: magyx.co's spacing (4px above, 16px below, 20px from 750px). */
    .section-{{ section.id }}-padding .pm-mgx-search {
      padding-top: 4px;
      padding-bottom: 16px;
    }

    .section-{{ section.id }}-padding.premium .pm-mgx-search .pm-csearch {
      margin-top: 0;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding .pm-mgx-search {
        padding-bottom: 20px;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}{% if pm_pills %} premium{% endif %}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if pm_mgx -%}
      {%- comment -%}
        magyx.co filter bar (no facets.js: assets/mgx-filters.js re-renders this section itself and swaps
        #ProductGridContainer, #MgxFiltersBar and #MgxFiltersDrawer), then the search field.
      {%- endcomment -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {% render 'mgx-filters'
          , results: collection
          , section_id: section.id
          , enable_filtering: section.settings.enable_filtering
          , enable_sorting: section.settings.enable_sorting
          , apply_label: section.settings.filters_apply_label
          , clear_label: section.settings.filters_clear_label
        %}
      {%- endif -%}
      {%- if section.settings.enable_search -%}
        <div class="pm-mgx-search page-width">
          {% render 'pm-collection-search', st: section.settings, section_id: section.id %}
        </div>
      {%- endif -%}
    {%- elsif pm_pills -%}
      {%- comment -%}
        Pill toolbar: Sort + one pill per storefront filter, the search field, then the product count.
        #ProductCount is required by facets.js (it swaps its HTML after every filter and sort).
      {%- endcomment -%}
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      <div class="pm-ctoolbar page-width">
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            class="pm-ctoolbar__facets"
            id="main-collection-filters"
            data-id="{{ section.id }}"
            aria-label="{{ 'products.facets.filter_and_sort' | t }}">
            {% render 'facets'
              , results: collection
              , enable_filtering: section.settings.enable_filtering
              , enable_sorting: section.settings.enable_sorting
              , filter_type: 'pills'
              , paginate: paginate
              , clear_label: section.settings.filters_clear_label
            %}
          </aside>
        {%- endif -%}

        {%- if section.settings.enable_search -%}
          {% render 'pm-collection-search', st: section.settings, section_id: section.id %}
        {%- endif -%}

        <p class="pm-ctoolbar__count" role="status">
          <span id="ProductCount">
            {%- if collection.results_count -%}
              {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
            {%- elsif collection.products_count == collection.all_products_count -%}
              {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
            {%- else -%}
              {{
                'products.facets.product_count'
                | t: product_count: collection.products_count, count: collection.all_products_count
              }}
            {%- endif -%}
          </span>
        </p>
      </div>
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- elsif section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message">
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                      selected="selected"
                      {% endif %}>
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    {%- comment -%} Setting "Show cart goals bar": Kite's cart goals, display only (snippets/ts-cart-goals.liquid) {%- endcomment -%}
    {%- if section.settings.cart_goals -%}
      {% render 'ts-cart-goals', st: section.settings %}
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' and pm_pills == false %} facets-vertical page-width{% endif %}">
      {%- unless pm_pills -%}
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- endunless -%}
      {%- if pm_pills == false and section.settings.enable_filtering or pm_pills == false and section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}">
          {% render 'facets'
            , results: collection
            , enable_filtering: section.settings.enable_filtering
            , enable_sorting: section.settings.enable_sorting
            , filter_type: section.settings.filter_type
            , paginate: paginate
          %}
        </aside>
      {%- endif -%}

      {%- assign fuel05_has_tiles = false -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'fuel05_ugc_video' -%}
          {%- assign fuel05_has_tiles = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%}
        The asset tags sit outside #ProductGridContainer on purpose: facets.js replaces
        that container's innerHTML on every filter and sort, and a script tag inserted
        through innerHTML never runs. fuel05-ugc.js arms itself and re-scans on its own,
        so it only has to load once, here.
      {%- endcomment -%}
      {%- if fuel05_has_tiles -%}
        {{ 'fuel05-ugc.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'fuel05-ugc.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
        data-cascade
        {% endif %}>
        {%- if collection.products.size == 0 -%}
          <div
            class="collection collection--empty page-width"
            id="product-grid"
            data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}">
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              style="display: flex !important;"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              ">
              {%- liquid
                comment
                  FUEL_04 offer cards down the grid.One card after every N products,
                  the three drawn designs taking turns, on every collection template
                  and on every page the load more button fetches (it appends every
                  #product-grid.grid__item it gets back, cards included).N comes
                  from the section settings; the default applies on templates that
                  never saved the setting, which is what puts the cards on every
                  collection page.Zero means off.
                endcomment
                assign fuel04_cards_every = 0
                if section.settings.fuel04_cards
                  assign fuel04_cards_every = section.settings.fuel04_cards_every | default: 5
                endif
              -%}
              {%- for product in collection.products -%}
                {% assign product_position = forloop.index %}

                {% for block in section.blocks %}
                  {% if block.settings.position == product_position %}
                    {% if block.type == 'quiz_promo_card' %}
                      {% render 'quiz-promo-card'
                        , block: block
                        , product_position: product_position %}
                    {% elsif block.type == 'fuel04_offer_card' %}
                      {% comment %}
                        Same seam as the promo card above: the snippet owns its own
                        grid cell. Its stylesheet is not emitted here. facets.js
                        replaces #ProductGridContainer's innerHTML on every filter
                        and sort and a tag inserted that way never runs, so every
                        FUEL_04 asset loads once from the head, in
                        snippets/fuel04-global.liquid.
                      {% endcomment %}
                      {% render 'fuel04-offer-card'
                        , block: block
                        , product_position: product_position %}
                      {% elsif block.type == 'fuel05_ugc_video' %}
                      {%- comment -%}
                        Page one only. Desktop emits 16 products plus 7 visible tiles per
                        page and 23 does not divide by 4, so from page two the whole grid
                        would start mid row and the tiles would land a column off the drawn
                        3, 1, 2, 4, 3, 1, 2. Nothing can put them back without either
                        changing the cell count per page or moving the tiles for desktop
                        only, which then breaks mobile, where 16 plus 7 is odd as well. The
                        design draws page one, so page one is what we ship.

                        No audience tag setting on this block, unlike the product page one. A
                        grid cell has no product of its own to test a tag against, and the
                        tiles are only placed on collection.collection-lander-v1, which is
                        assigned to Best Sellers, a single mixed collection. Reading the tag
                        off collection.title there is either a no op or it blanks every tile,
                        and a setting labelled for product tags that quietly tests a title
                        would mislead whoever fills it in. The client's rule names product
                        pages, "mens also for mens pages", so the filter lives there.
                      {%- endcomment -%}
                      {%- if paginate.current_page == 1 -%}
                        <li
                          class="grid__item fuel05-ugc fuel05-ugc--grid fuel05-ugc--grid-{{ block.settings.device | default: 'desktop' }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                          data-fuel05-row
                          {% if settings.animations_reveal_on_scroll %}
                          data-cascade
                          style="--animation-order: {{ product_position }};"
                          {% endif %}
                          {{ block.shopify_attributes }}>
                          {% render 'fuel05-ugc-tile'
                            , video: block.settings.video
                            , video_url: block.settings.video_url
                            , poster: block.settings.video_poster
                            , product_item: block.settings.product
                          %}
                        </li>
                      {%- endif -%}
                    {% else %}
                      <li
                        {{ block.shopify_attributes }}
                        class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ product_position }};"
                        {% endif %}>
                        {% render 'card-product'
                          , card_product: block.settings.product
                          , media_aspect_ratio: section.settings.image_ratio
                          , image_shape: section.settings.image_shape
                          , show_secondary_image: section.settings.show_secondary_image
                          , show_vendor: section.settings.show_vendor
                          , show_rating: section.settings.show_rating
                          , lazy_load: lazy_load
                          , skip_styles: skip_card_product_styles
                          , quick_add: section.settings.quick_add
                          , section_id: section.id
                        %}
                      </li>
                    {% endif %}
                  {% endif %}
                {% endfor %}

                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}
                {%- if pm_pills -%}
                  {%- comment -%}
                    Search haystack (assets/pm-collection-search.js): "title | inspiration | brand | notes | family |
                    season | occasion"; tags (occasion:, säsong:) and the handle ride along.
                  {%- endcomment -%}
                  {%- capture pm_hay -%}
                    {{- product.title | strip }} | {{ product.metafields.custom.famous_fragrance }} | {{ product.metafields.custom.brand }} | {{ product.metafields.custom.nuta }} | {{ product.metafields.custom.fragrance_family }} | {{ product.metafields.custom.season }} | {{ product.metafields.custom.occasion -}}
                  {%- endcapture -%}
                  {%- assign pm_hay = pm_hay | strip_newlines -%}
                {%- endif -%}
                <li
                  class="grid__item{% if section.settings.card_atc %} ts-atc-item{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if pm_pills %}
                  data-pm-pid="{{ product.id }}"
                  data-pm-hay="{{ pm_hay | escape }}"
                  data-pm-tags="{{ product.tags | join: '|' | escape }}"
                  data-pm-ref="{{ product.handle }}"
                  {% endif %}
                  {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                  {% endif %}>
                  {% render 'product-card'
                    , product: product
                    , atc: section.settings.card_atc
                    , section_id: section.id
                  %}
                </li>
                {%- if fuel04_cards_every > 0 -%}
                  {%- comment -%}
                    Counted from the first product of the collection, not of the page,
                    so the rhythm and the turn of the three designs carry across the
                    pages the load more button appends. Per page the count restarts at
                    one and the third design never comes up.
                  {%- endcomment -%}
                  {%- assign fuel04_cards_nth = paginate.current_offset | plus: forloop.index -%}
                  {%- assign fuel04_cards_gap = fuel04_cards_nth | modulo: fuel04_cards_every -%}
                  {%- if fuel04_cards_gap == 0 -%}
                    {%- assign fuel04_cards_design = fuel04_cards_nth | divided_by: fuel04_cards_every | minus: 1 | modulo: 3 | plus: 1 -%}
                    {%- render 'fuel04-offer-card'
                      , section_settings: section.settings
                      , design: fuel04_cards_design
                      , product_position: forloop.index
                    -%}
                  {%- endif -%}
                {%- endif -%}
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>
            {%- if paginate.pages > 1 and pm_pills -%}
              {%- if paginate.next -%}
                {%- comment -%}
                  Infinite scroll sentinel: #load-more-btn[data-next-url] and #loading-indicator are read by
                  assets/pm-collection-grid-loader.js; keep the ids. data-pm-pages lets it fetch the remaining
                  pages in parallel for the search; data-section-id is the section instance the pages are rendered
                  with (not the file name, so page size and settings follow the template).
                {%- endcomment -%}
                <div class="load-more-wrapper pm-loadmore">
                  <button
                    id="load-more-btn"
                    class="button pm-loadmore__btn"
                    data-next-url="{{ paginate.next.url }}"
                    data-pm-pages="{{ paginate.pages }}"
                    data-pm-per-page="{{ section.settings.products_per_page }}"
                    data-section-id="{{ section.id }}"
                    tabindex="-1"
                    aria-hidden="true">Visa fler produkter</button>
                  <div id="loading-indicator" class="pm-loadmore__status" role="status">
                    <span class="pm-loader" aria-hidden="true"></span>
                    Laddar fler produkter
                  </div>
                </div>
              {%- endif -%}
            {%- elsif paginate.pages > 1 -%}
              {%- if paginate.next -%}
                <div class="load-more-wrapper" style="text-align: center; margin-top: 40px; padding: 20px;">
                  <button
                    id="load-more-btn"
                    class="button"
                    data-next-url="{{ paginate.next.url }}"
                    style="visibility: hidden; height: 1px; overflow: hidden; padding: 0; border: none;">Load More Products</button>
                  <div id="loading-indicator" style="display: none; font-size: 16px; color: #000;">
                    <span style="display: inline-block; animation: spin 1s linear infinite;">⏳</span>
                    Laddar fler produkter...
                  </div>
                  <style>
                    @keyframes spin {
                      from {
                        transform: rotate(0deg);
                      }
                      to {
                        transform: rotate(360deg);
                      }
                    }
                  </style>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

{%- comment -%} Classic toolbar only: with pills, assets/pm-collection-grid-loader.js does the infinite scroll {%- endcomment -%}
{%- unless pm_pills -%}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log("Infinite scroll script loaded");
    let loading = false;

    async function loadMoreProducts() {
      if (loading) return;

      const loadMoreBtn = document.querySelector("#load-more-btn");
      if (!loadMoreBtn) {
        console.log("No load more button found");
        return;
      }

      const url = loadMoreBtn.dataset.nextUrl;
      if (!url) {
        console.log("No next URL found");
        return;
      }

      console.log("Loading products from:", url);
      loading = true;
      const loadingIndicator = document.querySelector("#loading-indicator");
      if (loadingIndicator) {
        loadingIndicator.style.display = "block";
        console.log("Showing loading indicator");
      }

      try {
        // Use section rendering for faster load - only fetch the product grid section
        const sectionUrl = url + (url.includes('?') ? '&' : '?') + 'section_id=main-collection-product-grid';
        const res = await fetch(sectionUrl);
        const text = await res.text();
        console.log("Fetched response, length:", text.length);

        const parser = new DOMParser();
        const doc = parser.parseFromString(text, "text/html");

        const newProducts = doc.querySelectorAll("#product-grid .grid__item");
        console.log("Found new products:", newProducts.length);
        const grid = document.querySelector("#product-grid");

        newProducts.forEach(item => grid.appendChild(item));

        const newNextUrl = doc.querySelector("#load-more-btn")?.dataset.nextUrl;
        console.log("New next URL:", newNextUrl);

        if (newNextUrl) {
          loadMoreBtn.dataset.nextUrl = newNextUrl;
        } else {
          loadMoreBtn.remove(); // no more pages
          if (loadingIndicator) loadingIndicator.remove();
          console.log("No more pages");
        }

      } catch (err) {
        console.error("Error loading products:", err);
      }

      loading = false;
      if (loadingIndicator) loadingIndicator.style.display = "none";
      console.log("Loading complete");
    }

    // Use Intersection Observer for efficient scroll detection
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        console.log("Intersection observed:", entry.isIntersecting);
        if (entry.isIntersecting && !loading) {
          console.log("Triggering load more");
          loadMoreProducts();
        }
      });
    }, {
      rootMargin: '100px'
    });

    const loadMoreBtn = document.querySelector("#load-more-btn");
    if (loadMoreBtn) {
      observer.observe(loadMoreBtn);
      console.log("Observer attached to load more button");
    } else {
      console.log("Load more button not found on page load");
    }
  });
</script>
{%- endunless -%}

