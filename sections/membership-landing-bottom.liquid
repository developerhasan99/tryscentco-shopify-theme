{%- liquid
  assign max_width = section.settings.max_width
  assign exm_plan_settings = shop.metafields.exison.exison_plan_settings

  assign is_active_member = false
  if customer.metafields.exison.customer_subscription1.status == 'ACTIVE' or customer.metafields.exison.customer_subscription2.status == 'ACTIVE'
    assign is_active_member = true
  endif

-%}

{%- comment -%} Design tokens as inline vars — these override the defaults in the stylesheet below {%- endcomment -%}
{%- capture hf_vars -%}
  --hf-max: {{ max_width }}px;
  --hf-bg: {{ section.settings.color_background | default: '#fbfbfa' }};
  --hf-dark: {{ section.settings.color_panel | default: '#333333' }};
  --hf-fg: {{ section.settings.color_text | default: '#0f172a' }};
  --hf-muted: {{ section.settings.color_text_muted | default: '#5c5c5c' }};
  --hf-gold: {{ section.settings.color_accent | default: '#ffefb1' }};
  --hf-pad-top: {{ section.settings.padding_top | default: '26' }}px;
  --hf-pad-bottom: {{ section.settings.padding_bottom | default: '48' }}px;
{%- endcapture -%}

{%- capture hf_brand_plus -%}<span class="hf-mlp__plus">+</span>{%- endcapture -%}

<div class="hf-mlp-bottom" style="{{ hf_vars }}">

  {%- comment -%} ===================== CTA banner ===================== {%- endcomment -%}
  <div class="hf-mlp-bottom__banner">
    <div class="hf-mlp-bottom__banner-inner">
      <div class="hf-mlp-bottom__banner-media">
        {%- if section.settings.banner_image -%}
          {{
            section.settings.banner_image
            | image_url: width: 1400
            | image_tag:
              alt: '',
              loading: 'lazy',
              class: 'hf-mlp-bottom__banner-img',
              sizes: '(min-width: 900px) 840px, 100vw',
              widths: '480, 720, 960, 1400'
          }}
        {%- else -%}
          <img
            class="hf-mlp-bottom__banner-img"
            src="{{ 'membership-join.png' | asset_url }}"
            alt=""
            width="1024"
            height="1024"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      {%- if is_active_member -%}
        <h2 class="hf-mlp-bottom__banner-title">
          {{- section.settings.member_banner_title | escape | replace: '+', hf_brand_plus -}}
        </h2>

        {%- if section.settings.member_banner_text != blank -%}
          <div class="hf-mlp-bottom__banner-text rte">{{ section.settings.member_banner_text }}</div>
        {%- endif -%}

        <div class="hf-mlp-bottom__banner-cta">
          <a
            class="hf-mlp__btn hf-mlp__btn--light"
            href="{{ section.settings.member_banner_button_link | default: '/apps/subscribfy-api/store/pages/portal' }}"
          >
            {{ section.settings.member_banner_button_text | escape }}
          </a>
        </div>
      {%- else -%}
        <h2 class="hf-mlp-bottom__banner-title">
          {{- section.settings.banner_title | escape | replace: '+', hf_brand_plus -}}
        </h2>

        {%- if section.settings.banner_text != blank -%}
          <div class="hf-mlp-bottom__banner-text rte">{{ section.settings.banner_text }}</div>
        {%- endif -%}

        <div class="hf-mlp-bottom__banner-cta">
          <button type="button" class="hf-mlp__btn hf-mlp__btn--light" data-membership-trigger>
            {{ section.settings.banner_button_text | escape }}
          </button>
        </div>
      {%- endif -%}

      {%- if section.settings.banner_disclaimer != blank -%}
        <div class="hf-mlp-bottom__banner-disclaimer">{{ section.settings.banner_disclaimer | escape }}</div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ===================== FAQ ===================== {%- endcomment -%}
  {%- assign hf_faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if hf_faqs.size > 0 -%}
    <div class="hf-mlp-bottom__faq">
      <div class="hf-mlp-bottom__faq-inner">
        <h2 class="hf-mlp-bottom__faq-title">{{ section.settings.faq_title | escape }}</h2>

        <div class="hf-mlp-bottom__faq-list">
          {%- for block in hf_faqs -%}
            <details class="hf-mlp-bottom__faq-item" {{ block.shopify_attributes }}>
              <summary class="hf-mlp-bottom__faq-question">
                <span>{{ block.settings.question | escape }}</span>
                <span class="hf-mlp-bottom__faq-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  </svg>
                </span>
              </summary>
              <div class="hf-mlp-bottom__faq-answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</div>


{% schema %}
{
  "name": "Membership CTA + FAQ",
  "tag": "section",
  "class": "section--membership-landing-bottom",
  "settings": [
    { "type": "header", "content": "CTA banner" },
    { "type": "image_picker", "id": "banner_image", "label": "Image" },
    { "type": "text", "id": "banner_title", "label": "Title", "info": "A + in this text is rendered in the accent color.", "default": "Gå med i Tryscent+ på vår bekostnad." },
    {
      "type": "richtext",
      "id": "banner_text",
      "label": "Body",
      "default": "<p>Din första månad kostar bara 1,95 €. Få upp till 30 % rabatt på alla dina ordrar och se hur förmånerna växer varje månad.</p>"
    },
    { "type": "text", "id": "banner_button_text", "label": "Button text", "default": "STARTA FÖR 1,95 €" },
    { "type": "text", "id": "banner_disclaimer", "label": "Disclaimer (under button)", "default": "Pausa eller avsluta när som helst" },

    { "type": "header", "content": "CTA banner — active member overrides" },
    { "type": "text", "id": "member_banner_title", "label": "Title (active member)", "default": "Du är med, Tryscent+-medlem." },
    {
      "type": "richtext",
      "id": "member_banner_text",
      "label": "Body (active member)",
      "default": "<p>Hantera, pausa eller avsluta ditt medlemskap när som helst från ditt konto.</p>"
    },
    { "type": "text", "id": "member_banner_button_text", "label": "Button text (active member)", "default": "HANTERA MEDLEMSKAP" },
    { "type": "url", "id": "member_banner_button_link", "label": "Button link (active member)", "info": "Defaults to the Subscribfy customer portal." },

    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_title", "label": "Title", "default": "Vanliga frågor" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_background", "label": "FAQ background", "default": "#fbfbfa" },
    { "type": "color", "id": "color_panel", "label": "Banner background", "default": "#121212" },
    { "type": "color", "id": "color_accent", "label": "Accent", "info": "The + in the banner title.", "default": "#ede5dc" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "color_text_muted", "label": "Secondary text", "default": "#5c5c5c" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Max content width", "min": 600, "max": 1200, "step": 20, "default": 880, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 2, "default": 26, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 2, "default": 48, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "limit": 30,
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Hur går jag med i Tryscent+?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Använd valfri anslutningsknapp på den här sidan, eller välj Gå med i VIP i varukorgen.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Membership CTA + FAQ",
      "category": "Custom",
      "blocks": [
        { "type": "faq", "settings": { "question": "How do I join Tryscent+?", "answer": "<p>Use any join button on this page, or select Join VIP in your cart before you check out.</p>" } },
        { "type": "faq", "settings": { "question": "Does Tryscent+ have a monthly fee?", "answer": "<p>Your first month is 1,95 €. After that it's a flat 14,99 € a month — and every payment comes back to you as store credit you can spend on any order.</p>" } },
        { "type": "faq", "settings": { "question": "How long do I have to keep my membership?", "answer": "<p>No minimum commitment. Pause or cancel anytime.</p>" } },
        { "type": "faq", "settings": { "question": "When do I get charged?", "answer": "<p>You're charged 1,95 € when you join. Billing then continues at 14,99 € on the same date the following month and repeats monthly while your membership is active.</p>" } },
        { "type": "faq", "settings": { "question": "Do I get store credit for my first month?", "answer": "<p>No. The 1,95 € introductory month isn't converted into credit. Store credit starts with your first full month at 14,99 €.</p>" } },
        { "type": "faq", "settings": { "question": "How can I use my store credit?", "answer": "<p>Apply it at checkout. You choose how much of your available credit goes toward the order.</p>" } },
        { "type": "faq", "settings": { "question": "Does the member discount stack?", "answer": "<p>It stacks with site-wide promotions, but not with member-exclusive sales.</p>" } },
        { "type": "faq", "settings": { "question": "How can I cancel or pause my membership?", "answer": "<p>From your account, go to Manage Membership and choose Pause or Cancel.</p>" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
/* ============================================================
   Tryscent+ membership landing page
   Used by sections/membership-landing.liquid and
   sections/membership-landing-bottom.liquid.
   ============================================================ */
.hf-mlp,
.hf-mlp-bottom {
  --hf-bg: #ffffff;
  --hf-alt: #efeeec;
  --hf-dark: #333333;
  --hf-fg: #0f172a;
  --hf-muted: #5c5c5c;
  --hf-body: #3d3d3d;
  --hf-gold: #ffefb1;
  --hf-pad-top: 36px;
  --hf-pad-bottom: 44px;

  font-family: Figtree, sans-serif;
  color: var(--hf-fg);
  text-align: left;
}

.hf-mlp__plus {
  color: var(--hf-gold);
}

/* ---------- Buttons ---------- */
.hf-mlp__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 44px;
  padding: 0 20px;
  border: none;
  border-radius: 999px;
  background: transparent;
  font-family: Figtree, sans-serif;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 2.2px;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer !important;
  transition: opacity 0.15s ease;
}

.hf-mlp__btn:hover {
  opacity: 0.85;
}

.hf-mlp__btn--solid {
  background: #0f172a;
  color: #ffffff !important;
}

.hf-mlp__btn--outline {
  background: transparent;
  border: 1px solid #0f172a;
  color: var(--hf-fg) !important;
}

.hf-mlp__btn--on-dark {
  background: transparent;
  border: 1px solid #ffffff;
  color: #ffffff !important;
}

.hf-mlp__btn--light {
  background: #ffffff;
  color: #0f172a !important;
  font-family: Figtree, sans-serif;
  font-size: 14px;
  font-weight: 700;
}

/* ============================================================
   Bottom section — CTA banner + FAQ
   ============================================================ */
.hf-mlp-bottom__banner {
  background: var(--hf-bg);
}

.hf-mlp-bottom__banner-inner {
  max-width: var(--hf-max, 880px);
  margin: 0 auto;
  padding: 20px 20px 24px;
  box-sizing: border-box;
  text-align: center;
  background: #424242;
  color: #ffffff;
}

.hf-mlp-bottom__banner-media {
  margin-bottom: 30px;
}

.hf-mlp-bottom__banner-img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 8px;
}

.hf-mlp-bottom__banner-title {
  font-size: 40px;
  line-height: 1.25;
  font-weight: 400;
  margin: 0 0 18px;
  color: #ffffff;
}

.hf-mlp-bottom__banner-text {
  font-size: 15.6px;
  line-height: 1.6;
  color: #ffffff;
  max-width: 340px;
  margin: 0 auto 30px;
}

.hf-mlp-bottom__banner-text p {
  margin: 0;
}

.hf-mlp-bottom__banner-cta {
  display: flex;
  justify-content: center;
}

.hf-mlp-bottom__banner-disclaimer {
  font-size: 12px;
  color: #ffffff;
  margin-top: 14px;
  font-weight: 400;
}

.hf-mlp-bottom__banner-disclaimer p {
  margin: 0;
}

.hf-mlp-bottom__faq {
  background: var(--hf-bg);
}

/* The banner owns the top padding setting, the FAQ owns the bottom one, so the
   two ranges control where this section starts and ends. */
.hf-mlp-bottom__faq-inner {
  max-width: var(--hf-max, 880px);
  margin: 0 auto;
  padding: 40px 20px var(--hf-pad-bottom);
  box-sizing: border-box;
}

.hf-mlp-bottom__faq-title {
  font-family: Figtree, sans-serif;
  font-size: 24px;
  font-weight: 500;
  text-align: center;
  margin: 0 0 24px;
}

.hf-mlp-bottom__faq-item {
  border-bottom: 1px solid #999999;
}

.hf-mlp-bottom__faq-question {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 0px;
  font-size: 13.8px;
  font-weight: 500;
  line-height: 1.4;
}

.hf-mlp-bottom__faq-question::-webkit-details-marker {
  display: none;
}

.hf-mlp-bottom__faq-icon {
  display: inline-flex;
  flex: 0 0 auto;
  color: #222222;
  transition: transform 0.2s ease;
}

.hf-mlp-bottom__faq-item[open] .hf-mlp-bottom__faq-icon {
  transform: rotate(45deg);
}

.hf-mlp-bottom__faq-answer {
  padding: 0 30px 20px;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--hf-muted);
}

.hf-mlp-bottom__faq-answer p {
  margin: 0 0 10px;
}

.hf-mlp-bottom__faq-answer p:last-child {
  margin-bottom: 0;
}

@media screen and (min-width: 900px) {
  .hf-mlp__btn {
    max-width: 320px;
  }

  .hf-mlp-bottom__banner-inner {
    padding-left: 32px;
    padding-right: 32px;
  }

  .hf-mlp-bottom__banner-media {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .hf-mlp-bottom__faq-inner {
    padding-left: 32px;
    padding-right: 32px;
  }
}
{% endstylesheet %}
