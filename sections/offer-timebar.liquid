{%- liquid
  comment
    Bundle & Save page (product template bundle-save, Adrian 07.11): own black/white bar (reversed: white strip, black offer + badge rows, timer styled like magyx.co) that matches the offer timer
    in the buy box: "Black Month", up to the bundle's best saving (from its compare-at prices), counting to the
    visitor's local midnight like the buy box timer. Every other page keeps the settings below unchanged.
  endcomment
  assign tb_primary = section.settings.primary_color
  assign tb_secondary = section.settings.secondary_color
  assign tb_top = section.settings.top_banner_text
  assign tb_prepend = section.settings.prepend_text
  assign tb_append = section.settings.append_text
  assign tb_link = section.settings.link
  assign tb_date = section.settings.countdown_date
  assign tb_bs = false
  if product and product.template_suffix == 'bundle-save'
    assign tb_bs = true
    assign tb_max = 0
    for v in product.variants
      if v.compare_at_price > v.price
        assign v_pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
        if v_pct > tb_max
          assign tb_max = v_pct
        endif
      endif
    endfor
    assign tb_primary = section.settings.bs_primary_color
    assign tb_secondary = section.settings.bs_secondary_color
    assign tb_top = section.settings.bs_top_banner_text
    assign tb_prepend = section.settings.bs_prepend_text | replace: '[max]', tb_max
    assign tb_append = section.settings.bs_append_text
    assign tb_link = '#pm-bs-box'
    assign tb_date = ''
  endif
-%}
{%- unless tb_bs -%}
<link rel="stylesheet" href="https://pbutcher.uk/flipdown/css/flipdown/flipdown.css">
<script defer src="https://pbutcher.uk/flipdown/js/flipdown/flipdown.js"></script>
{%- endunless %}

<style>
  /* FlipDown Custom Styles */
  .flipdown {
    width: 190px;
    height: 42px;
  }

  .flipdown div:empty {
    display: block;
  }

  .flipdown .rotor {
    font-size: 1.32rem;
    margin-right: 1.8px;
  }

  .flipdown .rotor,
  .flipdown .rotor-leaf,
  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    width: 18px;
  }

  .flipdown .rotor-group {
    padding-right: 12px;
  }

  .flipdown .rotor-group:last-child {
    padding-right: 0;
  }

  .flipdown .rotor-group-heading:before {
    font-size: 0.48rem;
    height: 12px;
    line-height: 12px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    left: 41px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before {
    bottom: 7.8px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    bottom: 17.4px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-top {
    line-height: 30px;
  }

  .flipdown .rotor-leaf,
  .flipdown .rotor {
    height: 30px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    height: 15px;
  }

  .flipdown.flipdown__theme-dark .rotor-group-heading:before {
    color: {{ tb_primary }};
    font-size: 8px;
    font-weight: 400;
    text-transform: uppercase;
  }

  /* Timebar Section Styles */
  .timebar-section-bg {
    display: block;
    text-decoration: none;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: #f87171;
    background-repeat: repeat;
  }

  .timebar-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
  }

  .timebar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .timebar-sale-text {
    color: white;
    font-size: 2rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .timebar-row {
      gap: 16px;
    }
  }

  /* Coupon Button Styles */
  .flipdown.flipdown__theme-dark .rotor-bottom,
  .flipdown.flipdown__theme-dark .rotor-leaf-rear,
  .flipdown.flipdown__theme-dark .rotor,
  .flipdown.flipdown__theme-dark .rotor-top,
  .flipdown.flipdown__theme-dark .rotor-leaf-front,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    background-color: {{ tb_primary }};
  }

  .flipdown.flipdown__theme-dark .rotor:after {
    border-color: {{ tb_primary }};
  }

  {%- if tb_bs %}
  /* Plain text countdown (no boxes): "SLUTAR OM 09:11:01" */
  .tb-bs-timer {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: 15px;
    line-height: 20px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tb-bs-ends {
    font-weight: 600;
    opacity: 0.85;
  }

  .tb-bs-clock {
    min-width: 8ch;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  @media screen and (min-width: 768px) {
    .tb-bs-timer {
      font-size: 20px;
      line-height: 26px;
    }
  }

  .timebar-bs-badges {
    background-color: {{ tb_secondary }};
    border-color: {{ tb_secondary }};
  }

  .timebar-bs-badges .timebar-bs-label,
  .timebar-bs-label {
    color: {{ tb_primary }};
  }

  .timebar-bs-badges .timebar-bs-divider {
    background-color: rgba(255, 255, 255, 0.25);
  }
  {%- endif %}

  {% if tb_date == blank %}
    .flipdown {
      width: 140px !important;
    }
    .flipdown .rotor-group:first-child {
      display: none;
    }
  {% endif %}
</style>

{% unless product.template_suffix == 'payday-60' or collection.template_suffix == 'bundle-save' %}
  <div id="{{ section.id }}">
    {%- comment -%} No link set: plain banner (div, no click, no underline). {%- endcomment -%}
    {%- if tb_link != blank -%}<a href="{{ tb_link }}" class="no-underline block">{%- else -%}<div class="block">{%- endif -%}
      {% if tb_top != blank %}
        <div class="py-3" style="background-color: {{ tb_primary }};{% if tb_bs %} color: {{ tb_secondary }};{% endif %}">
          <div class="page-width">
            <div class="text-center {% unless tb_bs %}text-white {% endunless %}flex items-center justify-center gap-4 leading-none">-
              <span>{{ tb_top }}</span>
              -</div>
          </div>
        </div>
      {% endif %}
      <div class="py-3 md:py-2" style="background-color: {{ tb_secondary }};">
        <div class="container mx-auto px-4">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-1 justify-center">
            <div class="flex flex-wrap gap-x-4 gap-y-1 items-center justify-center">
              <div style="color: {{ tb_primary }};" class="font-bold text-base md:text-xl">
                {{ tb_prepend }}
              </div>
              <div style="color: {{ tb_primary }};" class="font-semibold text-sm md:text-lg tracking-wider md:order-1{% if tb_link != blank %} underline{% endif %}">
                {{ tb_append }}
              </div>
              {%- if tb_bs -%}
                <div class="tb-bs-timer" style="color: {{ tb_primary }};">
                  <div class="tb-bs-ends">Slutar om</div>
                  <div class="tb-bs-clock" data-tb-clock>00:00:00</div>
                </div>
              {%- else -%}
                <div class="flex items-center gap-2">
                  <div style="color: {{ tb_primary }};" class="text-sm md:text-base font-bold leading-none md:hidden">
                    Slutar om
                  </div>
                  <div id="flipdown" class="flipdown"></div>
                </div>
              {%- endif -%}
            </div>
            {% if section.blocks.size > 0 %}
              <div class="[display:none] md:flex gap-4">
                {% for block in section.blocks %}
                  <div class="flex flex-col items-center {% unless forloop.last %}pr-4 border-0 border-r border-solid border-gray-300{% endunless %}">
                    <img
                      class="rounded"
                      src="{{ block.settings.icon |  image_url  }}"
                      height="25"
                      width=""
                      alt="{{ block.settings.label }}">
                    <div class="leading-none text-xs mt-1 font-semibold {% if tb_bs %}timebar-bs-label{% else %}text-black{% endif %}">
                      {{ block.settings.label }}
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {%- if tb_link != blank -%}</a>{%- else -%}</div>{%- endif %}
  </div>
{% endunless %}
{% if section.blocks.size > 0 %}
  <div class="md:hidden py-3 border-0 border-b border-solid border-gray-200{% if tb_bs %} timebar-bs-badges{% endif %}">
    <div class="page-width">
      <div class="flex gap-2 justify-between">
        {% for block in section.blocks %}
          <div class="flex flex-col items-center">
            <img
              class="rounded"
              src="{{ block.settings.icon |  image_url  }}"
              height="25"
              width=""
              alt="{{ block.settings.label }}">
            <div class="leading-none text-xs mt-1 font-semibold {% if tb_bs %}timebar-bs-label{% else %}text-black{% endif %}">
              {{ block.settings.label }}
            </div>
          </div>
          {% unless forloop.last %}
            <div class="!block w-[1px] bg-gray-200 self-stretch{% if tb_bs %} timebar-bs-divider{% endif %}"></div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function getNextMidnightTimestamp() {
      const nextMidnight = new Date();

      nextMidnight.setHours(24, 0, 0, 0); // next day 00:00:00

      return Math.floor(nextMidnight.getTime() / 1000);
    }

    function getCountdownDeadline() {
      const configuredDate = {{ tb_date | json }};

      if (!configuredDate) {
        return getNextMidnightTimestamp();
      }

      const configuredTimestamp = Math.floor(new Date(configuredDate).getTime() / 1000);

      return Number.isNaN(configuredTimestamp) ? getNextMidnightTimestamp() : configuredTimestamp;
    }

    const deadline = getCountdownDeadline();

    {%- if tb_bs %}
    // Bundle & Save page: plain HH:MM:SS text clock instead of FlipDown
    const tbClocks = document.querySelectorAll('[data-tb-clock]');
    const tbPad = (n) => String(n).padStart(2, '0');
    const tbTick = () => {
      const left = Math.max(0, deadline - Math.floor(Date.now() / 1000));
      const text = tbPad(Math.floor(left / 3600)) + ':' + tbPad(Math.floor((left % 3600) / 60)) + ':' + tbPad(left % 60);
      tbClocks.forEach((el) => { el.textContent = text; });
    };
    tbTick();
    setInterval(tbTick, 1000);
    return;
    {%- endif %}

    // Countdown headings per Weglot language (falls back to "sv")
    const countdownHeadings = {
      sv: ["Dag", "Tim", "Min", "Sek"],
      da: ["Dag", "Timer", "Min", "Sek"],
      fi: ["Päivä", "Tunti", "Min", "Sek"],
      no: ["Dag", "Time", "Min", "Sek"],
    };

    const flipdownEl = document.getElementById('flipdown');

    function buildFlipdown(lang) {
      const headings = countdownHeadings[lang] || countdownHeadings.sv;

      // Clear any previously rendered rotors before re-instantiating
      if (flipdownEl) {
        flipdownEl.innerHTML = '';
      }

      new FlipDown(deadline, {
        headings: headings,
      })
        .start()
        .ifEnded(() => {
          console.log('Countdown ended');
        });
    }

    const currentLang = (window.Weglot && typeof Weglot.getCurrentLang === 'function' && Weglot.getCurrentLang()) || 'sv';
    buildFlipdown(currentLang);

    if (window.Weglot && typeof Weglot.on === 'function') {
      Weglot.on('languageChanged', function (newLang) {
        buildFlipdown(newLang);
      });
    }
  });
</script>

{% schema %}
  {
    "name": "Offer Timebar",
    "settings": [
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary Color",
        "default": "#173E34"
      },
      {
        "type": "color",
