{{ 'pm-s-bs-review-carousel.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .premium .pm-bsrv--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .premium .pm-bsrv--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%} tryscent.eu: only real reviews. No blocks = nothing for customers, a hint in the editor {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div id="{{ section.id }}" class="pm-bsrv pm-bsrv--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="pm-bsrv__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="pm-h2 pm-bsrv__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pm-body-lg pm-muted pm-bsrv__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.rating_text != blank -%}
        <p class="pm-bsrv__rating">
          {% render 'pm-stars', size: 12 %}
          <span class="pm-small">{{ section.settings.rating_text }}</span>
        </p>
      {%- endif -%}
    </div>

    <div class="pm-bsrv__stage">
      <button type="button" class="pm-bsrv__arrow pm-bsrv__arrow--prev" data-prev aria-label="{{ section.settings.prev_label | escape }}" disabled>
        {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
      </button>
      <ul class="pm-bsrv__track" data-track role="list">
        {%- for block in section.blocks -%}
          {%- assign rating = block.settings.rating | default: 5 | plus: 0 -%}
          <li class="pm-bsrv__card{% if block.settings.image != blank or block.settings.image_url != blank %} pm-bsrv__card--media{% endif %}" data-card {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="pm-bsrv__media">
                {{ block.settings.image | image_url: width: 760 | image_tag: widths: '380, 570, 760', sizes: '(min-width: 990px) 380px, (min-width: 750px) 45vw, 86vw', loading: 'lazy', alt: block.settings.author }}
              </div>
            {%- elsif block.settings.image_url != blank -%}
              <div class="pm-bsrv__media">
                <img src="{{ block.settings.image_url }}{% unless block.settings.image_url contains '?' %}?width=760{% endunless %}" alt="{{ block.settings.author | escape }}" width="760" height="760" loading="lazy">
              </div>
            {%- endif -%}
            <span class="pm-bsrv__stars" role="img" aria-label="Betyg {{ rating }} av 5">
              {%- for i in (1..5) -%}
                <svg{% if i > rating %} class="is-empty"{% endif %} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endfor -%}
            </span>
            <p class="pm-bsrv__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
            <div class="pm-bsrv__who">
              <span class="pm-bsrv__name">{{ block.settings.author }}</span>
              {%- if block.settings.verified -%}
                <span class="pm-bsrv__verified">{% render 'pm-icon', icon: 'check', size: 12, stroke: 2 %}{{ section.settings.verified_text }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="pm-bsrv__arrow pm-bsrv__arrow--next" data-next aria-label="{{ section.settings.next_label | escape }}">
        {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
      </button>
    </div>
  </div>
</div>
{%- elsif request.design_mode -%}
  <div class="page-width"><p class="pm-small pm-muted">Add real customer reviews (e.g. from Judge.me) as blocks so the section appears on the page.</p></div>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('{{ section.id }}');
    if (!root || root.hasAttribute('data-started')) return;
    root.setAttribute('data-started', '1');

    var track = root.querySelector('[data-track]');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    if (!track) return;

    function stepSize() {
      var card = track.querySelector('[data-card]');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth - 2;
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max;
    }

    function go(dir) {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({ left: dir * stepSize(), behavior: reduce ? 'auto' : 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { go(-1); });
    if (next) next.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Bundle: review carousel",
  "tag": "section",
  "class": "premium",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recensioner av våra dofter"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "info": "Real data only (e.g. a rating from Judge.me). Empty hides it."
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified label",
      "default": "Verifierat köp"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Label: previous",
      "default": "Föregående recensioner"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Label: next",
      "default": "Nästa recensioner"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Photo URL (used only when no photo is picked)"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote (quotation marks are added automatically)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified label",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Bundle: review carousel"
    }
  ]
}
{% endschema %}
