      "info": "Shown when the section has Dupe point blocks."
    },
    {
      "type": "text",
      "id": "their_title",
      "label": "Designer card title",
      "default": "Designerparfymer",
      "info": "Shown when the section has Designer point blocks."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button label",
      "default": "Sätt ihop ditt paket"
    },
    {
      "type": "text",
      "id": "btn_url",
      "label": "Button link",
      "info": "Empty = scrolls to the scent picker on this page."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
