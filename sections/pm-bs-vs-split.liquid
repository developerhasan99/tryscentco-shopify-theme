      "name": "Our point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "drop",
              "label": "Drop"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "layers",
              "label": "Layers"
            },
            {
              "value": "shuffle",
              "label": "Shuffle"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ],
          "default": "drop"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "20% parfymolja"
        }
      ]
    },
    {
      "type": "dupe_point",
      "name": "Dupe point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Märks bara i högst 3-4 timmar"
        }
      ]
    },
    {
      "type": "their_point",
      "name": "Designer point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
