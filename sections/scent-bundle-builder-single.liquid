{%- liquid
  assign st = section.settings
  assign grid_pool = st.grid_collection | default: collections['best-sellers']
  assign variant_ml = '100ml'

  assign b_total = st.bundle_total | plus: 0
  assign b_discount_qty = st.bundle_discount_qty | plus: 0
  assign b_paid = b_total | minus: b_discount_qty
  assign b_percent = st.discount_percent | plus: 0
  assign b_ribbon = 'Köp ' | append: b_paid | append: ', få ' | append: b_discount_qty | append: ' till med ' | append: b_percent | append: '% rabatt'

  assign eligible_handles = ''
  for p in grid_pool.products
    assign has_ml = false
    for v in p.variants
      assign vt = v.title | downcase | replace: ' ml', 'ml'
      if vt == variant_ml
        assign has_ml = true
        break
      endif
    endfor
    if has_ml
      assign eligible_handles = eligible_handles | append: '|' | append: p.handle | append: '|'
    endif
  endfor

  assign start_counter = st.counter_text | replace: '[selected]', 0 | replace: '[total]', b_total
  assign start_hint = st.hint_text | replace: '[remaining]', b_total
  if b_total == 1
    assign start_hint = st.hint_text_one
  endif
-%}

{{ 'scent-bundle-builder.css' | asset_url | stylesheet_tag }}
{{ 'scent-bundle-builder-single.css' | asset_url | stylesheet_tag }}
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div class="sbb sbb--single" x-data="sbbSingleBuilder()">
  <div class="sbb-top">
    {%- if section.blocks.size > 0 -%}
      <div class="sbb-gallery">
        <div class="sbb-gallery__main">
          {%- for block in section.blocks -%}
            {%- assign img = block.settings.image -%}
            {%- if img != blank -%}
              <img
                x-show="galleryIndex === {{ forloop.index0 }}"
                src="{{ img | image_url: width: 900 }}"
                srcset="{{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 900px) 45vw, 100vw"
                alt="{{ block.settings.alt | default: img.alt | escape }}"
                width="{{ img.width }}"
                height="{{ img.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {{ block.shopify_attributes }}>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.blocks.size > 1 -%}
          <div class="sbb-gallery__thumbs">
            {%- for block in section.blocks -%}
              {%- assign img = block.settings.image -%}
              {%- if img != blank -%}
                <button
                  type="button"
                  class="sbb-gallery__thumb"
                  :class="{ 'is-active': galleryIndex === {{ forloop.index0 }} }"
                  @click="galleryIndex = {{ forloop.index0 }}"
                  aria-label="Visa bild {{ forloop.index }}"
                  {{ block.shopify_attributes }}>
                  <img
                    src="{{ img | image_url: width: 160 }}"
                    alt=""
                    width="72"
                    height="72"
                    loading="lazy">
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sbb-content">
      <header class="sbb-head">
        {%- if st.offer_badge != blank -%}
          <span class="sbb-head__badge">{{ st.offer_badge | escape }}</span>
        {%- endif -%}
        {%- if st.heading != blank or st.heading_accent != blank -%}
          <h2 class="sbb-head__title">
            {{- st.heading | escape -}}
            {%- if st.heading_accent != blank %}
              <span class="sbb-head__title-accent">{{ st.heading_accent | escape }}</span>
            {% endif -%}
          </h2>
        {%- endif -%}
        {%- if st.subheading != blank -%}
          <div class="sbb-head__sub">{{ st.subheading }}</div>
        {%- endif -%}
      </header>

      <div class="sbb-builder" x-ref="preview">
        <div class="sbb-builder__main">
          <div class="sbb-slots">
            <template x-for="(s, i) in slotsArray" :key="i">
              <div
                class="sbb-slot"
                :class="{ 'sbb-slot--free': isDiscounted(i), 'sbb-slot--filled': slot(i) }"
                @click="scrollToPool()">
                <span
                  class="sbb-slot__badge"
                  x-show="!isDiscounted(i)"
                  x-text="i + 1"></span>
                <span class="sbb-slot__pill" x-show="isDiscounted(i)">{{ st.discount_pill_label | escape }}</span>
                <template x-if="slot(i)">
                  <span class="sbb-slot__pick">
                    <img
                      :src="slot(i).image"
                      alt=""
                      width="80"
                      height="80">
                    <button
                      type="button"
                      class="sbb-slot__x"
                      @click.stop="removeAt(i)"
                      aria-label="Ta bort">&times;</button>
                  </span>
                </template>
                <template x-if="!slot(i)">
                  <svg
                    class="sbb-slot__bottle"
                    width="62"
                    height="120"
                    viewBox="0 0 62 120"
                    aria-hidden="true">
                    <rect
                      x="21.8"
                      y="0.8"
                      width="18.4"
                      height="26"
                      rx="3"></rect>
                    <rect
                      x="0.8"
                      y="26.8"
                      width="60.4"
                      height="92.4"
                      rx="8"></rect>
                  </svg>
                </template>
                <span
                  class="sbb-slot__label"
                  x-show="!slot(i)"
                  x-text="isDiscounted(i) ? {{ st.discount_slot_label | json | escape }} : {{ st.slot_label | json | escape }}"></span>
                <span
                  class="sbb-slot__label sbb-slot__label--name"
                  x-show="slot(i)"
                  x-text="slot(i) && slot(i).name"></span>
              </div>
            </template>
          </div>
          <div class="sbb-progress">
            <div class="sbb-progress__track">
              <div class="sbb-progress__fill" :style="'width: ' + percent + '%'"></div>
            </div>
            <p class="sbb-progress__copy">
              <span x-text="counter">{{ start_counter | escape }}</span>
              <span>&bull;</span>
              <span x-text="message">{{ start_hint | escape }}</span>
            </p>
          </div>
        </div>

        <aside class="sbb-summary">
          <div class="sbb-summary__row">
            <span>{{ st.total_label | escape }}</span>
            <span x-text="money(ordTotal)"></span>
          </div>
          <template x-if="discount > 0">
            <div class="sbb-summary__row sbb-summary__row--discount">
              <span>{{ st.discount_label | escape }}</span>
              <span x-text="'-' + money(discount)"></span>
            </div>
          </template>
          <div class="sbb-summary__row sbb-summary__row--total">
            <span>{{ st.price_label | escape }}</span>
            <span x-text="money(yourPrice)">{{ 0 | money }}</span>
          </div>
          <button
            type="button"
            class="sbb-summary__cta"
            :disabled="!full || adding"
            @click="addToCart()">
            <span x-text="ctaLabel"></span>
          </button>
        </aside>
      </div>
    </div>
  </div>

  <div class="sbb-controls" x-ref="pool">
    <form class="sbb-search" @submit.prevent>
      <input
        type="search"
        placeholder="{{ st.search_placeholder | escape }}"
        x-model="q"
        x-ref="searchInput">
    </form>
    <div class="sbb-controls__row">
      <select x-model="brand" x-show="brandOptions.length">
        <option value="">Inspirerad av</option>
        <template x-for="o in brandOptions" :key="o">
          <option :value="o" x-text="'Doftar som ' + o"></option>
        </template>
      </select>
      <select x-model="gender" x-show="genderOptions.length">
        <option value="">Kön</option>
        <template x-for="o in genderOptions" :key="o">
          <option :value="o" x-text="o"></option>
        </template>
      </select>
    </div>
  </div>

  <div class="sbb-grid">
    <template x-for="p in visible" :key="p.id">
      <div class="sbb-card" :class="{ 'is-selected': isPicked(p.id) }">
        <button
          type="button"
          class="sbb-card__media"
          :aria-pressed="isPicked(p.id)"
          @click="toggle(p.id)">
          <img
            :src="p.image"
            :alt="p.name"
            width="280"
            height="280"
            loading="lazy">
          <template x-if="ribbon">
            <span class="sbb-card__ribbon" x-text="ribbon"></span>
          </template>
        </button>
        <button
          type="button"
          class="sbb-card__title"
          :aria-pressed="isPicked(p.id)"
          @click="toggle(p.id)"
          x-text="p.name"></button>
        <p class="sbb-card__price">
          <span x-text="money(p.price)"></span>
          <template x-if="p.compareAt > p.price">
            <s x-text="money(p.compareAt)"></s>
          </template>
          <span class="sbb-card__size">100 ml</span>
        </p>
        <button
          type="button"
          class="sbb-card__cta"
          :class="{ 'is-active': isPicked(p.id) }"
          :disabled="!canToggle(p.id)"
          @click="toggle(p.id)">
          <span x-text="isPicked(p.id) ? 'Tillagd' : {{ st.cta_label | json | escape }}"></span>
        </button>
      </div>
    </template>
  </div>
  <p class="sbb-empty" x-show="visible.length === 0">{{ st.empty_text | escape }}</p>
  <div
    class="sbb-load-sentinel"
    x-ref="loadMoreSentinel"
    x-show="visible.length < filtered.length"></div>

  <div class="sbb-sticky" :class="{ 'is-visible': showSticky }">
    <div class="sbb-sticky__container">
      <div class="sbb-sticky__inner">
        <div class="sbb-sticky__slots">
          <template x-for="(s, i) in slotsArray" :key="i">
            <div class="sbb-sticky__slot" :class="{ 'is-filled': slot(i), 'sbb-sticky__slot--free': isDiscounted(i) }">
              <span class="sbb-sticky__pill" x-show="isDiscounted(i)">{{ st.discount_pill_label | escape }}</span>
              <template x-if="slot(i)"><img
                  :src="slot(i).image"
                  alt=""
                  width="60"
                  height="60"></template>
              <template x-if="!slot(i)">
                <svg
                  class="sbb-sticky__bottle"
                  width="24"
                  height="44"
                  viewBox="0 0 24 44"
                  aria-hidden="true">
                  <rect
                    x="8.5"
                    y="0.5"
                    width="7"
                    height="9"
                    rx="1"></rect>
                  <rect
                    x="0.5"
                    y="9.5"
                    width="23"
                    height="34"
                    rx="3"></rect>
                </svg>
              </template>
            </div>
          </template>
        </div>
        <div class="sbb-sticky__mid">
          <p x-text="counter" class="sbb-counter">{{ start_counter | escape }}</p>
          <p x-text="message" class="sbb-message">{{ start_hint | escape }}</p>
        </div>
        <div class="sbb-sticky__buy">
          <span x-text="money(yourPrice)" class="sbb-sticky__price">{{ 0 | money }}</span>
          <button
            type="button"
            :disabled="!full || adding"
            @click="addToCart()">
            <span x-text="ctaLabel"></span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('alpine:init', function () {
    Alpine.data('sbbSingleBuilder', function () {
      return {
        moneyFormat: {{ shop.money_format | json }},
        adding: false,
        showSticky: false,
        galleryIndex: 0,
        q: '',
        brand: '',
        gender: '',
        visibleCount: 8,
        pageSize: 8,
        picks: [],
        total: {{ b_total }},
        discountQty: {{ b_discount_qty }},
        discountPercent: {{ b_percent }},
        ribbon: {{ b_ribbon | json }},
        products: [
          {%- for p in grid_pool.products -%}
            {%- assign handle_token = '|' | append: p.handle | append: '|' -%}
            {%- unless eligible_handles contains handle_token -%}{%- continue -%}{%- endunless -%}
            {%- assign match = blank -%}
            {%- for v in p.variants -%}
              {%- assign vt = v.title | downcase | replace: ' ml', 'ml' -%}
              {%- if vt == variant_ml -%}{%- assign match = v -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {
              id: {{ p.id }},
              name: {{ p.title | json }},
              url: {{ p.url | json }},
              image: {{ p.featured_image | image_url: width: 560 | json }},
              price: {{ match.price }},
              compareAt: {{ match.compare_at_price | default: 0 }},
              variantId: {{ match.id | json }},
              brand: {{ p.metafields.custom.brand.value | join: '||' | json }},
              gender: {{ p.metafields.custom.gender.value | join: '||' | json }}
            },
          {%- endfor -%}
        ],
        init() {
          var self = this;
          this.$nextTick(function () {
            if (self.$refs.preview && 'IntersectionObserver' in window) {
              var stickyObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                  self.showSticky = !entry.isIntersecting && entry.boundingClientRect.top < 0;
                });
              }, { threshold: 0 });
              stickyObserver.observe(self.$refs.preview);
            } else {
              self.showSticky = true;
            }
            var checkLoadMore = function () {
              if (!self.$refs.loadMoreSentinel || self.visibleCount >= self.filtered.length) return;
              var rect = self.$refs.loadMoreSentinel.getBoundingClientRect();
              if (rect.top < window.innerHeight + 400) {
                self.visibleCount += self.pageSize;
                self.$nextTick(checkLoadMore);
              }
            };
            var ticking = false;
            var onScroll = function () {
              if (ticking) return;
              ticking = true;
              window.requestAnimationFrame(function () {
                ticking = false;
                checkLoadMore();
              });
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll);
            checkLoadMore();
          });
          ['q', 'brand', 'gender'].forEach(function (key) {
            self.$watch(key, function () { self.visibleCount = self.pageSize; });
          });
        },
        scrollToPool() {
          if (!this.$refs.pool) return;
          this.$refs.pool.scrollIntoView({ behavior: 'smooth', block: 'start' });
          if (this.$refs.searchInput) {
            var input = this.$refs.searchInput;
            setTimeout(function () { input.focus({ preventScroll: true }); }, 400);
          }
        },
        get slotsArray() { return Array.from({ length: this.total }); },
        isDiscounted(i) { return i >= this.total - this.discountQty; },
        get brandOptions() {
          var set = new Set();
          this.products.forEach(function (p) { p.brand.split('||').forEach(function (b) { if (b) set.add(b); }); });
          return Array.from(set).sort();
        },
        get genderOptions() {
          var set = new Set();
          this.products.forEach(function (p) { p.gender.split('||').forEach(function (g) { if (g) set.add(g); }); });
          return Array.from(set).sort();
        },
        get filtered() {
          var q = this.q.trim().toLowerCase();
          return this.products.filter(function (p) {
            if (this.brand && p.brand.split('||').indexOf(this.brand) === -1) return false;
            if (this.gender && p.gender.split('||').indexOf(this.gender) === -1) return false;
            if (q && p.name.toLowerCase().indexOf(q) === -1) return false;
            return true;
          }, this);
        },
        get visible() {
          var list = this.filtered;
          return list.filter(function (p, i) { return this.isPicked(p.id) || i < this.visibleCount; }, this);
        },
        slot(i) { return this.picks[i] || null; },
        isPicked(id) { return this.picks.some(function (p) { return p.id === id; }); },
        canToggle(id) { return this.isPicked(id) || this.picks.length < this.total; },
        toggle(id) {
          if (this.isPicked(id)) {
            this.picks = this.picks.filter(function (p) { return p.id !== id; });
            return;
          }
          if (this.picks.length >= this.total) return;
          var product = this.products.find(function (p) { return p.id === id; });
          if (product) this.picks = this.picks.concat([product]);
        },
        removeAt(i) { this.picks.splice(i, 1); },
        get full() { return this.picks.length >= this.total; },
        get percent() { return this.total ? Math.min(100, Math.round((this.picks.length / this.total) * 100)) : 0; },
        get counter() { return {{ st.counter_text | json }}.replace('[selected]', this.picks.length).replace('[total]', this.total); },
        get message() {
          var remaining = Math.max(0, this.total - this.picks.length);
          if (remaining === 0) return {{ st.done_text | json }};
          if (remaining === 1) return {{ st.hint_text_one | json }};
          return {{ st.hint_text | json }}.replace('[remaining]', remaining);
        },
        get ctaLabel() {
          if (this.adding) return 'Lägger till…';
          if (this.full) return {{ st.cta_button_label | json }};
          var remaining = Math.max(0, this.total - this.picks.length);
          if (remaining === 1) return {{ st.cta_disabled_label_one | json }};
          return {{ st.cta_disabled_label | json }}.replace('[remaining]', remaining);
        },
        // Every product in the pool shares the same 100ml price, so the final
        // total/discount/price can be shown up front instead of only once the
        // bundle is full. Estimate only: the real total is whatever the
        // matching automatic discount computes at checkout.
        get unitPrice() { return this.products.length ? this.products[0].price : 0; },
        get ordTotal() { return this.unitPrice * this.total; },
        get discount() {
          return Math.round(this.unitPrice * this.discountQty * (this.discountPercent / 100));
        },
        get yourPrice() { return this.ordTotal - this.discount; },
        money(cents) {
          var n = Math.round(Number(cents) || 0);
          var int = String(Math.floor(Math.abs(n) / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
          var dec = String(Math.abs(n) % 100).padStart(2, '0');
          var out = String(this.moneyFormat || '{' + '{amount}' + '}').replace(/\{\{\s*amount\w*\s*\}\}/, int + '.' + dec).replace(/<[^>]+>/g, '');
          return (n < 0 ? '-' : '') + out;
        },
        addToCart() {
          if (!this.full || this.adding) return;
          this.adding = true;
          var items = this.picks.map(function (p) { return { id: p.variantId, quantity: 1 }; });
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: items })
          })
            .then(function (res) { if (!res.ok) throw new Error('cart add failed'); return res.json(); })
            .then(function () { window.location.href = '/checkout'; })
            .catch(function () { this.adding = false; }.bind(this));
        }
      };
    });
  });
</script>

{% schema %}
  {
    "name": "Bundle builder 60% off",
    "settings": [
      {
        "type": "collection",
        "id": "grid_collection",
        "label": "Scent grid collection",
        "info": "Defaults to best-sellers. Only 100ml variants are shown."
      },
      {
        "type": "header",
        "content": "Bundle product"
      },
      {
        "type": "product",
        "id": "parent_product",
        "label": "Parent product",
        "info": "The product added to cart for this bundle. Its first available variant is used; the chosen scents are attached to it as line item properties."
      },
      {
        "type": "header",
        "content": "Offer"
      },
      {
        "type": "number",
        "id": "bundle_total",
        "label": "Total bottles",
        "default": 5
      },
      {
        "type": "number",
        "id": "bundle_discount_qty",
        "label": "Discounted bottles",
        "info": "The cheapest N of the total get the % off below",
        "default": 3
      },
      {
        "type": "number",
        "id": "discount_percent",
        "label": "Discount percent",
        "default": 60
      },
      {
        "type": "text",
        "id": "offer_badge",
        "label": "Offer badge",
        "info": "Short pill text, e.g. \"PAYDAY DEAL\". Leave blank to hide",
        "default": "PayDay Deal"
      },
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Bygg din doftgarderob för"
      },
      {
        "type": "text",
        "id": "heading_accent",
        "label": "Heading, highlighted part",
        "info": "Shown in accent color at the end of the heading, e.g. \"60% less\"",
        "default": "60% mindre"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Subheading",
        "default": "<p>Köp 2x100ml av dina favoritparfymer och få <strong>3x100ml GRATIS</strong> i PayDay-paketet</p>"
      },
      {
        "type": "header",
        "content": "Builder"
      },
      {
        "type": "text",
        "id": "slot_label",
        "label": "Empty slot label",
        "default": "Välj din doft"
      },
      {
        "type": "text",
        "id": "discount_slot_label",
        "label": "Discounted slot label",
        "default": "Rabatterad doft"
      },
      {
        "type": "text",
        "id": "discount_pill_label",
        "label": "Discounted slot tag",
        "default": "-60%"
      },
      {
        "type": "text",
        "id": "counter_text",
        "label": "Progress counter",
        "info": "[selected] / [total]",
        "default": "[selected] / [total] valda"
      },
      {
        "type": "text",
        "id": "hint_text",
        "label": "Progress hint",
        "info": "[remaining]",
        "default": "Lägg till [remaining] doft till för att låsa upp din rabatt!"
      },
      {
        "type": "text",
        "id": "hint_text_one",
        "label": "Progress hint, one left",
        "default": "Lägg till 1 doft till för att låsa upp din rabatt!"
      },
      {
        "type": "text",
        "id": "done_text",
        "label": "Progress done message",
        "default": "Ditt paket är klart!"
      },
      {
        "type": "header",
        "content": "Price summary"
      },
      {
        "type": "text",
        "id": "total_label",
        "label": "Ordinary total label",
        "default": "Ord. totalpris"
      },
      {
        "type": "text",
        "id": "discount_label",
        "label": "Discount label",
        "default": "Rabatt"
      },
      {
        "type": "text",
        "id": "price_label",
        "label": "Your price label",
        "default": "Ditt pris"
      },
      {
        "type": "text",
        "id": "savings_label",
        "label": "Savings label",
        "default": "Du sparar"
      },
      {
        "type": "header",
        "content": "Grid"
      },
      {
        "type": "text",
        "id": "search_placeholder",
        "label": "Search placeholder",
        "default": "Hitta din parfym"
      },
      {
        "type": "text",
        "id": "cta_label",
        "label": "Card button",
        "default": "Lägg"
      },
      {
        "type": "text",
        "id": "empty_text",
        "label": "No results message",
        "default": "Inga dofter matchar din sökning."
      },
      {
        "type": "text",
        "id": "cta_button_label",
        "label": "Sticky bar button",
        "default": "Lägg i varukorg"
