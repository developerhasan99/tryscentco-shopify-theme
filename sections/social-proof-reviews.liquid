{%- capture star_svg -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z"/></svg>{%- endcapture -%}

<style>
.ts-proof-sv{font-family:Inter,Arial,Helvetica,sans-serif;color:#111315;background:#fff;padding:48px 0;overflow:hidden}
.ts-proof-sv *{box-sizing:border-box;margin:0}
.ts-proof-sv .container{width:min(860px,calc(100% - 36px));margin-inline:auto}
.ts-proof-sv .proof-head{text-align:center;max-width:640px;margin:0 auto 30px}
.ts-proof-sv .stars-lg,.ts-proof-sv .review-stars{display:flex;gap:3px}
.ts-proof-sv .stars-lg{justify-content:center;margin-bottom:14px}
.ts-proof-sv .stars-lg span,.ts-proof-sv .review-stars span{display:grid;place-items:center;background:#00b67a}
.ts-proof-sv .stars-lg span.off,.ts-proof-sv .review-stars span.off{background:#dcdce6}
.ts-proof-sv .stars-lg span{width:28px;height:28px}
.ts-proof-sv .review-stars span{width:15px;height:15px}
.ts-proof-sv svg{fill:#fff;width:76%;height:76%}
.ts-proof-sv .kicker{font-size:12px;letter-spacing:.13em;text-transform:uppercase;font-weight:800;color:#00b67a;margin-bottom:10px}
.ts-proof-sv .section-title{font-size:26px;line-height:1.25;font-weight:800;color:#121212}
.ts-proof-sv .carousel{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 8px}
.ts-proof-sv .carousel::-webkit-scrollbar{display:none}
.ts-proof-sv .review-card{flex:0 0 calc((100% - 32px) / 3);scroll-snap-align:start;display:flex;flex-direction:column;background:#fff;border:1px solid #e8e8e8;border-radius:10px;padding:16px 16px 14px;box-shadow:0 1px 4px rgba(0,0,0,.05)}
.ts-proof-sv .review-top{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.ts-proof-sv .review-card h3{margin-bottom:8px;font-size:14px;line-height:1.4;font-weight:700;color:#121212}
.ts-proof-sv .review-card p{margin-bottom:8px;font-size:13px;line-height:1.6;color:rgba(0,0,0,.62)}
.ts-proof-sv .review-card p.result-line{font-weight:600;color:#121212;margin-bottom:12px}
.ts-proof-sv .person{margin-top:auto;font-size:13px;color:#121212}
.ts-proof-sv .person strong{display:block;font-size:13px}
.ts-proof-sv .person span{display:block;font-size:11px;line-height:1.35;color:rgba(0,0,0,.55)}
.ts-proof-sv .nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px}
.ts-proof-sv .arrow{width:40px;height:40px;border-radius:50%;border:1px solid #d6d6d6;background:#fff;color:#121212;font-size:22px;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 3px;transition:background .2s,color .2s,border-color .2s}
.ts-proof-sv .arrow:hover{background:#121212;border-color:#121212;color:#fff}
.ts-proof-sv .arrow:disabled{opacity:.35;cursor:default;background:#fff;color:#121212;border-color:#d6d6d6}
.ts-proof-sv .dots{display:flex;gap:0}
.ts-proof-sv .dot{box-sizing:content-box;width:8px;height:8px;border-radius:50%;border:0;padding:8px 5px;background:#d9d9d9;background-clip:content-box;cursor:pointer}
.ts-proof-sv .dot.active{background:#00b67a;background-clip:content-box}
@media(max-width:749px){
  .ts-proof-sv{padding:32px 0}
  .ts-proof-sv .container{width:100%}
  .ts-proof-sv .proof-head{padding:0 18px;margin-bottom:22px}
  .ts-proof-sv .stars-lg span{width:24px;height:24px}
  .ts-proof-sv .section-title{font-size:22px}
  .ts-proof-sv .carousel{gap:12px;padding:4px 18px 8px;scroll-padding-left:18px}
  .ts-proof-sv .review-card{flex-basis:82%}
  .ts-proof-sv .arrow{display:none}
}
{% if section.settings.custom_css != blank %}
#{{ section.id }} {
  {{ section.settings.custom_css }}
}
{% endif %}
</style>

<section id="{{ section.id }}" class="ts-proof-sv">
  <div class="container">
    <div class="proof-head">
      <div class="stars-lg" role="img" aria-label="5 av 5 stjärnor">
        {%- for i in (1..5) -%}<span>{{ star_svg }}</span>{%- endfor -%}
      </div>
      {% if section.settings.kicker != blank %}
        <div class="kicker">{{ section.settings.kicker }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="carousel" data-ts-carousel>
      {% for block in section.blocks %}
        <article class="review-card" {{ block.shopify_attributes }}>
          <div class="review-top">
            <div class="review-stars" role="img" aria-label="{{ block.settings.rating }} av 5 stjärnor">
              {%- for i in (1..5) -%}<span{% if i > block.settings.rating %} class="off"{% endif %}>{{ star_svg }}</span>{%- endfor -%}
            </div>
          </div>
          {% if block.settings.title != blank %}
            <h3>”{{ block.settings.title }}”</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.result_line != blank %}
            <p class="result-line">{{ block.settings.result_line }}</p>
          {% endif %}
          <div class="person"><strong>{{ block.settings.name }}</strong><span>{{ block.settings.label }}</span></div>
        </article>
      {% endfor %}
    </div>
    <div class="nav">
      <button type="button" class="arrow" data-ts-prev aria-label="Föregående recension">‹</button>
      <div class="dots" data-ts-dots></div>
      <button type="button" class="arrow" data-ts-next aria-label="Nästa recension">›</button>
    </div>
  </div>
</section>

<script>
(function(){
  var roots = document.querySelectorAll('.ts-proof-sv');
  Array.prototype.forEach.call(roots, function(root){
    // Theme editor re-runs this script on section reload; skip already-wired instances
    if (root.dataset.tsInit) return;
    root.dataset.tsInit = '1';
    var track = root.querySelector('[data-ts-carousel]');
    var dotsWrap = root.querySelector('[data-ts-dots]');
    var prev = root.querySelector('[data-ts-prev]');
    var next = root.querySelector('[data-ts-next]');
    if (!track || !dotsWrap || !prev || !next) return;
    var cards = Array.prototype.slice.call(track.children);
    if (!cards.length) return;

    function step(){ return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
    function positions(){ return Math.max(1, cards.length - Math.round(track.clientWidth / step()) + 1); }
    function current(){
      var max = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft >= max - 2) return positions() - 1;
      return Math.round(track.scrollLeft / step());
    }
    function go(i){ track.scrollTo({left: i * step(), behavior: 'smooth'}); }

    function buildDots(){
      dotsWrap.innerHTML = '';
      for (var i = 0; i < positions(); i++) {
        var d = document.createElement('button');
        d.type = 'button';
        d.className = 'dot';
        d.setAttribute('aria-label', 'Recension ' + (i + 1));
        d.addEventListener('click', go.bind(null, i));
        dotsWrap.appendChild(d);
      }
      update();
    }
    function update(){
      var c = current(), n = positions();
      Array.prototype.forEach.call(dotsWrap.children, function(d, i){ d.classList.toggle('active', i === c); });
      prev.disabled = c <= 0;
      next.disabled = c >= n - 1;
    }

    prev.addEventListener('click', function(){ go(Math.max(0, current() - 1)); });
    next.addEventListener('click', function(){ go(Math.min(positions() - 1, current() + 1)); });
    var t;
    track.addEventListener('scroll', function(){ clearTimeout(t); t = setTimeout(update, 60); });
    window.addEventListener('resize', buildDots);
    buildDots();
  });
})();
</script>

