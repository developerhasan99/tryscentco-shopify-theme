<style>
  .ts-proof-sv {
    font-family: Inter
    , Arial
    , Helvetica
    , sans-serif;
    color: #111315;
    background: #fff;
    padding: 48px 0;
    overflow: hidden
  }
  .ts-proof-sv * {
    box-sizing: border-box;
    margin: 0
  }
  .ts-proof-sv .container {
    width: min(860px, calc(100% - 36px));
    margin-inline: auto
  }
  .ts-proof-sv .proof-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 30px
  }
  .ts-proof-sv .stars {
    display: flex;
    gap: 3px;
    color: #FFC106;
    --size: 15px
  }
  .ts-proof-sv .stars svg {
    width: var(--size);
    height: var(--size)
  }
  .ts-proof-sv .stars svg.off {
    color: #dcdce6
  }
  .ts-proof-sv .stars-lg {
    --size: 28px;
    justify-content: center;
    margin-bottom: 14px
  }
  .ts-proof-sv .kicker {
    font-size: 12px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 800;
    color: #156b32;
    margin-bottom: 10px
  }
  .ts-proof-sv .section-title {
    font-size: 26px;
    line-height: 1.25;
    font-weight: 800;
    color: #121212
  }
  .ts-proof-sv .carousel {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 4px 2px 8px
  }
  .ts-proof-sv .carousel::-webkit-scrollbar {
    display: none
  }
  .ts-proof-sv .review-card {
    flex: 0 0 calc((100% - 32px) / 3);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e8e8e8;
    border-radius: 10px;
    padding: 16px 16px 14px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .05)
  }
  .ts-proof-sv .review-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px
  }
  .ts-proof-sv .review-card h3 {
    margin-bottom: 8px;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 700;
    color: #121212
  }
  .ts-proof-sv .review-card p {
    margin-bottom: 8px;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(0, 0, 0, .62)
  }
  .ts-proof-sv .review-card p.result-line {
    font-weight: 600;
    color: #121212;
    margin-bottom: 12px
  }
  .ts-proof-sv .person {
    margin-top: auto;
    font-size: 13px;
    color: #121212
  }
  .ts-proof-sv .person strong {
    display: block;
    font-size: 13px
  }
  .ts-proof-sv .person span {
    display: block;
    font-size: 11px;
    line-height: 1.35;
    color: rgba(0, 0, 0, .55)
  }
  .ts-proof-sv .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 18px
  }
  .ts-proof-sv .arrow {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #d6d6d6;
    background: #fff;
    color: #121212;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0 0 3px;
    transition: background 0.2s
    , color 0.2s
    , border-color 0.2s
  }
  .ts-proof-sv .arrow:hover {
    background: #121212;
    border-color: #121212;
    color: #fff
  }
  .ts-proof-sv .arrow:disabled {
    opacity: .35;
    cursor: default;
    background: #fff;
    color: #121212;
    border-color: #d6d6d6
  }
  .ts-proof-sv .dots {
    display: flex;
    gap: 0
  }
  .ts-proof-sv .dot {
    box-sizing: content-box;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    padding: 8px 5px;
    background: #d9d9d9;
    background-clip: content-box;
    cursor: pointer
  }
  .ts-proof-sv .dot.active {
    background: #156b32;
    background-clip: content-box
  }
  @media(max-width: 749px) {
    .ts-proof-sv {
      padding: 32px 0
    }
    .ts-proof-sv .container {
      width: 100%
    }
    .ts-proof-sv .proof-head {
      padding: 0 18px;
      margin-bottom: 22px
    }
    .ts-proof-sv .stars-lg {
      --size: 24px
    }
    .ts-proof-sv .section-title {
      font-size: 22px
    }
    .ts-proof-sv .carousel {
      gap: 12px;
      padding: 4px 18px 8px;
      scroll-padding-left: 18px
    }
    .ts-proof-sv .review-card {
      flex-basis: 82%
    }
    .ts-proof-sv .arrow {
      display: none
    }
  }
</style>

{%- style -%}
  {% if section.settings.custom_css != blank %}
    #{{ section.id }} {
      {{ section.settings.custom_css }}
    }
  {% endif %}
{%- endstyle -%}

