<section id="{{ section.id }}" class="ts-proof-sv">
  <div class="container">
    <div class="proof-head">
      <div
        class="stars stars-lg"
        role="img"
        aria-label="5 av 5 stjärnor">
        {%- for i in (1..5) -%}
          <svg aria-hidden="true"><use href="#ts-star-{{ section.id }}" /></svg>
        {%- endfor -%}
      </div>
      {% if section.settings.kicker != blank %}
        <div class="kicker">{{ section.settings.kicker }}</div>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section-title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>
    <div class="carousel" data-ts-carousel>
      {% for block in section.blocks %}
        <article class="review-card" {{ block.shopify_attributes }}>
          <div class="review-top">
            <div
              class="stars review-stars"
              role="img"
              aria-label="{{ block.settings.rating }} av 5 stjärnor">
              {%- for i in (1..5) -%}
                <svg
                  {% if i > block.settings.rating %}
                  class="off"
                  {% endif %}
                  aria-hidden="true"><use href="#ts-star-{{ section.id }}" /></svg>
              {%- endfor -%}
            </div>
          </div>
          {% if block.settings.title != blank %}
            <h3>”{{ block.settings.title }}”</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.result_line != blank %}
            <p class="result-line">{{ block.settings.result_line }}</p>
          {% endif %}
          <div class="person">
            <strong>{{ block.settings.name }}</strong>
            <span>{{ block.settings.label }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
    <div class="nav">
      <button
        type="button"
        class="arrow"
        data-ts-prev
        aria-label="Föregående recension">‹</button>
      <div class="dots" data-ts-dots></div>
      <button
        type="button"
        class="arrow"
        data-ts-next
        aria-label="Nästa recension">›</button>
    </div>
  </div>
</section>

<script>
  (function(){
  var roots = document.querySelectorAll('.ts-proof-sv');
  Array.prototype.forEach.call(roots, function(root){
    // Theme editor re-runs this script on section reload; skip already-wired instances
    if (root.dataset.tsInit) return;
    root.dataset.tsInit = '1';
    var track = root.querySelector('[data-ts-carousel]');
    var dotsWrap = root.querySelector('[data-ts-dots]');
    var prev = root.querySelector('[data-ts-prev]');
    var next = root.querySelector('[data-ts-next]');
    if (!track || !dotsWrap || !prev || !next) return;
    var cards = Array.prototype.slice.call(track.children);
    if (!cards.length) return;

    function step(){ return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
    function positions(){ return Math.max(1, cards.length - Math.round(track.clientWidth / step()) + 1); }
    function current(){
      var max = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft >= max - 2) return positions() - 1;
      return Math.round(track.scrollLeft / step());
    }
    function go(i){ track.scrollTo({left: i * step(), behavior: 'smooth'}); }

    function buildDots(){
      dotsWrap.innerHTML = '';
      for (var i = 0; i < positions(); i++) {
        var d = document.createElement('button');
        d.type = 'button';
        d.className = 'dot';
        d.setAttribute('aria-label', 'Recension ' + (i + 1));
        d.addEventListener('click', go.bind(null, i));
        dotsWrap.appendChild(d);
      }
      update();
    }
    function update(){
      var c = current(), n = positions();
      Array.prototype.forEach.call(dotsWrap.children, function(d, i){ d.classList.toggle('active', i === c); });
      prev.disabled = c <= 0;
      next.disabled = c >= n - 1;
    }

    prev.addEventListener('click', function(){ go(Math.max(0, current() - 1)); });
    next.addEventListener('click', function(){ go(Math.min(positions() - 1, current() + 1)); });
    var t;
    track.addEventListener('scroll', function(){ clearTimeout(t); t = setTimeout(update, 60); });
    window.addEventListener('resize', buildDots);
    buildDots();
  });
  })();
</script>

