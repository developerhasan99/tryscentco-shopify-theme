{%- comment -%}
  fmx (FM bundle page test): copy of snippets/bundle-builder-modal.liquid, FM classes (fmx-bb-*), same Alpine bindings.
{%- endcomment -%}
{% liquid
  assign filter_all = 'bundle.filter_all' | t
  if filter_all contains 'ranslation missing' or filter_all == blank
    assign filter_all = 'Alla'
  endif
%}
{%- comment -%}
  iPhone Safari: the page behind is locked while the picker is open, the search box is only
  focused on open where there is a mouse (on phones that focus kept the list from taking the
  first swipe), and on phones the sheet uses the visible screen height so it sits higher.
{%- endcomment -%}
<style>
  @media screen and (max-width: 767px) {
    .bb-modal-sheet { height: 90vh; height: 90dvh; }
  }
</style>
<div
  x-data
  x-init="$watch('$store.bundleBuilder.showModal', open => document.body.classList.toggle('overflow-hidden', open))"
  x-transition
  x-show="$store.bundleBuilder.showModal"
  class="fixed inset-0 bg-black bg-opacity-50 flex items-end md:items-center justify-center z-[9999]"
  x-cloak>
  <div class="fmx-bb-modal bb-modal-sheet bg-white pb-3 max-w-xl w-full h-[80vh] md:h-[90vh] flex flex-col relative" @click.away="$store.bundleBuilder.showModal = false">
    <button @click="$store.bundleBuilder.showModal = false" class="absolute -top-10 right-2 md:top-2 md:right-2 w-8 h-8 fmx-bb-close flex items-center justify-center  border-0 text-3xl cursor-pointer transition">
      <span class="[rotate:-45deg] size-4 flex">
        {{- 'icon-plus.svg' | inline_asset_content -}}
      </span>
    </button>
    <div class="modal-header flex-shrink-0">
      <div class="fmx-bb-head p-3 pt-5">
        <h2 class="fmx-bb-title">
          <span x-show="$store.bundleBuilder.selectedProducts.length === $store.bundleBuilder.bundleLength">
            {{ 'bundle.your_bundle_is_ready' | t }}
          </span>
          <span x-show="$store.bundleBuilder.selectedProducts.length < $store.bundleBuilder.bundleLength">
            <span>{{ 'bundle.add_more_prefix' | t }}</span>
            <span x-text="$store.bundleBuilder.bundleLength - $store.bundleBuilder.selectedProducts.length"></span>
            <span x-show="($store.bundleBuilder.bundleLength - $store.bundleBuilder.selectedProducts.length) === 1">
              {{ 'bundle.add_more_suffix_singular' | t }}
            </span>
            <span x-show="($store.bundleBuilder.bundleLength - $store.bundleBuilder.selectedProducts.length) > 1">
              {{ 'bundle.add_more_suffix_plural' | t }}
            </span>
          </span>
        </h2>
        <p class="fmx-bb-sub">Bygg ditt
          <span x-text="$store.bundleBuilder.bundleLength"></span>-flaskorspaket</p>
      </div>
      <div x-show="$store.bundleBuilder.selectedProducts.length < $store.bundleBuilder.bundleLength" class="px-3 py-2">
        <div class="flex flex-wrap gap-1.5">
          <button
            @click="$store.bundleBuilder.activeCategory = 'All'"
            :class="$store.bundleBuilder.activeCategory === 'All' ? 'is-active' : ''"
            class="fmx-bb-chip">{{ filter_all | escape }}</button>
          <template x-for="filter in $store.bundleBuilder.filters" :key="filter.handle">
            <button
              type="button"
              @click="$store.bundleBuilder.activeCategory = filter.handle"
              :class="$store.bundleBuilder.activeCategory === filter.handle ? 'is-active' : ''"
              class="fmx-bb-chip"
              x-text="filter.label"></button>
          </template>
        </div>
      </div>
      <div class="px-3 pb-3">
        <div class="relative">
            <div class="absolute top-[7px] left-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
            </div>
            <input
            type="text"
            placeholder="Söka..."
            x-model="$store.bundleBuilder.searchText"
            x-effect="$store.bundleBuilder.showModal && window.matchMedia('(hover: hover)').matches && $nextTick(() => $el.focus({ preventScroll: true }))"
            class="fmx-bb-search block w-full p-2 pl-8">
        </div>
      </div>
    </div>

    {% comment %} Product Grid {% endcomment %}
    <div class="flex-1 overflow-y-auto p-3 pt-0">
      <template x-if="$store.bundleBuilder.selectedProducts.length === $store.bundleBuilder.bundleLength">
        <div class="text-center mt-10">
          <div role="status">
            <svg
              aria-hidden="true"
              class="size-20 animate-spin fmx-bb-spinner"
              viewBox="0 0 100 101"
              fill="none"
              xmlns="http://www.w3.org/2000/svg">
              <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor" />
              <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill" />
            </svg>
            <span class="sr-only">{{ 'accessibility.loading' | t }}</span>
          </div>
          <p class="fmx-bb-title">{{ 'bundle.redirecting_to_checkout' | t }}</p>
        </div>
      </template>
      <template x-if="$store.bundleBuilder.selectedProducts.length < $store.bundleBuilder.bundleLength">
        <div class="flex flex-col gap-1.5">
          <template x-for="product in $store.bundleBuilder.availableProducts" :key="product.id">
            <template x-if="($store.bundleBuilder.activeCategory === 'All' || product.collections.split(',').includes($store.bundleBuilder.activeCategory)) &&
         ($store.bundleBuilder.searchText === '' || product.name.toLowerCase().includes($store.bundleBuilder.searchText.toLowerCase()) || (product.inspiration_name && product.inspiration_name.toLowerCase().includes($store.bundleBuilder.searchText.toLowerCase())))">
              <div
                @click="$store.bundleBuilder.addProduct(product)"
                :class="$store.bundleBuilder.isProductSelected(product.id) ? 'is-selected' : ''"
                class="fmx-bb-item w-full p-2 flex items-center gap-2 justify-between cursor-pointer">
                <img
                  class="fmx-bb-item__img"
                  :src="product.image"
                  :alt="product.name"
                  width="56"
                  height="56">
                <div class="text-left flex flex-col gap-1 mr-auto">
                  <h3 class="fmx-bb-item__name line-clamp-1" x-text="product.name"></h3>
                  <div x-show="product.inspiration_name != ''" class="flex items-center gap-2">
                    <img
                      class="object-contain object-center size-6"
                      :src="product.inspiration_image"
                      :alt="product.inspiration_name"
                      width="35"
                      height="35">
                      <p class="fmx-bb-item__label">{{ 'bundle.inspired_by' | t }}</p>
                      <h4 x-text="product.inspiration_name" class="text-xs font-semibold my-0 line-clamp-1 inspiration_heading"></h4>
                  </div>
                </div>
                <div class="shrink-0 ml-auto text-center">
                    <div class="fmx-bb-item__size" x-text="$store.bundleBuilder.selectedVariant"></div>
                    <button
                      type="button"
                      x-show="!$store.bundleBuilder.isProductSelected(product.id)"
                      @click.stop="$store.bundleBuilder.addProduct(product)"
                      aria-label="Lägg till"
                      class="fmx-bb-qty">+</button>
                    <div x-show="$store.bundleBuilder.isProductSelected(product.id)" class="flex items-center gap-1.5">
                      <button
                        type="button"
                        @click.stop="$store.bundleBuilder.decrementProduct(product)"
                        aria-label="Ta bort en"
                        class="fmx-bb-qty">−</button>
                      <span class="fmx-bb-qty__n" x-text="$store.bundleBuilder.productQty(product.id)"></span>
                      <button
                        type="button"
                        @click.stop="$store.bundleBuilder.addProduct(product)"
                        aria-label="Lägg till"
                        class="fmx-bb-qty fmx-bb-qty--fill">+</button>
                    </div>
                </div>
              </div>
            </template>
          </template>
        </div>
      </template>
    </div>
  </div>
</div>
