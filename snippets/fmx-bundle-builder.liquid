{%- comment -%}
  fmx (FM bundle page test): copy of snippets/bundle-builder.liquid. Same Alpine store, same cart logic;
  FM classes on the slots (fmx-slot) and the button (pm-btn pm-atc), and under the button the payment
  icons + badge row of the FM product page (fmx-payment-icons, fmx-shipping-badges) instead of the grey
  payment-badge.png and the "Levereras till" line.
{%- endcomment -%}
{% liquid
  # Each entry is "handle" or "handle:Button label", e.g. "men:Men,women,new:New arrivals".
  # Each collection is both part of the product pool and a filter button in bundle-builder-modal
  assign bundle_collection_entries = product.metafields.custom.bundle_collections | default: block.settings.collection_handles | split: ','
  assign bundle_collection_handles = ''
  for entry in bundle_collection_entries
    assign entry_handle = entry | split: ':' | first | strip | downcase
    if entry_handle == blank
      continue
    endif
    assign bundle_collection_handles = bundle_collection_handles | append: entry_handle | append: ','
  endfor
  assign bundle_collection_handles = bundle_collection_handles | split: ',' | uniq
%}
{% assign product_count = product.metafields.custom.bundle_size %}
{% assign dropdown_ml = product.metafields.custom.select_bundle_dropdown_ml | default: "50" %}
{% assign bundle_ml = dropdown_ml | append: "ml" %}
{%- comment -%} Normalised size token ("50", "50ml", "50 ML" -> "50ml"), compared against variant titles normalised the same way {%- endcomment -%}
{% assign bundle_size_token = dropdown_ml | append: '' | downcase | strip | replace: ' ', '' | remove: 'ml' | append: 'ml' %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign fixed_bundle_products = product.metafields.custom.fixed_bundle_products.value %}

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

{%- liquid
  assign next_bundle = product.metafields.custom.next_bundle
  if next_bundle != blank
    assign next_bundle_product = next_bundle.value
    assign next_size = next_bundle_product.metafields.custom.select_bundle_dropdown_ml
    assign price_difference = next_bundle_product.price | minus: product.price | money
  endif
-%}

{% if next_bundle != blank %}
  <div class="fmx-upgrade">
    <div class="flex items-center gap-2">
      <svg
        class="size-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
      </svg>
      <span>
        <a href="{{ next_bundle_product.url }}" class="fmx-upgrade__link">
          {{ 'bundle.upgrade_cta' | t: size: next_size, price: price_difference }}</a>
      </span>
    </div>
  </div>
{% endif %}

<div x-data>
  <div class="fmx-slots">
    <template x-for="index in ({{ product_count }})" :key="index">
      <div
        {% unless product.tags contains 'fixed_bundle' %}
          @click="$store.bundleBuilder.showModal = true"
        {% endunless %}
        class="fmx-slot"
        :class="{ 'is-filled' : typeof $store.bundleBuilder.selectedProducts[index - 1] !== 'undefined'}">
        <div x-text="index" class="fmx-slot__num"></div>
        <div x-show="!$store.bundleBuilder.selectedProducts[index - 1]" class="flex gap-2 items-center flex-grow">
            {% render 'perfume-icon'
            , size: 40 %}
            <div class="fmx-slot__empty">
            {{ 'bundle.choose_your_perfume' | t }}
            </div>
            <span class="fmx-slot__chevron"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg></span>
        </div>
        <div x-show="$store.bundleBuilder.selectedProducts[index - 1]" class="flex gap-2 items-center flex-grow">
            <img
                class="fmx-slot__img"
                :src="$store.bundleBuilder.selectedProducts[index - 1].image"
                :alt="$store.bundleBuilder.selectedProducts[index - 1].name"
                width="40"
                height="40"
            >
            <div class="text-left flex flex-col gap-1">
                <div class="fmx-slot__name line-clamp-1" x-text="$store.bundleBuilder.selectedProducts[index - 1].name"></div>
                <div class="fmx-slot__meta line-clamp-1" x-text="$store.bundleBuilder.selectedProducts[index - 1].inspiration_name"></div>
            </div>
            {% unless product.tags contains 'fixed_bundle' %}
              <button type="button" aria-label="Ta bort" @click.stop.prevent="$store.bundleBuilder.removeProduct(index - 1)" class="fmx-slot__remove">
                {% render 'icon-trash' %}
              </button>
            {% endunless %}
        </div>
      </div>
    </template>
  </div>

  <button
    x-data
    @click="$store.bundleBuilder.doATCandCheckout()"
    :disabled="$store.bundleBuilder.selectedProducts.length < {{ product_count }} || $store.bundleBuilder.addingToCart"
    :class="{ 'is-incomplete': $store.bundleBuilder.selectedProducts.length < {{ product_count }} }"
    class="button button--full-width pm-btn pm-btn--primary pm-atc fmx-bb-atc"
  >
    <span x-show="$store.bundleBuilder.selectedProducts.length < {{ product_count }}" x-text='{{ "bundle.select_more" | t: count: "__count__" | json }}.replace("__count__", {{ product_count }} - $store.bundleBuilder.selectedProducts.length)'></span>
    <span x-show="$store.bundleBuilder.selectedProducts.length === {{ product_count }}">{{ 'bundle.shop_now' | t }}</span>
    <span class="fmx-bb-atc__dot" aria-hidden="true">·</span>
    <span class="current-price">{{ selected_variant.price | money }}</span>
    <div x-show="$store.bundleBuilder.addingToCart" class="loading__spinner">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="spinner"
        viewBox="0 0 66 66">
        <circle
          stroke-width="6"
          cx="33"
          cy="33"
          r="30"
          fill="none"
          class="path"></circle>
      </svg>
    </div>
  </button>
  <p
    x-data
    x-show="$store.bundleBuilder.cartError"
    x-text="$store.bundleBuilder.cartError"
    role="alert"
    aria-live="assertive"
    class="fmx-atc__error"
  ></p>
</div>

{% render 'fmx-payment-icons' %}

{% unless product.template_suffix == 'cro-deck' %}
  {% render 'fmx-shipping-badges', product: product %}
{% endunless %}

<script>
  document.addEventListener('alpine:init', function() {
    Alpine.store('bundleBuilder', {
      selectedVariant: {{ bundle_size_token | json }},
      bundleLength: {{ product_count }},
      showModal: false,
      activeCategory: "All",
      // Button text: inline "handle:Label", else the collection's custom.filter_label metafield, else its title
      filters: [
        {%- assign seen_handles = ',' -%}
        {%- for entry in bundle_collection_entries -%}
          {%- liquid
            assign raw_handle = entry | split: ':' | first
            assign entry_handle = raw_handle | strip | downcase
            assign seen_key = ',' | append: entry_handle | append: ','
            assign bundle_collection = collections[entry_handle]
            assign filter_label = ''
            if entry contains ':'
              assign filter_label = entry | remove_first: raw_handle | remove_first: ':' | strip
            endif
            assign filter_label = filter_label | default: bundle_collection.metafields.custom.filter_label.value | default: bundle_collection.title
          -%}
          {%- if entry_handle == blank or bundle_collection == blank or seen_handles contains seen_key -%}{%- continue -%}{%- endif -%}
          {%- assign seen_handles = seen_handles | append: entry_handle | append: ',' -%}
          {
            handle: {{ bundle_collection.handle | json }},
            label: {{ filter_label | json }}
          },
        {%- endfor -%}
      ],
      searchText: "",
      addingToCart: false,
      cartError: '',
      selectedProducts: [
        {% if product.tags contains 'fixed_bundle' %}
          {% for fixed_var in fixed_bundle_products %}
            {
              id: {{ fixed_var.product.id }},
              name: "{{ fixed_var.product.title }}",
              image: "{{ fixed_var.product.featured_image | image_url }}",
              inspiration_name: "{% if fixed_var.product.metafields.custom.inspiration.value %}{{ fixed_var.product.metafields.custom.inspiration.value.name }}{% endif %}",
              variant: {
                id: "{{ fixed_var.id }}",
                title: "{{ fixed_var.title }}"
              }
            },
          {% endfor %}
        {% endif %}
      ],
      availableProducts: Array.from(new Map([
        {% for bundle_collection_handle in bundle_collection_handles %}
          {% assign bundle_collection = collections[bundle_collection_handle] %}
          {% if bundle_collection == blank %}{% continue %}{% endif %}
          {% paginate bundle_collection.products by 250 %}
            {% for bundle_product in bundle_collection.products %}
              {% liquid
                # Find this product's bundle-size variant; skip the product when it has none or it is out of stock
                assign bundle_variant = nil
                for variant in bundle_product.variants
                  assign variant_token = variant.title | downcase | strip | replace: ' ', ''
                  if variant_token == bundle_size_token
                    assign bundle_variant = variant
                    break
                  endif
                endfor
                if bundle_variant == blank or bundle_variant.available == false
                  continue
                endif
                # available stays true for tracked variants set to "continue selling when out of stock"
                if bundle_variant.inventory_management == 'shopify' and bundle_variant.inventory_quantity < 1
                  continue
                endif

                assign collection_handles = ''
                for collection in bundle_product.collections
                  assign collection_handles = collection_handles | append: collection.handle
                  if forloop.last == false
                    assign collection_handles = collection_handles | append: ','
                  endif
                endfor
              %}
              {
                id: {{ bundle_product.id }},
                name: "{{ bundle_product.title }}",
                image: "{{ bundle_product.featured_image | image_url: width: 120, height: 120 }}",
                nuta: "{% if bundle_product.metafields.custom.inspiration.value %}{{ bundle_product.metafields.custom.inspiration.value.name }}{% endif %}",
                inspiration_image: "{% if bundle_product.metafields.custom.inspiration.value %}{{ bundle_product.metafields.custom.inspiration.value.image | image_url: width: 90, height: 90 }}{% endif %}",
                inspiration_name: "{% if bundle_product.metafields.custom.inspiration.value %}{{ bundle_product.metafields.custom.inspiration.value.name }}{% endif %}",
                tags: {{ bundle_product.tags | json }},
                collections: "{{ collection_handles }}",
                variants: {
                  {{ bundle_size_token | json }}: {
                    title: {{ bundle_variant.title | json }},
                    id: "{{ bundle_variant.id }}"
                  }
                }
              },
            {% endfor %}
          {% endpaginate %}
        {% endfor %}
      ].map(product => [product.id, product])).values()),
      // The same product may fill several slots
      addProduct(product) {
        if (this.selectedProducts.length >= {{ product_count }}) return;
        product.variant = product.variants[this.selectedVariant]
        this.selectedProducts.push(product);

        if (this.selectedProducts.length === {{ product_count }}) {
          this.showModal = false;
          {%- if block.settings.skip_atc_button %}
          this.doATCandCheckout();
          {%- endif %}
        }
      },
      // Drops the last slot holding this product
      decrementProduct(product) {
        const index = this.selectedProducts.findLastIndex(item => item.id === product.id);
        if (index > -1) this.removeProduct(index);
      },
      productQty(productId) {
        return this.selectedProducts.filter(item => item.id === productId).length;
      },
      removeProduct(index) {
        this.selectedProducts.splice(index, 1);
      },
      isProductSelected(productId) {
        return this.selectedProducts.some(product => product.id === productId);
      },
      doATCandCheckout() {
        // Set loading state
        this.addingToCart = true;
        this.cartError = '';

        // Products pushed directly (e.g. quiz prefill) have no variant set yet
        this.selectedProducts.forEach(product => {
          product.variant = product.variant || product.variants[this.selectedVariant];
        });

        // Create properties object with bundle items
        const properties = {
          "_bundle_items": this.selectedProducts.map(product => 
            product.variant.id
          ).join(',')
        };
        // Add each selected product as a separate property
        this.selectedProducts.forEach((product, index) => {
          properties[`Flasche ${index + 1}`] =
            `${product.name} Inspiriert von ${product.inspiration_name} - ${product.variant.title}`;
        });
        // Prepare cart items
        const items = {
          items: [{
            id: {{ selected_variant.id }},
            quantity: 1,
            properties: properties
          }]
        };
        const goToCheckout = {{ block.settings.open_checkout | json }};
        const cart = document.querySelector('cart-drawer');
        if (cart && !goToCheckout) {
          items.sections = cart.getSectionsToRender().map(section => section.id);
          items.sections_url = window.location.pathname;
        }

        // Make the API call
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(items),
        })
        .then(async response => {
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data.status) {
            // Shopify returns { status, message, description } on failure
            const error = new Error(data.description || data.message || `Request failed with status ${response.status}`);
            error.response = data;
            throw error;
          }
          return data;
        })
        .then(data => {
          {%- unless product.tags contains 'fixed_bundle' %}
          this.selectedProducts = [];
          {%- endunless %}
          if (goToCheckout) window.location.href = '/checkout';
          else if (cart) cart.renderContents(data);
          else window.location.href = '/cart';
        })
        .catch(error => {
          console.error('Error adding to cart:', error, error.response || '');
          this.cartError = (error.response && (error.response.description || error.response.message))
            || {{ 'sections.cart.cart_error' | t | json }};
        })
        .finally(() => {
          this.addingToCart = false;
        });
      }
    });
  });
</script>