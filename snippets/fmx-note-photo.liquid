  {%- when 'bulgarisk ros', 'damaskros', 'damastros', 'grasse ros', 'ros', 'turkisk ros', 'vit ros' -%}note_rose.webp
  {%- when 'saffran' -%}note_saffron.webp
  {%- when 'muskatellsalvia', 'salvia' -%}note_sage.webp
  {%- when 'australiskt sandelträ', 'sandelträ' -%}note_sandalwood.webp
  {%- when 'salt' -%}note_sea-salt.webp
  {%- when 'akvatiska noter', 'havsanteckningar', 'havsvatten', 'marina noter' -%}note_sea-water.webp
  {%- when 'tobak', 'tobaksblad' -%}note_tobacco.webp
  {%- when 'toffee' -%}note_toffee.webp
  {%- when 'tonka', 'tonkaböna', 'tonkabönor' -%}note_tonka-bean.webp
  {%- when 'tuberosa', 'tuberose' -%}note_tuberose.webp
  {%- when 'bourbonvanilj', 'madagaskarvanilj', 'madagaskisk vanilj', 'svart vanilj', 'vanilj', 'vanilj absolut' -%}note_vanilla.webp
  {%- when 'haitisk vetiver', 'vetiver' -%}note_vetiver.webp
  {%- when 'träiga noter', 'träiga toner', 'tränoter' -%}note_woody-notes.webp
{%- endcase -%}
