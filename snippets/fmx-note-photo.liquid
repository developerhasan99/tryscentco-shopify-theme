  {%- when 'apelsin', 'siciliansk apelsin' -%}note_orange.webp
  {%- when 'orkidé' -%}note_orchid.webp
  {%- when 'agarträ', 'agarträ (oud)', 'agarwood', 'oud' -%}note_oud.webp
  {%- when 'indisk patchouli', 'indonesisk patchouli', 'patchouli' -%}note_patchouli.webp
  {%- when 'persika' -%}note_peach.webp
  {%- when 'päron' -%}note_pear.webp
  {%- when 'pion' -%}note_peony.webp
  {%- when 'ananas' -%}note_pineapple.webp
