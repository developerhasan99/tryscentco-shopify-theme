{%- comment -%}
  Payment methods row under the buy button: quantity-breaker and reactive-atc.
  Shopify's own full-colour icons: PayPal, Klarna, SEPA-Lastschrift, eps,
  Apple Pay, Google Pay, Visa, Mastercard (Amex dropped, Klarna added 21.10.2026). A fixed list, not
  shop.enabled_payment_types: that one changes with the shopper's market.
  'sepadirectdebit' is the payment_icons name for SEPA Direct Debit
  (Lastschrift), not 'sepa_direct_debit'.
  Styles: .mgx-pay-icons in magyx-brand.css.
  Shopify prints the icon's hover title in English ("SEPA Direct Debit"); replaced with the German name
  (05.11.2026). The other titles are brand names.

  Usage:
  {% render 'mgx-payment-icons' %}
{%- endcomment -%}
{%- assign mgx_pay_types = 'paypal,klarna,sepadirectdebit,eps,apple_pay,google_pay,visa,master' | split: ',' -%}

<style>
  /* Payment icons container */
  ul.mgx-pay-icons {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;

    width: 100%;
    margin: 16px 0;
    padding: 0;

    list-style: none;
    list-style-type: none;
  }

  /* Remove all list bullets */
  ul.mgx-pay-icons > li {
    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0;
    padding: 0;

    list-style: none;
    list-style-type: none;
  }

  ul.mgx-pay-icons > li::marker {
    content: "";
  }

  ul.mgx-pay-icons > li::before {
    content: none;
  }

  /* Payment SVG icons */
  ul.mgx-pay-icons .mgx-pay-icons__icon {
    display: block;
    width: 42px;
    height: auto;
    max-width: 100%;
  }

  /* Mobile responsiveness */
  @media screen and (max-width: 749px) {
    ul.mgx-pay-icons {
      gap: 6px;
      margin: 12px 0;
    }

    ul.mgx-pay-icons .mgx-pay-icons__icon {
      width: 38px;
    }
  }
</style>

<ul
  class="mgx-pay-icons"
  role="list"
  aria-label="Zahlungsmethoden"
>
  {%- for type in mgx_pay_types -%}
    <li>
      {{
        type
        | payment_type_svg_tag: class: 'mgx-pay-icons__icon'
        | replace: '>SEPA Direct Debit<', '>SEPA-Lastschrift<'
      }}
    </li>
  {%- endfor -%}
</ul>