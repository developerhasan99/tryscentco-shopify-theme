{% comment %}
  Renders the TryScent statistic rings on the product page.

  Accepts:
  - block: {Object} block from main-product section

  Usage:
  {% render 'product-statistics', block: block %}
{% endcomment %}

<div class="product-statistics mt-6 rounded-lg border border-solid border-gray-500 bg-white p-4 shadow lg:p-6" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="mb-4 mt-0 text-center !text-[15px] font-black uppercase leading-5 tracking-normal text-black">
      {{ block.settings.heading }}
    </p>
  {%- endif -%}

  <div class="flex flex-col gap-4">
    {%- for i in (1..4) -%}
      {%- liquid
        assign text_key = 'text_' | append: i
        assign percent_key = 'percent_' | append: i
        assign stat_text = block.settings[text_key]
        assign stat_text_plain = stat_text | strip_html | strip
        assign stat_percent = block.settings[percent_key] | default: 0

        if stat_percent > 100
          assign stat_percent = 100
        elsif stat_percent < 0
          assign stat_percent = 0
        endif
      -%}

      {%- if stat_text_plain != blank -%}
        <div class="flex items-center gap-3">
          <div class="flex aspect-square h-[50px] w-[50px] flex-shrink-0 items-center justify-center rounded-full border-2 border-solid border-[#009244] text-[16px] font-black leading-3 tracking-normal">
            {{ stat_percent }}%
          </div>
          <div class="text-[14px] !leading-5 tracking-normal [&_p]:mt-0 [&_p]:mb-2 [&_p:last-child]:mb-0 [&_p]:text-[14px] [&_p]:!leading-5 [&_strong]:font-bold [&_strong]:text-black">
            {{ stat_text }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if block.settings.disclaimer != blank -%}
    <p class="mb-0 mt-4 text-center text-xs text-gray-500">
      {{ block.settings.disclaimer }}
    </p>
  {%- endif -%}
</div>