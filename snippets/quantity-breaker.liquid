
{% liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign selected_variant = product.selected_or_first_available_variant

  for variant in product.variants
    assign variant_title_down = variant.title | downcase
    if variant_title_down contains '100'
      assign selected_variant = variant
      break
    endif
  endfor

  assign bonus_collection = collections['best-sellers']
  assign selected_size_key = selected_variant.title | downcase | remove: ' '
%}

<style>
  .rapi-bundle-content-0,
  .rapi-bundle-boosters-afteratc-0 {
    display: none !important;
  }

  [x-cloak] {
    display: none !important;
  }

  .atc-button.loading > *:not(.loading__spinner) {
    visibility: hidden;
  }

  /* Quantity breaker radio indicators */
  #atc_scroll_target .qb-tier-card::before,
  #atc_scroll_target .qb-tier-card::after,
  #atc_scroll_target .qb-tier-radio::before,
  #atc_scroll_target .qb-tier-radio::after {
    content: none;
    display: none;
  }

  #atc_scroll_target .qb-tier-radio {
    box-sizing: border-box;
    flex: 0 0 18px;
    display: inline-flex;
    width: 18px;
    height: 18px;
    align-items: center;
    justify-content: center;
    border: 2px solid #d1d5db;
    border-radius: 50%;
    background: #fff;
  }

  #atc_scroll_target .qb-tier-radio--selected {
    border-color: var(--qb-active);
  }

  #atc_scroll_target .qb-tier-radio__inner {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--qb-active);
  }

  /* Active states. Unscoped because the picker modal is teleported to <body>. */
  :root {
    --qb-active: #22613a;
  }

  .mgx-selected {
    border-color: var(--qb-active);
  }

  .mgx-bg-silver-tint {
    background-color: rgba(34, 97, 58, 0.06);
  }

  .mgx-text-accent {
    color: var(--qb-active);
  }

  .mgx-pill {
    background: #fff;
    border-color: #e5e7eb;
    color: #111;
  }

  .mgx-pill-active {
    background: var(--qb-active);
    border-color: var(--qb-active);
    color: #fff;
  }

  .mgx-hover-selected:hover,
  .mgx-input:focus {
    border-color: var(--qb-active);
  }

  .mgx-badge-sale {
    background-color: #c8202f;
    color: #fff;
  }

  .mgx-btn-primary:not(.atc-button) {
    background-color: var(--qb-active);
    color: #fff;
  }
</style>

{% unless product.available %}
  {% render 'sold-out-alternative', product: product %}
{% else %}

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<div
  id="atc_scroll_target"
  x-data
  x-effect="$store.qb.currentPrice; $store.qb.currentCompare; $store.qb.syncGlobalPrices()">

  {% if product.variants.size > 1 %}
    <div class="flex justify-between items-center mb-3 !mt-6">
      <h2 class="m-0 text-sm md:text-base font-semibold">
        Välj storlek:
      </h2>
      <div class="text-xs md:text-sm italic text-gray-500">
        80 % av våra kunder köper 50 ml eller mer
      </div>
    </div>

    <div class="grid grid-cols-3 gap-3" id="variant-selector">
      {% for variant in product.variants reversed %}
        {% liquid
          assign variant_ml = 0
          if variant.title contains '100'
            assign variant_ml = 100
          elsif variant.title contains '50'
            assign variant_ml = 50
          elsif variant.title contains '30'
            assign variant_ml = 30
          endif

          if variant_ml > 0
            assign price_per_ml = variant.price | times: 1.0 | divided_by: variant_ml
          endif

          assign size_key = variant.title | downcase | remove: ' '
        %}

        <button
          type="button"
          @click="$store.qb.selectSize('{{ size_key }}')"
          class="variant-button rounded-lg px-3 py-2.5 bg-white border-2 border-solid cursor-pointer relative"
          :class="$store.qb.selectedSize === '{{ size_key }}' ? 'mgx-selected' : 'border-gray-200'"
          data-variant-id="{{ variant.id }}"
          data-variant-title="{{ variant.title }}"
          data-original-price="{{ variant.price | money }}"
          data-compare-price="{{ variant.compare_at_price | money }}">

          <div class="text-center leading-tight">
            <div class="text-sm font-semibold">
              {{ variant.title }}
            </div>

            {% if variant_ml > 0 %}
              <div
                class="text-[11px] text-gray-500 mt-0.5"
                x-text="$store.qb.money({{ price_per_ml }}) + ' / ml'">
              </div>
            {% endif %}
          </div>

          {% if variant.title contains '50' %}
            <span class="text-[10px] italic text-white rounded absolute -top-[10px] left-1/2 [transform:translateX(-50%)] bg-[#c8202f] px-2 py-0.5 whitespace-nowrap">
              Mest Populär
            </span>
          {% endif %}

          {% if variant.title contains '100' %}
            <span class="text-[10px] italic text-white rounded absolute -top-[10px] left-1/2 [transform:translateX(-50%)] bg-[#22613a] px-2 py-0.5 whitespace-nowrap">
              Bäst värde
            </span>
          {% endif %}

        </button>
      {% endfor %}
    </div>
  {% endif %}

  <h2 class="m-0 text-sm md:text-base font-semibold !mt-4 mb-2">
    Välj antal &amp; spara:
  </h2>

  <div class="flex flex-col gap-3">
    <template x-for="tier in $store.qb.tiers" :key="tier.key">

      <div
        class="qb-tier-card rounded-xl border-2 border-solid relative transition-colors duration-200"
        :class="$store.qb.selectedTierKey === tier.key ? 'mgx-selected mgx-bg-silver-tint shadow-sm' : 'border-gray-200 bg-white'">

        <div
          @click="$store.qb.selectTier(tier.key)"
          class="px-3 py-2.5 cursor-pointer flex items-center gap-2.5">

          <span
            class="qb-tier-radio"
            :class="{ 'qb-tier-radio--selected': $store.qb.selectedTierKey === tier.key }"
            aria-hidden="true">

            <span
              x-show="$store.qb.selectedTierKey === tier.key"
              x-cloak
              class="qb-tier-radio__inner">
            </span>
          </span>

          <span class="grow min-w-0">
            <span class="flex items-center gap-1.5 flex-wrap">
              <span
                class="text-sm font-bold text-black"
                x-text="tier.label">
              </span>

              <span
                x-show="$store.qb.savingsPercent(tier) > 0"
                x-cloak
                class="rounded mgx-badge-sale text-[11px] font-bold px-1.5 py-0.5 leading-none"
                x-text="'−' + $store.qb.savingsPercent(tier) + '%'">
              </span>
            </span>

            <span
              class="block text-[11px] text-gray-500 mt-0.5 font-bold"
              x-show="tier.total > 1 || tier.note"
              x-text="tier.total > 1 ? $store.qb.money($store.qb.perBottle(tier)) + ' / flaska' : tier.note">
            </span>
          </span>

          <span class="shrink-0 text-right leading-tight">
            <span
              class="block text-base font-extrabold text-black"
              x-text="$store.qb.money($store.qb.tierPrice(tier))">
            </span>

            <span
              class="block text-xs text-gray-400 line-through"
              x-show="$store.qb.tierCompare(tier) > $store.qb.tierPrice(tier)"
              x-text="$store.qb.money($store.qb.tierCompare(tier))">
            </span>
          </span>
        </div>

        <span
          x-show="tier.badge"
          x-text="tier.badge"
          x-cloak
          :style="{ '--qb-badge-c': tier.badgeColor }"
          class="absolute -top-2.5 right-4 bg-[color:var(--qb-badge-c)] text-white text-[10px] font-bold px-2 py-0.5 shadow-sm">
        </span>

        <div
          x-show="$store.qb.selectedTierKey === tier.key"
          x-cloak
          class="mx-3 border-0 border-t border-solid border-black/10 pt-2 pb-2.5 flex flex-col gap-2">

          <p
            x-show="tier.total > 1"
            class="m-0 text-[11px] font-semibold text-gray-500">

            <span x-text="tier.total"></span>
            dofter i paketet —

            <span
              x-show="$store.qb.remaining > 0"
              x-text="'välj ' + $store.qb.remaining + ' till'">
            </span>

            <span
              x-show="$store.qb.remaining === 0"
              class="mgx-text-accent">
              klart ✓
            </span>
          </p>

          <template x-for="(slot, i) in $store.qb.picks" :key="i">
            <div class="flex items-center gap-2.5">

              <div class="relative shrink-0">
                <template x-if="slot">
                  <img
                    :src="slot.image"
                    :alt="slot.name"
                    width="44"
                    height="44"
                    class="size-11 rounded-lg object-cover bg-white border border-solid border-black/10">
                </template>

                <template x-if="!slot">
                  <div class="size-11 rounded-lg bg-white border border-dashed border-solid border-black/25 flex items-center justify-center text-gray-300">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                      <path d="M12 5v14M5 12h14"></path>
                    </svg>
                  </div>
                </template>
              </div>

              <div class="grow min-w-0">
                <template x-if="slot">
                  <div>
                    <div
                      class="text-[13px] font-bold text-black line-clamp-1"
                      x-text="slot.name">
                    </div>

                    <div
                      class="text-[11px] text-gray-500 line-clamp-1"
                      x-show="slot.inspiration_name"
                      x-text="'Inspirerad av ' + slot.inspiration_name">
                    </div>

                    <div
                      x-show="i === 0 && slot.id === $store.qb.mainProduct.id"
                      class="text-[11px] font-semibold mgx-text-accent">
                      Förvald
                    </div>
                  </div>
                </template>

                <template x-if="!slot">
                  <div class="text-[13px] font-semibold text-gray-500">
                    Välj doft
                  </div>
                </template>
              </div>

              <button
                type="button"
                @click="$store.qb.openModal(i)"
                class="shrink-0 rounded-lg text-[11px] font-semibold px-3 py-1.5 cursor-pointer border border-solid transition-colors"
                :class="slot ? 'bg-white text-black border-gray-300 hover:border-black' : 'bg-black text-white border-black hover:bg-gray-800'"
                x-text="slot ? 'Ändra' : 'Välj'">
              </button>

            </div>
          </template>

        </div>
      </div>
    </template>
  </div>

  <product-form
    @submit.capture="$store.qb.prepareSubmit($event)"
    class="product-form !mb-0 block"
    data-hide-errors="{{ gift_card_recipient_feature_active }}"
    data-section-id="{{ section.id }}">

    <div class="product-form__error-message-wrapper" role="alert" hidden>
      <span class="product-form__error-message"></span>
    </div>

    {%- form 'product',
      product,
      id: product_form_id,
      class: 'form',
      novalidate: 'novalidate',
      data-type: 'add-to-cart-form'
    -%}

      <input
        type="hidden"
        name="id"
        id="product-variant-id"
        value="{{ selected_variant.id }}"
        :value="$store.qb.selectedVariantId"
        class="product-variant-id">

      <template x-for="(p, idx) in $store.qb.picks.filter(Boolean)" :key="idx">
        <span>
          <input
            type="hidden"
            :name="'items[' + idx + '][id]'"
            :value="p.variant.id">

          <input
            type="hidden"
            :name="'items[' + idx + '][quantity]'"
            value="1">

          <input
            type="hidden"
            :name="'items[' + idx + '][properties][Paket-Duft]'"
            :value="p.name"
            :disabled="$store.qb.selectedTier.total === 1">
        </span>
      </template>

      <button
        type="submit"
        name="add"
        value="1"
        class="atc-button shimmer-btn cta_product_from_submit_btn flex gap-2 flex-wrap items-center !mb-0 !py-4 !px-3 rounded-lg button bg-[#22613a] hover:bg-[#368856] transition-colors shadow-xl tracking-normal button--full-width button--primary"
        aria-label="{{ 'products.product.add_to_cart' | t }}"
        {% if product.metafields.custom.bundle_size != blank %}
        disabled="disabled"
        {% endif %}
        {%- unless selected_variant.available %}
        disabled="disabled"
        data-sold-out{% endunless %}>
        <span class="text-[20px] md:text-[24px]">
          {% if selected_variant.available %}
            {{ 'products.product.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}{% endif %}
        </span>
        {%- render 'loading-spinner' -%}
      </button>

    {%- endform -%}
  </product-form>

  <template x-teleport="body">
    <div
      x-show="$store.qb.showModal"
      x-cloak
      class="fixed inset-0 bg-black bg-opacity-50 flex items-end md:items-center justify-center z-[9999]">

      <div
        class="bg-white rounded-3xl pb-3 max-w-xl w-full h-[80vh] md:h-[90vh] flex flex-col relative"
        @click.away="$store.qb.showModal = false">

        <button
          @click="$store.qb.showModal = false"
          class="absolute -top-10 right-2 md:top-2 md:right-2 w-8 h-8 bg-gray-100 text-black mgx-close rounded-full flex items-center justify-center border-0 text-2xl cursor-pointer transition">
          <span class="[rotate:45deg] leading-none">+</span>
        </button>

        <div class="flex-shrink-0">
          <div class="p-3 pt-5 border-0 border-b border-solid border-gray-200">
            <h2 class="text-lg font-bold text-gray-900 my-0 text-center tracking-normal">
              <span x-show="$store.qb.remaining === 0">
                Urvalet är klart!
              </span>
              <span x-show="$store.qb.remaining > 0">
                Välj
                <span x-text="$store.qb.remaining"></span>
                <span x-show="$store.qb.remaining === 1">doft till</span>
                <span x-show="$store.qb.remaining > 1">dofter till</span>
              </span>
            </h2>

            <p class="my-0 text-center text-sm text-[#6b7280]">
              <span x-text="$store.qb.selectedTier.total"></span>
              dofter i paketet · storlek
              <span x-text="$store.qb.selectedSizeLabel"></span>
            </p>
          </div>

          <div class="px-3 py-2">
            <div class="flex gap-1.5">
              <button
                @click="$store.qb.activeCategory = 'All'"
                :class="$store.qb.activeCategory === 'All' ? 'mgx-pill-active' : 'mgx-pill'"
                class="px-2 py-1.5 rounded-full font-semibold border-2 border-solid cursor-pointer mgx-hover-selected">
                Bästsäljare
              </button>

              <button
                @click="$store.qb.activeCategory = 'fuer-maenner'"
                :class="$store.qb.activeCategory === 'fuer-maenner' ? 'mgx-pill-active' : 'mgx-pill'"
                class="px-2 py-1.5 rounded-full font-semibold border-2 border-solid cursor-pointer mgx-hover-selected">
                Herr
              </button>

              <button
                @click="$store.qb.activeCategory = 'fuer-frauen'"
                :class="$store.qb.activeCategory === 'fuer-frauen' ? 'mgx-pill-active' : 'mgx-pill'"
                class="px-2 py-1.5 rounded-full font-semibold border-2 border-solid cursor-pointer mgx-hover-selected">
                Dam
              </button>
            </div>
          </div>

          <div class="px-3 pb-3">
            <div class="relative">
              <div class="absolute top-[7px] left-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="M21 21l-4.3-4.3"></path>
                </svg>
              </div>

              <input
                type="text"
                placeholder="Sök..."
                x-model="$store.qb.searchText"
                class="block w-full p-2 pl-8 rounded-xl border-2 border-solid cursor-pointer bg-white border-gray-200 focus:outline-none mgx-input focus:shadow-none focus:border-2">
            </div>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto p-3 pt-0">
          <div class="flex flex-col gap-1.5">
            <template x-for="product in $store.qb.availableProducts" :key="product.id">
              <template
                x-if="$store.qb.inStock(product) &&
                  (product.tags.some(tag => tag === $store.qb.activeCategory) || $store.qb.activeCategory === 'All') &&
                  ($store.qb.searchText === '' || product.name.toLowerCase().includes($store.qb.searchText.toLowerCase()) || (product.inspiration_name && product.inspiration_name.toLowerCase().includes($store.qb.searchText.toLowerCase())))">

                <div
                  @click="$store.qb.countOf(product.id) || $store.qb.pickProduct(product)"
                  :class="$store.qb.countOf(product.id) ? 'mgx-selected' : 'border-gray-200 border'"
                  class="border-[1.5px] border-solid w-full p-2 flex items-center gap-2 justify-between cursor-pointer rounded-xl bg-white">

                  <img
                    class="object-cover rounded-lg"
                    :src="product.image"
                    :alt="product.name"
                    width="56"
                    height="56">

                  <div class="text-left flex flex-col gap-1 mr-auto min-w-0">
                    <div class="flex items-center gap-1.5">
                      <h3
                        class="my-0 font-bold text-base leading-tight text-black line-clamp-1"
                        x-text="product.name">
                      </h3>

                      <span
                        x-show="product.tags.some(tag => tag.toLowerCase() === 'bestseller')"
                        class="shrink-0 px-2 py-0.5 rounded-full bg-[#22613a] text-white text-[10px] font-semibold leading-tight">
                        Bästsäljare
                      </span>
                    </div>

                    <div class="flex items-center gap-1.5">
                      <span
                        x-show="product.tags.some(tag => tag === 'fuer-maenner')"
                        class="shrink-0 px-2 py-0.5 rounded-full bg-gray-100 text-[#6b7280] text-[10px] font-semibold leading-tight">
                        Herr
                      </span>

                      <span
                        x-show="product.tags.some(tag => tag === 'fuer-frauen')"
                        class="shrink-0 px-2 py-0.5 rounded-full bg-gray-100 text-[#6b7280] text-[10px] font-semibold leading-tight">
                        Dam
                      </span>

                      <span
                        x-show="product.occasion"
                        x-html="product.occasion"
                        class="shrink-0 px-2 py-0.5 rounded-full bg-gray-100 text-[#6b7280] text-[10px] font-semibold leading-tight line-clamp-1">
                      </span>
                    </div>
                  </div>

                  <div class="shrink-0 ml-auto flex flex-col items-end gap-1">
                    <div
                      class="text-xs font-semibold text-[#6b7280]"
                      x-text="$store.qb.selectedSizeLabel">
                    </div>

                    <button
                      x-show="!$store.qb.countOf(product.id)"
                      type="button"
                      @click.stop="$store.qb.pickProduct(product)"
                      :aria-label="'Lägg till ' + product.name"
                      class="size-8 p-0 rounded-full border-[1.5px] border-solid mgx-border-black bg-white flex items-center justify-center text-xl leading-none mgx-text cursor-pointer">
                      +
                    </button>

                    <div
                      x-show="$store.qb.countOf(product.id)"
                      class="flex items-center rounded-full border-[1.5px] border-solid mgx-border-black overflow-hidden">

                      <button
                        type="button"
                        @click.stop="$store.qb.unpickProduct(product)"
                        :aria-label="'Ta bort ' + product.name"
                        class="size-8 p-0 border-0 bg-white flex items-center justify-center text-xl leading-none mgx-text cursor-pointer hover:bg-gray-100">
                        −
                      </button>

                      <span
                        class="min-w-6 text-center text-sm font-bold text-black px-1"
                        aria-live="polite"
                        x-text="$store.qb.countOf(product.id)">
                      </span>

                      <button
                        type="button"
                        @click.stop="$store.qb.pickProduct(product)"
                        :aria-label="'Lägg till ' + product.name"
                        class="size-8 p-0 border-0 mgx-btn-primary flex items-center justify-center text-xl leading-none cursor-pointer">
                        +
                      </button>
                    </div>
                  </div>

                </div>
              </template>
            </template>
          </div>
        </div>

        <div class="flex-shrink-0 px-3 pt-2">
          <button
            @click="$store.qb.showModal = false"
            class="w-full rounded-full mgx-btn-primary border-0 text-lg font-bold py-3 cursor-pointer transition-colors">
            Klar
          </button>
        </div>

      </div>
    </div>
  </template>
</div>

<script>
  document.addEventListener('alpine:init', function () {
    var MONEY = new Intl.NumberFormat({{ request.locale.iso_code | json }}, {
      style: 'currency',
      currency: {{ cart.currency.iso_code | json }}
    });

    Alpine.store('qb', {
      variants: {
        {% for variant in product.variants %}
          "{{ variant.title | downcase | remove: ' ' }}": {
            id: {{ variant.id }},
            label: "{{ variant.title }}",
            price: {{ variant.price }},
            compare: {{ variant.compare_at_price | default: 0 }}
          },
        {% endfor %}
      },

      selectedSize: "{{ selected_size_key }}",
      selectedVariantId: {{ selected_variant.id }},

      tiers: [
        {
          key: 't1',
          label: '1 flaska',
          pay: 1,
          total: 1,
          badge: '',
          badgeColor: '',
          note: 'En flaska att testa med'
        },
        {
          key: 't2',
          label: '2 + 1 GRATIS',
          pay: 2,
          total: 3,
          badge: 'Populär',
          badgeColor: '#c8202f'
        },
        {
          key: 't3',
          label: '4 + 2 GRATIS',
          pay: 4,
          total: 6,
          badge: 'Bästa pris 🔥',
          badgeColor: '#22613a'
        }
      ],

      selectedTierKey: 't1',
      showModal: false,
      activeCategory: 'All',
      searchText: '',
      picks: [],
      activeSlot: 0,

      mainProduct: {
        id: {{ product.id }},
        name: {{ product.title | json }},
        image: "{{ product.featured_image | image_url: width: 120, height: 120 }}",
        inspiration_name: {% if product.metafields.custom.inspiration.value %}{{ product.metafields.custom.inspiration.value.name | json }}{% else %}""{% endif %},
        occasion: {{ product.metafields.custom.occasion | default: '' | json }},
        tags: {{ product.tags | json }},
        variants: {
          {% for variant in product.variants %}
            "{{ variant.title | downcase | remove: ' ' }}": {
              id: {{ variant.id }},
              title: {{ variant.title | json }},
              available: {{ variant.available }}
            },
          {% endfor %}
        }
      },

      availableProducts: [
        {% for bonus_product in bonus_collection.products %}
          {
            id: {{ bonus_product.id }},
            name: {{ bonus_product.title | json }},
            image: "{{ bonus_product.featured_image | image_url: width: 120, height: 120 }}",
            inspiration_name: {% if bonus_product.metafields.custom.inspiration.value %}{{ bonus_product.metafields.custom.inspiration.value.name | json }}{% else %}""{% endif %},
            occasion: {{ bonus_product.metafields.custom.occasion | default: '' | json }},
            tags: {{ bonus_product.tags | json }},
            variants: {
              {% for variant in bonus_product.variants %}
                "{{ variant.title | downcase | remove: ' ' }}": {
                  id: {{ variant.id }},
                  title: {{ variant.title | json }},
                  available: {{ variant.available }}
                },
              {% endfor %}
            }
          },
        {% endfor %}
      ],

      init: function () {
        var mainId = this.mainProduct.id;

        if (!this.availableProducts.some(function (p) {
          return p.id === mainId;
        })) {
          this.availableProducts.unshift(this.mainProduct);
        }

        this.picks = [this.withVariant(this.mainProduct)];
        this.selectTier(this.selectedTierKey);
      },

      get selectedTier() {
        var key = this.selectedTierKey;
        return this.tiers.find(function (t) {
          return t.key === key;
        }) || this.tiers[0];
      },

      get remaining() {
        return this.picks.filter(function (p) {
          return !p;
        }).length;
      },

      get isComplete() {
        return this.remaining === 0;
      },

      get unit() {
        return this.variants[this.selectedSize] ||
          Object.values(this.variants)[0];
      },

      get selectedSizeLabel() {
        return this.unit ? this.unit.label : '';
      },

      get unitCompare() {
        return this.unit.compare > this.unit.price ?
          this.unit.compare : this.unit.price;
      },

      get currentPrice() {
        return this.tierPrice(this.selectedTier);
      },

      get currentCompare() {
        return this.tierCompare(this.selectedTier);
      },

      tierPrice: function (t) {
        return t.pay * this.unit.price;
      },

      tierCompare: function (t) {
        return t.total * this.unitCompare;
      },

      perBottle: function (t) {
        return Math.round(this.tierPrice(t) / t.total);
      },

      // Share of bottles that are free, e.g. 2 + 1 → 33 %.
      savingsPercent: function (t) {
        return Math.round((t.total - t.pay) / t.total * 100);
      },

      money: function (cents) {
        return MONEY.format((cents || 0) / 100);
      },

      selectSize: function (key) {
        if (!this.variants[key]) return;

        this.selectedSize = key;
        this.selectedVariantId = this.variants[key].id;

        var input = document.getElementById('product-variant-id');

        if (input) {
          input.value = this.variants[key].id;
        }

        this.picks = this.picks.map(function (p) {
          if (!p || !p.variants[key]) return p;

          return p.variants[key].available ?
            Object.assign({}, p, { variant: p.variants[key] }) :
            null;
        });
      },

      selectTier: function (key) {
        this.selectedTierKey = key;

        var total = this.selectedTier.total;

        this.picks.splice(total);

        while (this.picks.length < total) {
          this.picks.push(null);
        }
      },

      variantFor: function (product) {
        return product.variants[this.selectedSize] ||
          Object.values(product.variants)[0];
      },

      withVariant: function (product) {
        return Object.assign({}, product, {
          variant: this.variantFor(product)
        });
      },

      inStock: function (product) {
        var v = this.variantFor(product);
        return !!(v && v.available);
      },

      openModal: function (i) {
        this.activeSlot = typeof i === 'number' ?
          i : Math.max(0, this.picks.indexOf(null));

        this.showModal = true;
      },

      countOf: function (id) {
        return this.picks.filter(function (p) {
          return p && p.id === id;
        }).length;
      },

      pickProduct: function (product) {
        this.picks[this.activeSlot] = this.withVariant(product);

        var next = this.picks.indexOf(null);

        if (next === -1) {
          this.showModal = false;
        } else {
          this.activeSlot = next;
        }
      },

      unpickProduct: function (product) {
        for (var i = this.picks.length - 1; i >= 0; i--) {
          if (this.picks[i] && this.picks[i].id === product.id) {
            this.picks[i] = null;
            this.activeSlot = this.picks.indexOf(null);
            return;
          }
        }
      },

      syncGlobalPrices: function () {
        var priceText = this.money(this.currentPrice);
        var compareText = this.money(this.currentCompare);
        var hasCompare = this.currentCompare > this.currentPrice;

        document.querySelectorAll('.current-price').forEach(function (el) {
          el.textContent = priceText;
        });

        document.querySelectorAll('.compare-price').forEach(function (el) {
          el.textContent = compareText;
          el.style.display = hasCompare ? '' : 'none';
        });
      },

      prepareSubmit: function (evt) {
        if (!this.isComplete) {
          evt.preventDefault();
          evt.stopPropagation();
          this.openModal();
          return;
        }

        var idInput = evt.target.querySelector('[name="id"]');

        if (idInput) {
          idInput.disabled = true;
        }
      }
    });
  });
</script>

{% endunless %}

<div>
  <img
    class="max-w-full mx-auto mt-8 block [filter:grayscale(1)]"
    src="{{ 'payment-badge.png' | asset_url }}"
    alt="Payment methods"
    width="100%"
    height="auto"
    loading="lazy">
</div>

{% unless product.template_suffix == 'cro-deck' %}
  <div class="!my-6">
    <p class="my-0 text-center font-semibold tracking-normal">
      Levereras till
      <span class="shipping_location">{{ localization.country.name }}</span>
      inom 5 arbetsdagar.
    </p>
  </div>
{% endunless %}


