
{% liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign selected_variant = product.selected_or_first_available_variant

  for variant in product.variants
    assign variant_title_down = variant.title | downcase

    if variant_title_down contains '100' and variant.available
      assign selected_variant = variant
      break
    endif
  endfor

  assign bonus_collection = collections['best-sellers']
  assign selected_size_key = selected_variant.title | downcase | remove: ' '
%}

<style>
  .rapi-bundle-content-0,
  .rapi-bundle-boosters-afteratc-0 {
    display: none;
  }

  [x-cloak] {
    display: none;
  }

  .qb-error {
    color: #b91c1c;
    font-size: 13px;
    line-height: 1.5;
    margin: 8px 0;
  }

  .qb-atc-button[disabled] {
    cursor: not-allowed;
    opacity: 0.65;
  }

  .qb-atc-button.loading {
    cursor: wait;
    opacity: 0.8;
  }

  .qb-size-unavailable {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>

{% unless product.available %}

  {% render 'sold-out-alternative', product: product %}

{% else %}

<script
  defer
  src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js">
</script>

<div
  id="atc_scroll_target"
  x-data
  x-effect="$store.qb.syncGlobalPrices()">

  {% comment %}
    SIZE SELECTOR
  {% endcomment %}

  {% if product.variants.size > 1 %}

    <div class="flex justify-between items-center mb-3 mt-6">

      <h2 class="m-0 text-sm md:text-base font-semibold">
        Größe auswählen:
      </h2>

      <div class="text-xs md:text-sm italic text-gray-500">
        80 % unserer Kunden kaufen 50 ml oder mehr
      </div>

    </div>

    <div
      class="grid grid-cols-3 gap-3"
      id="variant-selector">

      {% for variant in product.variants reversed %}

        {% liquid
          assign variant_ml = 0

          if variant.title contains '100'
            assign variant_ml = 100
          elsif variant.title contains '50'
            assign variant_ml = 50
          elsif variant.title contains '30'
            assign variant_ml = 30
          endif

          assign price_per_ml = 0

          if variant_ml > 0
            assign price_per_ml = variant.price | times: 1.0 | divided_by: variant_ml
          endif

          assign size_key = variant.title | downcase | remove: ' '
        %}

        <button
          type="button"
          @click="$store.qb.selectSize({{ size_key | json }})"
          class="variant-button rounded-lg px-3 py-2.5 bg-white border-2 border-solid cursor-pointer font-['Plus_Jakarta_Sans'] relative"
          :class="$store.qb.selectedSize === {{ size_key | json }} ? 'mgx-selected' : 'border-gray-200'"
          data-variant-id="{{ variant.id }}"
          data-variant-title="{{ variant.title | escape }}"
          {% unless variant.available %}
            disabled
          {% endunless %}>

          <div class="text-center leading-tight">

            <div class="text-sm font-semibold">
              {{ variant.title }}
            </div>

            {% if variant_ml > 0 %}

              <div class="text-[11px] text-gray-500 mt-0.5">
                {{ price_per_ml | money }} / ml
              </div>

            {% endif %}

            {% unless variant.available %}
              <div class="text-[10px] text-red-500">
                Ausverkauft
              </div>
            {% endunless %}

          </div>

          {% if variant.available %}

            {% if variant.title contains '50' %}
              <span
                class="text-[10px] italic text-white rounded absolute -top-[10px] left-1/2 [transform:translateX(-50%)] mgx-badge-amber px-2 py-0.5 leading-normal">
                Beliebt
              </span>
            {% endif %}

            {% if variant.title contains '100' %}
              <span
                class="text-[10px] italic text-white rounded absolute -top-[10px] left-1/2 [transform:translateX(-50%)] mgx-badge-amber px-2 py-0.5 leading-normal">
                Bestseller
              </span>
            {% endif %}

          {% endif %}

        </button>

      {% endfor %}

    </div>

  {% endif %}


  {% comment %}
    QUANTITY BREAKER
    1 Flasche
    2 + 1 GRATIS
    4 + 2 GRATIS
  {% endcomment %}

  <h2 class="m-0 text-sm md:text-base font-semibold mt-4 mb-2">
    Menge wählen &amp; sparen:
  </h2>

  <div class="flex flex-col gap-3">

    <template
      x-for="tier in $store.qb.tiers"
      :key="tier.key">

      <div
        class="rounded-xl border-2 border-solid font-['Plus_Jakarta_Sans'] relative transition-colors duration-200"
        :class="$store.qb.selectedTierKey === tier.key
          ? 'mgx-selected mgx-bg-silver-tint shadow-sm'
          : 'border-gray-200 bg-white'">

        {% comment %} TIER HEADER {% endcomment %}

        <div
          @click="$store.qb.selectTier(tier.key)"
          @keydown.enter.prevent="$store.qb.selectTier(tier.key)"
          @keydown.space.prevent="$store.qb.selectTier(tier.key)"
          role="button"
          tabindex="0"
          :aria-pressed="$store.qb.selectedTierKey === tier.key"
          class="px-3 py-2.5 cursor-pointer flex items-center gap-2.5">

          {% comment %} RADIO {% endcomment %}

          <span
            class="shrink-0 size-[18px] rounded-full border-2 border-solid flex items-center justify-center transition-colors"
            :class="$store.qb.selectedTierKey === tier.key
              ? 'mgx-selected'
              : 'border-gray-300'">

            <span
              x-show="$store.qb.selectedTierKey === tier.key"
              class="size-2.5 rounded-full mgx-dot">
            </span>

          </span>

          {% comment %} OFFER DETAILS {% endcomment %}

          <span class="grow min-w-0">

            <span class="flex items-center gap-1.5 flex-wrap">

              <span
                class="text-sm font-bold text-black"
                x-text="tier.label">
              </span>

              <span
                x-show="$store.qb.savingsPercent(tier) > 0"
                x-cloak
                class="rounded mgx-badge-sale text-[11px] font-bold px-1.5 py-0.5 leading-none"
                x-text="'−' + $store.qb.savingsPercent(tier) + '%'">
              </span>

            </span>

            <span
              class="block text-[11px] text-gray-500 mt-0.5 font-bold"
              x-text="tier.total === 1
                ? '1 Flasche · Regulärer Preis'
                : tier.total + ' Flaschen · ' +
                  (tier.total - tier.pay) + ' gratis · ' +
                  $store.qb.money($store.qb.perBottle(tier)) +
                  ' / Flasche'">
            </span>

          </span>

          {% comment %} PRICES {% endcomment %}

          <span class="shrink-0 text-right leading-tight">

            <span
              class="block text-base font-extrabold text-black"
              x-text="$store.qb.money($store.qb.tierPrice(tier))">
            </span>

            <span
              class="block text-xs text-gray-400 line-through"
              x-show="$store.qb.tierCompare(tier) > $store.qb.tierPrice(tier)"
              x-text="$store.qb.money($store.qb.tierCompare(tier))">
            </span>

          </span>

        </div>


        {% comment %} OFFER BADGE {% endcomment %}

        <span
          x-show="tier.badge"
          x-cloak
          x-text="tier.badge"
          :style="{ '--qb-badge-c': tier.badgeColor }"
          class="absolute -top-2.5 right-4 bg-[color:var(--qb-badge-c)] text-white text-[10px] leading-normal not-italic font-bold tracking-wide px-2 py-0.5 shadow-sm
            before:content-[''] before:absolute before:right-full before:top-0 before:-z-10 before:border-solid before:border-y-[9px] before:border-y-transparent before:border-r-[7px] before:border-r-[color:var(--qb-badge-c)] before:border-l-0
            after:content-[''] after:absolute after:left-full after:top-0 after:-z-10 after:border-solid after:border-y-[9px] after:border-y-transparent after:border-l-[7px] after:border-l-[color:var(--qb-badge-c)] after:border-r-0">
        </span>


        {% comment %} EXPANDED BUNDLE {% endcomment %}

        <div
          x-show="$store.qb.selectedTierKey === tier.key"
          x-cloak
          class="mx-3 border-0 border-t border-solid border-black/10 pt-2 pb-2.5 flex flex-col gap-2">

          <p
            x-show="tier.total > 1"
            class="m-0 text-[11px] font-semibold text-gray-500">

            <span x-text="tier.total"></span>
            Düfte im Paket —

            <span
              x-show="$store.qb.remaining > 0"
              x-text="'noch ' + $store.qb.remaining + ' wählen'">
            </span>

            <span
              x-show="$store.qb.remaining === 0"
              class="mgx-text-accent">
              komplett ✓
            </span>

          </p>


          {% comment %} FRAGRANCE SLOTS {% endcomment %}

          <template
            x-for="(slot, i) in $store.qb.picks"
            :key="i">

            <div class="flex items-center gap-2.5">

              <div class="relative shrink-0">

                <template x-if="slot">

                  <img
                    :src="slot.image"
                    :alt="slot.name"
                    width="44"
                    height="44"
                    class="size-11 rounded-lg object-cover bg-white border border-solid border-black/10">

                </template>

                <template x-if="!slot">

                  <div
                    class="size-11 rounded-lg bg-white border border-dashed border-black/25 flex items-center justify-center text-gray-300">

                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round">

                      <path d="M12 5v14M5 12h14"></path>

                    </svg>

                  </div>

                </template>

              </div>


              <div class="grow min-w-0">

                <template x-if="slot">

                  <div>

                    <div
                      class="text-[13px] font-bold text-black line-clamp-1"
                      x-text="slot.name">
                    </div>

                    <div
                      class="text-[11px] text-gray-500 line-clamp-1"
                      x-show="slot.inspiration_name"
                      x-text="'Inspiriert von ' + slot.inspiration_name">
                    </div>

                    <div
                      x-show="i === 0 && slot.id === $store.qb.mainProduct.id"
                      class="text-[11px] font-semibold mgx-text-accent">
                      Vorausgewählt
                    </div>

                  </div>

                </template>

                <template x-if="!slot">

                  <div class="text-[13px] font-semibold text-gray-500">
                    Duft wählen
                  </div>

                </template>

              </div>


              <button
                type="button"
                @click="$store.qb.openModal(i)"
                class="shrink-0 rounded-lg text-[11px] font-semibold px-3 py-1.5 cursor-pointer border border-solid transition-colors"
                :class="slot
                  ? 'bg-white text-black border-gray-300 hover:border-black'
                  : 'bg-black text-white border-black hover:bg-gray-800'"
                x-text="slot ? 'Ändern' : 'Auswählen'">
              </button>

            </div>

          </template>

        </div>

      </div>

    </template>

  </div>


  {% comment %}
    AJAX ADD TO CART FORM
    Handles multiple items directly.
    Does not rely on theme product-form.js.
  {% endcomment %}

  <div class="product-form mb-0 block">

    <form
      id="{{ product_form_id }}"
      @submit.prevent="$store.qb.addToCart($event)"
      class="form"
      novalidate>

      <input
        type="hidden"
        name="id"
        :value="$store.qb.selectedVariantId"
        value="{{ selected_variant.id }}">

      <div
        x-show="$store.qb.errorMessage"
        x-cloak
        class="qb-error"
        role="alert"
        x-text="$store.qb.errorMessage">
      </div>

      <button
        type="submit"
        name="add"
        :disabled="$store.qb.loading"
        :aria-disabled="!$store.qb.isComplete || $store.qb.loading"
        :class="{
          'opacity-60 cursor-not-allowed': !$store.qb.isComplete,
          'loading': $store.qb.loading
        }"
        class="qb-atc-button atc-button shimmer-btn cta_product_from_submit_btn flex gap-x-2 flex-wrap items-center justify-center mb-0 text-2xl p-3 rounded-lg button mgx-btn-primary transition-colors shadow-xl tracking-normal button--full-width button--primary"
        aria-label="In den Warenkorb">

        <span
          x-show="$store.qb.loading"
          x-cloak>
          Wird hinzugefügt...
        </span>

        <span
          x-show="!$store.qb.loading && !$store.qb.isComplete"
          x-cloak
          x-text="'Wähle noch ' +
            $store.qb.remaining +
            ($store.qb.remaining === 1 ? ' Duft' : ' Düfte')">
        </span>

        <span
          x-show="!$store.qb.loading && $store.qb.isComplete"
          x-cloak>
          {{ 'products.product.add_to_cart' | t }}
        </span>

      </button>

    </form>

  </div>


  {% comment %}
    FRAGRANCE SELECTION MODAL
  {% endcomment %}

  <template x-teleport="body">

    <div
      x-show="$store.qb.showModal"
      x-cloak
      @keydown.escape.window="$store.qb.showModal = false"
      class="fixed inset-0 bg-black bg-opacity-50 flex items-end md:items-center justify-center z-[9999]">

      <div
        class="bg-white rounded-3xl pb-3 max-w-xl w-full h-[80vh] md:h-[90vh] flex flex-col relative"
        role="dialog"
        aria-modal="true"
        aria-label="Düfte auswählen"
        @click.away="$store.qb.showModal = false">


        {% comment %} CLOSE BUTTON {% endcomment %}

        <button
          type="button"
          @click="$store.qb.showModal = false"
          class="absolute -top-10 right-2 md:top-2 md:right-2 w-8 h-8 bg-gray-100 text-black mgx-close rounded-full flex items-center justify-center border-0 text-2xl cursor-pointer transition"
          aria-label="Schließen">

          <span class="[rotate:45deg] leading-none">+</span>

        </button>


        {% comment %} MODAL HEADER {% endcomment %}

        <div class="flex-shrink-0">

          <div class="p-3 pt-5 border-0 border-b border-solid border-gray-200">

            <h2 class="text-lg font-bold text-gray-900 my-0 text-center tracking-normal">

              <span x-show="$store.qb.remaining === 0">
                Auswahl abgeschlossen!
              </span>

              <span x-show="$store.qb.remaining > 0">

                <span>Wähle noch </span>

                <span x-text="$store.qb.remaining"></span>

                <span x-show="$store.qb.remaining === 1">
                  Duft
                </span>

                <span x-show="$store.qb.remaining > 1">
                  Düfte
                </span>

              </span>

            </h2>

            <p class="my-0 text-center text-sm text-[#6b7280]">

              <span x-text="$store.qb.selectedTier.total"></span>
              Düfte im Paket · Größe

              <span x-text="$store.qb.selectedSizeLabel"></span>

            </p>

          </div>


          {% comment %} CATEGORY FILTER {% endcomment %}

          <div class="px-3 py-2">

            <div class="flex gap-1.5">

              <button
                type="button"
                @click="$store.qb.activeCategory = 'All'"
                :class="$store.qb.activeCategory === 'All' ? 'mgx-pill-active' : 'mgx-pill'"
                class="px-2 py-1.5 rounded-full font-semibold border-2 border-solid cursor-pointer mgx-hover-selected">
                Bestseller
              </button>

              <button
                type="button"
                @click="$store.qb.activeCategory = 'fuer-maenner'"
                :class="$store.qb.activeCategory === 'fuer-maenner' ? 'mgx-pill-active' : 'mgx-pill'"
                class="px-2 py-1.5 rounded-full font-semibold border-2 border-solid cursor-pointer mgx-hover-selected">
                Herren
              </button>

              <button
                type="button"
                @click="$store.qb.activeCategory = 'fuer-frauen'"
                :class="$store.qb.activeCategory === 'fuer-frauen' ? 'mgx-pill-active' : 'mgx-pill'"
                class="px-2 py-1.5 rounded-full font-semibold border-2 border-solid cursor-pointer mgx-hover-selected">
                Damen
              </button>

            </div>

          </div>


          {% comment %} SEARCH {% endcomment %}

          <div class="px-3 pb-3">

            <div class="relative">

              <div class="absolute top-[7px] left-2">

                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round">

                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="M21 21l-4.3-4.3"></path>

                </svg>

              </div>

              <input
                type="text"
                placeholder="Suchen..."
                x-model="$store.qb.searchText"
                class="block w-full p-2 pl-8 rounded-xl border-2 border-solid cursor-pointer bg-white border-gray-200 focus:outline-none mgx-input focus:shadow-none focus:border-2">

            </div>

          </div>

        </div>


        {% comment %} PRODUCT GRID {% endcomment %}

        <div class="flex-1 overflow-y-auto p-3 pt-0">

          <div class="flex flex-col gap-1.5">

            <template
              x-for="product in $store.qb.filteredProducts"
              :key="product.id">

              <div
                @click="$store.qb.countOf(product.id) || $store.qb.pickProduct(product)"
                :class="$store.qb.countOf(product.id) ? 'mgx-selected' : 'border-gray-200 border'"
                class="border-[1.5px] border-solid w-full p-2 flex items-center gap-2 justify-between cursor-pointer rounded-xl bg-white">


                {% comment %} PRODUCT IMAGE {% endcomment %}

                <img
                  class="object-cover rounded-lg"
                  :src="product.image"
                  :alt="product.name"
                  width="56"
                  height="56">


                {% comment %} PRODUCT DETAILS {% endcomment %}

                <div class="text-left flex flex-col gap-1 mr-auto min-w-0">

                  <div class="flex items-center gap-1.5">

                    <h3
                      class="my-0 font-bold text-base leading-tight text-black line-clamp-1"
                      x-text="product.name">
                    </h3>

                    <span
                      x-show="product.tags.some(tag => tag.toLowerCase() === 'bestseller')"
                      class="shrink-0 px-2 py-0.5 rounded-full mgx-badge-amber text-[10px] font-semibold leading-tight">
                      Bestseller
                    </span>

                  </div>

                  <div class="flex items-center gap-1.5">

                    <span
                      x-show="product.tags.includes('fuer-maenner')"
                      class="shrink-0 px-2 py-0.5 rounded-full bg-gray-100 text-[#6b7280] text-[10px] font-semibold leading-tight">
                      Herren
                    </span>

                    <span
                      x-show="product.tags.includes('fuer-frauen')"
                      class="shrink-0 px-2 py-0.5 rounded-full bg-gray-100 text-[#6b7280] text-[10px] font-semibold leading-tight">
                      Damen
                    </span>

                    <span
                      x-show="product.occasion"
                      x-text="product.occasion"
                      class="shrink-0 px-2 py-0.5 rounded-full bg-gray-100 text-[#6b7280] text-[10px] font-semibold leading-tight line-clamp-1">
                    </span>

                  </div>

                </div>


                {% comment %} PRODUCT CONTROLS {% endcomment %}

                <div class="shrink-0 ml-auto flex flex-col items-end gap-1">

                  <div
                    class="text-xs font-semibold text-[#6b7280]"
                    x-text="$store.qb.selectedSizeLabel">
                  </div>

                  <button
                    x-show="!$store.qb.countOf(product.id)"
                    type="button"
                    @click.stop="$store.qb.pickProduct(product)"
                    :aria-label="product.name + ' hinzufügen'"
                    class="size-8 p-0 rounded-full border-[1.5px] border-solid mgx-border-black bg-white flex items-center justify-center text-xl leading-none mgx-text cursor-pointer">
                    +
                  </button>

                  <div
                    x-show="$store.qb.countOf(product.id)"
                    class="flex items-center rounded-full border-[1.5px] border-solid mgx-border-black overflow-hidden">

                    <button
                      type="button"
                      @click.stop="$store.qb.unpickProduct(product)"
                      :aria-label="product.name + ' entfernen'"
                      class="size-8 p-0 border-0 bg-white flex items-center justify-center text-xl leading-none mgx-text cursor-pointer hover:bg-gray-100">
                      −
                    </button>

                    <span
                      class="min-w-6 text-center text-sm font-bold text-black px-1"
                      aria-live="polite"
                      x-text="$store.qb.countOf(product.id)">
                    </span>

                    <button
                      type="button"
                      @click.stop="$store.qb.pickProduct(product)"
                      :aria-label="product.name + ' hinzufügen'"
                      class="size-8 p-0 border-0 mgx-btn-primary flex items-center justify-center text-xl leading-none cursor-pointer">
                      +
                    </button>

                  </div>

                </div>

              </div>

            </template>

          </div>

        </div>


        {% comment %} MODAL FOOTER {% endcomment %}

        <div class="flex-shrink-0 px-3 pt-2">

          <button
            type="button"
            @click="$store.qb.showModal = false"
            class="w-full rounded-full mgx-btn-primary border-0 text-lg font-bold py-3 cursor-pointer transition-colors">
            Fertig
          </button>

        </div>

      </div>

    </div>

  </template>

</div>


{% comment %}
  ALPINE STORE
  Pricing, bundle selection, AJAX cart.
{% endcomment %}

<script>
document.addEventListener('alpine:init', function () {

  if (Alpine.store('qb')) return;

  const MONEY = new Intl.NumberFormat('de-DE', {
    style: 'currency',
    currency: {{ shop.currency | json }}
  });

  const CART_ROOT =
    window.Shopify &&
    window.Shopify.routes &&
    window.Shopify.routes.root
      ? window.Shopify.routes.root
      : '/';

  Alpine.store('qb', {

    {% comment %} MAIN PRODUCT VARIANTS {% endcomment %}

    variants: {
      {% for variant in product.variants %}
        {{ variant.title | downcase | remove: ' ' | json }}: {
          id: {{ variant.id }},
          label: {{ variant.title | json }},
          price: {{ variant.price }},
          compare: {{ variant.compare_at_price | default: 0 }},
          available: {{ variant.available }}
        },
      {% endfor %}
    },

    selectedSize: {{ selected_size_key | json }},
    selectedVariantId: {{ selected_variant.id }},


    {% comment %}
      QUANTITY BREAKER OFFERS

      Single: 1 bottle, pay 1
      2+1: 3 bottles, pay 2
      4+2: 6 bottles, pay 4
    {% endcomment %}

    tiers: [
      {
        key: 't1',
        label: '1 Flasche',
        pay: 1,
        total: 1,
        badge: '',
        badgeColor: '',
        note: 'Regulärer Preis'
      },
      {
        key: 't2',
        label: '2 + 1 GRATIS',
        pay: 2,
        total: 3,
        badge: 'Beliebt',
        badgeColor: '#184031'
      },
      {
        key: 't3',
        label: '4 + 2 GRATIS',
        pay: 4,
        total: 6,
        badge: 'Bester Preis 🔥',
        badgeColor: '#184031'
      }
    ],

    selectedTierKey: 't1',

    showModal: false,
    activeCategory: 'All',
    searchText: '',
    loading: false,
    errorMessage: '',

    picks: [],
    activeSlot: 0,


    {% comment %} MAIN PRODUCT {% endcomment %}

    mainProduct: {
      id: {{ product.id }},
      name: {{ product.title | json }},
      image: {{ product.featured_image | image_url: width: 120, height: 120 | json }},

      inspiration_name:
        {% if product.metafields.custom.inspiration.value %}
          {{ product.metafields.custom.inspiration.value.name | json }}
        {% else %}
          ""
        {% endif %},

      occasion: {{ product.metafields.custom.occasion | default: '' | json }},
      tags: {{ product.tags | json }},

      variants: {
        {% for variant in product.variants %}
          {{ variant.title | downcase | remove: ' ' | json }}: {
            id: {{ variant.id }},
            title: {{ variant.title | json }},
            price: {{ variant.price }},
            available: {{ variant.available }}
          },
        {% endfor %}
      }
    },


    {% comment %} AVAILABLE BUNDLE PRODUCTS {% endcomment %}

    availableProducts: [
      {% for bonus_product in bonus_collection.products %}

        {
          id: {{ bonus_product.id }},
          name: {{ bonus_product.title | json }},
          image: {{ bonus_product.featured_image | image_url: width: 120, height: 120 | json }},

          inspiration_name:
            {% if bonus_product.metafields.custom.inspiration.value %}
              {{ bonus_product.metafields.custom.inspiration.value.name | json }}
            {% else %}
              ""
            {% endif %},

          occasion: {{ bonus_product.metafields.custom.occasion | default: '' | json }},
          tags: {{ bonus_product.tags | json }},

          variants: {
            {% for variant in bonus_product.variants %}
              {{ variant.title | downcase | remove: ' ' | json }}: {
                id: {{ variant.id }},
                title: {{ variant.title | json }},
                price: {{ variant.price }},
                available: {{ variant.available }}
              },
            {% endfor %}
          }
        },

      {% endfor %}
    ],


    {% comment %} INITIALIZATION {% endcomment %}

    init: function () {

      const mainId = this.mainProduct.id;

      if (!this.availableProducts.some(function (p) {
        return p.id === mainId;
      })) {
        this.availableProducts.unshift(this.mainProduct);
      }

      this.picks = [
        this.withVariant(this.mainProduct)
      ];

      this.selectTier(this.selectedTierKey);
    },


    {% comment %} GETTERS {% endcomment %}

    get selectedTier() {
      return this.tiers.find(
        t => t.key === this.selectedTierKey
      ) || this.tiers[0];
    },

    get remaining() {
      return this.picks.filter(p => !p).length;
    },

    get isComplete() {
      return (
        this.picks.length === this.selectedTier.total &&
        this.remaining === 0 &&
        this.picks.every(p => {
          return p &&
            p.variant &&
            p.variant.available;
        })
      );
    },

    get unit() {
      return this.variants[this.selectedSize] ||
        Object.values(this.variants)[0];
    },

    get selectedSizeLabel() {
      return this.unit ? this.unit.label : '';
    },

    get unitCompare() {
      if (!this.unit) return 0;

      return Math.max(
        this.unit.price,
        this.unit.compare || 0
      );
    },

    get currentPrice() {
      return this.tierPrice(this.selectedTier);
    },

    get currentCompare() {
      return this.tierCompare(this.selectedTier);
    },


    {% comment %} FILTERED PRODUCTS {% endcomment %}

    get filteredProducts() {

      const category = this.activeCategory;
      const search = this.searchText.toLowerCase().trim();

      return this.availableProducts.filter(product => {

        if (!this.inStock(product)) {
          return false;
        }

        const tags = product.tags || [];

        const categoryMatches =
          category === 'All' ||
          tags.includes(category);

        if (!categoryMatches) {
          return false;
        }

        if (!search) {
          return true;
        }

        const name = (product.name || '').toLowerCase();

        const inspiration =
          (product.inspiration_name || '').toLowerCase();

        return (
          name.includes(search) ||
          inspiration.includes(search)
        );
      });
    },


    {% comment %}
      BUNDLE PRICING

      For equal-price fragrances:
      2+1 = pay 2 / receive 3
      4+2 = pay 4 / receive 6

      If all slots are selected, use their actual
      prices and treat the cheapest bottles as free.

      Final checkout pricing is controlled by Shopify.
    {% endcomment %}

    tierPrices: function (tier) {

      const selected = this.selectedTierKey === tier.key
        ? this.picks.filter(Boolean)
        : [];

      const prices = [];

      for (let i = 0; i < tier.total; i++) {
        const pick = selected[i];

        if (
          pick &&
          pick.variant &&
          typeof pick.variant.price === 'number'
        ) {
          prices.push(pick.variant.price);
        } else {
          prices.push(this.unit ? this.unit.price : 0);
        }
      }

      const fullPrice = prices.reduce(
        (sum, price) => sum + price,
        0
      );

      const freeCount = tier.total - tier.pay;

      const sortedPrices = prices.slice().sort(
        (a, b) => a - b
      );

      const freeValue = sortedPrices
        .slice(0, freeCount)
        .reduce((sum, price) => sum + price, 0);

      return {
        price: fullPrice - freeValue,
        compare: fullPrice
      };
    },

    tierPrice: function (tier) {
      return this.tierPrices(tier).price;
    },

    tierCompare: function (tier) {

      if (tier.total === 1) {
        return this.unitCompare;
      }

      return this.tierPrices(tier).compare;
    },

    perBottle: function (tier) {

      if (!tier.total) return 0;

      return Math.round(
        this.tierPrice(tier) / tier.total
      );
    },

    savingsPercent: function (tier) {

      if (tier.total === 1) return 0;

      const full = this.tierCompare(tier);
      const price = this.tierPrice(tier);

      if (full <= 0 || price >= full) return 0;

      return Math.round(
        ((full - price) / full) * 100
      );
    },

    money: function (cents) {
      return MONEY.format((cents || 0) / 100);
    },


    {% comment %} SELECT SIZE {% endcomment %}

    selectSize: function (key) {

      if (
        !this.variants[key] ||
        !this.variants[key].available ||
        this.loading
      ) {
        return;
      }

      this.selectedSize = key;
      this.selectedVariantId = this.variants[key].id;

      this.errorMessage = '';

      this.picks = this.picks.map(function (p) {

        if (!p) return null;

        const variant = p.variants[key];

        if (!variant || !variant.available) {
          return null;
        }

        return Object.assign({}, p, {
          variant: variant
        });
      });

      this.activeSlot = Math.max(
        0,
        this.picks.indexOf(null)
      );
    },


    {% comment %} SELECT TIER {% endcomment %}

    selectTier: function (key) {

      if (this.loading) return;

      const tier = this.tiers.find(
        t => t.key === key
      );

      if (!tier) return;

      this.selectedTierKey = key;
      this.errorMessage = '';

      const newPicks = this.picks.slice(
        0,
        tier.total
      );

      while (newPicks.length < tier.total) {
        newPicks.push(null);
      }

      this.picks = newPicks;

      this.activeSlot = Math.max(
        0,
        this.picks.indexOf(null)
      );
    },


    {% comment %} VARIANT HELPERS {% endcomment %}

    variantFor: function (product) {

      if (!product || !product.variants) {
        return null;
      }

      return product.variants[this.selectedSize] || null;
    },

    withVariant: function (product) {

      return Object.assign({}, product, {
        variant: this.variantFor(product)
      });
    },

    inStock: function (product) {

      const variant = this.variantFor(product);

      return !!(
        variant &&
        variant.available
      );
    },


    {% comment %} MODAL {% endcomment %}

    openModal: function (index) {

      if (this.loading) return;

      if (
        typeof index === 'number' &&
        index >= 0 &&
        index < this.picks.length
      ) {
        this.activeSlot = index;
      } else {

        const emptyIndex = this.picks.indexOf(null);

        this.activeSlot = emptyIndex >= 0
          ? emptyIndex
          : 0;
      }

      this.showModal = true;
    },


    {% comment %} COUNT SELECTED PRODUCTS {% endcomment %}

    countOf: function (id) {

      return this.picks.filter(function (p) {
        return p && p.id === id;
      }).length;
    },


    {% comment %} SELECT PRODUCT {% endcomment %}

    pickProduct: function (product) {

      if (!this.inStock(product)) return;

      let index = this.activeSlot;

      if (
        index < 0 ||
        index >= this.picks.length
      ) {
        index = this.picks.indexOf(null);
      }

      if (index < 0) {
        return;
      }

      const updatedPicks = this.picks.slice();

      updatedPicks[index] = this.withVariant(product);

      this.picks = updatedPicks;

      const nextIndex = this.picks.indexOf(null);

      if (nextIndex === -1) {
        this.showModal = false;
      } else {
        this.activeSlot = nextIndex;
      }

      this.errorMessage = '';
    },


    {% comment %} REMOVE PRODUCT {% endcomment %}

    unpickProduct: function (product) {

      const updatedPicks = this.picks.slice();

      for (let i = updatedPicks.length - 1; i >= 0; i--) {

        if (
          updatedPicks[i] &&
          updatedPicks[i].id === product.id
        ) {

          updatedPicks[i] = null;
          this.picks = updatedPicks;
          this.activeSlot = i;

          return;
        }
      }
    },


    {% comment %}
      UPDATE PRODUCT PRICES OUTSIDE BREAKER
    {% endcomment %}

    syncGlobalPrices: function () {

      const priceText = this.money(this.currentPrice);
      const compareText = this.money(this.currentCompare);

      const hasCompare =
        this.currentCompare > this.currentPrice;

      document.querySelectorAll('.current-price').forEach(
        function (el) {
          el.textContent = priceText;
        }
      );

      document.querySelectorAll('.compare-price').forEach(
        function (el) {
          el.textContent = compareText;
          el.style.display = hasCompare ? '' : 'none';
        }
      );
    },


    {% comment %}
      PREPARE AJAX CART ITEMS

      Group identical selected variants by ID.
      Six selected bottles remain six units,
      even when the customer selects duplicates.
    {% endcomment %}

    buildCartItems: function () {

      const grouped = new Map();

      const tier = this.selectedTier;

      this.picks.forEach(function (product) {

        if (
          !product ||
          !product.variant ||
          !product.variant.id
        ) {
          return;
        }

        const variantId = product.variant.id;

        if (grouped.has(variantId)) {

          grouped.get(variantId).quantity += 1;

        } else {

          const item = {
            id: variantId,
            quantity: 1
          };

          if (tier.total > 1) {
            item.properties = {
              'Paket-Duft': product.name
            };
          }

          grouped.set(variantId, item);
        }

      });

      return Array.from(grouped.values());
    },


    {% comment %}
      AJAX ADD TO CART

      Adds all selected variants in one request.
      Compatible cart drawer is refreshed if found.
      Otherwise redirects to the cart page.
    {% endcomment %}

    addToCart: async function (event) {

      if (this.loading) return;

      this.errorMessage = '';

      if (!this.isComplete) {

        this.errorMessage =
          'Bitte wähle zuerst alle Düfte aus.';

        this.openModal();

        return;
      }

      const items = this.buildCartItems();

      const totalQuantity = items.reduce(
        (sum, item) => sum + item.quantity,
        0
      );

      if (
        !items.length ||
        totalQuantity !== this.selectedTier.total
      ) {

        this.errorMessage =
          'Deine Duftauswahl ist unvollständig.';

        return;
      }

      this.loading = true;

      const cartDrawer =
        document.querySelector('cart-drawer');

      const cartNotification =
        document.querySelector('cart-notification');

      const cartUI = (
        cartDrawer &&
        typeof cartDrawer.getSectionsToRender === 'function' &&
        typeof cartDrawer.renderContents === 'function'
      )
        ? cartDrawer
        : (
            cartNotification &&
            typeof cartNotification.getSectionsToRender === 'function' &&
            typeof cartNotification.renderContents === 'function'
          )
            ? cartNotification
            : null;

      const payload = {
        items: items
      };

      if (cartUI) {

        try {

          const sections = cartUI
            .getSectionsToRender()
            .map(section => section.id)
            .filter(Boolean);

          if (sections.length) {
            payload.sections = sections.slice(0, 5);
          }

        } catch (error) {
          console.warn(
            'Bundle: cart section lookup failed',
            error
          );
        }
      }

      try {

        const response = await fetch(
          CART_ROOT + 'cart/add.js',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify(payload)
          }
        );

        const result = await response.json();

        if (!response.ok) {

          throw new Error(
            result.description ||
            result.message ||
            'Produkte konnten nicht hinzugefügt werden.'
          );
        }

        this.showModal = false;

        {% comment %}
          Refresh compatible Dawn-style cart drawer.
          If unavailable or unsuccessful, go to cart.
        {% endcomment %}

        if (
          cartUI &&
          result.sections &&
          typeof cartUI.renderContents === 'function'
        ) {

          const hasSections = Object.values(
            result.sections
          ).some(html => typeof html === 'string' && html.length > 0);

          if (hasSections) {

            try {

              cartUI.classList.remove('is-empty');

              cartUI.renderContents(result);

              this.loading = false;

              return;

            } catch (drawerError) {

              console.warn(
                'Bundle: cart drawer refresh failed',
                drawerError
              );
            }
          }
        }

        window.location.href = CART_ROOT + 'cart';

      } catch (error) {

        console.error(
          'Bundle add-to-cart error:',
          error
        );

        this.errorMessage =
          error.message ||
          'Es ist ein Fehler aufgetreten. Bitte versuche es erneut.';

        this.loading = false;
      }
    }

  });

});
</script>

{% endunless %}


