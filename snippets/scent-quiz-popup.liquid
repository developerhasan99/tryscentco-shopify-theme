          <span id="sq-toastMsg"></span>
        </div>
      </section>

      <!-- ============ RESULTS ============ -->
      <section id="sq-results" class="screen">
        <div class="res-head">
          <span class="kicker">Din doftmatchning</span>
          <h1 id="sq-resTitle">Ditt doftboard</h1>
          <p id="sq-resSub">Här är dofterna du älskade. Tryck på en för att shoppa den.</p>
          <span class="res-save">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M20 12V8H6a2 2 0 0 1 0-4h12v4" /><path d="M4 6v12a2 2 0 0 0 2 2h14v-4" /><path d="M18 12a2 2 0 0 0 0 4h4v-4Z" /></svg>Sex 50 ml-flaskor för mindre än en designerparfym</span>
        </div>

        <div class="board-title">
          <h2>Dina sparade dofter</h2>
          <span class="cnt" id="sq-boardCnt"></span>
        </div>
        <div class="board" id="sq-board"></div>

        <div class="res-trust">
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>Upp till 21 % parfymolja</span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>Håller 12+ timmar</span>
          <span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>Vegansk &amp; cruelty-free</span>
        </div>

        <div class="lead-card" id="sq-leadCard">
          <div class="lc-top">
            <div class="gift">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><rect
                  x="2"
                  y="4"
                  width="20"
                  height="16"
                  rx="2" /><path d="m22 7-10 5L2 7" /></svg>
            </div>
            <div>
              <h3>Mejla ditt doftboard till dig själv</h3>
              <div class="lc-sub">Vi skickar dina sparade dofter så att du kan komma tillbaka till dem när du vill.</div>
            </div>
          </div>
          <form
            class="lead-form"
            id="sq-leadForm"
            novalidate>
            <input
              type="email"
              id="sq-emailInput"
              inputmode="email"
              autocomplete="email"
              placeholder="din@mejl.se"
              aria-label="E-postadress">
            <button type="submit" id="sq-leadSubmitBtn">
              <span id="sq-leadSubmitLabel">Skicka mitt board</span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </button>
            <div class="lead-fine">Ingen spam, bara doftidéer. Avsluta när du vill.</div>
          </form>
          <div class="lead-success" id="sq-leadSuccess">
            <div class="chk">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
            </div>
