          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>

      <!-- ============ INTRO ============ -->
