        <div class="brandbar">
          <span class="fx">Scent Match</span>
        </div>
        <div class="intro-hero">
          <span class="badge-pill">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.7-4.35-9.33-8.24C.9 10.02 1.9 6.5 5.1 5.66c1.98-.52 3.9.37 4.9 1.98C11 6.03 12.92 5.14 14.9 5.66c3.2.84 4.2 4.36 2.43 7.1C18.7 16.65 12 21 12 21z" /></svg>
            Doftquizet
          </span>
          <h1>Hitta din
            <em>signaturdoft</em><br>på 60 sekunder</h1>
          <p class="sub">Swipa genom 24 dofter, spara upp till
            <b>6 favoriter</b>
            och få ditt
            <b>personliga doftboard</b>
            att shoppa från.</p>
          <div class="social-proof">
            <b>10 000+ nöjda kunder</b>
          </div>
          <div class="intro-preview" id="sq-introPreview"></div>
          <div class="steps">
            <div class="step">
              <span class="num">1</span>
              <span class="txt">
                <b>Swipa</b>
                genom 24 dofter</span>
            </div>
            <div class="step">
              <span class="num">2</span>
              <span class="txt">
                <b>Höger</b>
                för att spara,
                <b>vänster</b>
                för att hoppa över</span>
            </div>
            <div class="step">
              <span class="num">3</span>
              <span class="txt">Få ditt
                <b>personliga doftboard</b>
                att shoppa från</span>
            </div>
          </div>
        </div>
        <div class="intro-cta">
          <button class="btn-primary" id="sq-startBtn">
            Börja swipa
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </button>
          <div class="trust">
            <span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>Upp till 21 % parfymolja</span>
            <span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>Håller 12+ timmar</span>
            <span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>Vegansk &amp; cruelty-free</span>
          </div>
        </div>
      </section>

      <!-- ============ DECK ============ -->
      <section id="sq-deck-screen" class="screen">
        <div class="brandbar">
          <span class="fx">Scent Match</span>
        </div>
        <div class="deck-top">
          <div class="progress-wrap">
            <div class="progress-bar" id="sq-progressBar"></div>
          </div>
          <span class="count-chip" id="sq-countChip">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-6.7-4.35-9.33-8.24C.9 10.02 1.9 6.5 5.1 5.66c1.98-.52 3.9.37 4.9 1.98C11 6.03 12.92 5.14 14.9 5.66c3.2.84 4.2 4.36 2.43 7.1C18.7 16.65 12 21 12 21z" /></svg>
            <span id="sq-countNum">0</span>/6 sparade
          </span>
        </div>
        <div class="swipe-hint" id="sq-swipeHint">
          <span class="sh-skip">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.8"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
            <span>Vänster för att
              <b>hoppa över</b>
            </span>
          </span>
          <span class="sh-save">
            <span>Höger för att
              <b>spara</b>
            </span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.8"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </div>
