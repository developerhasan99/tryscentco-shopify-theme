              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M9 14 4 9l5-5" /><path d="M4 9h11a6 6 0 0 1 0 12h-3" /></svg>
            <span class="act-lbl">Ångra</span>
          </button>
          <button
            class="act skip"
            id="sq-skipBtn"
            aria-label="Hoppa över doften">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            <span class="act-lbl">&#8592; Hoppa över</span>
          </button>
          <button
            class="act love"
            id="sq-loveBtn"
