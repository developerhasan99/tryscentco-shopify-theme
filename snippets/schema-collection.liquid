{%- comment -%}
  Collection schema: CollectionPage + ItemList of the first 24 products (SEO update 2026-11-03).
{%- endcomment -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"CollectionPage","@id":{{ request.origin | append: collection.url | append: '#collection' | json }},"name":{{ collection.title | json }},"url":{{ request.origin | append: collection.url | json }},"isPartOf":{"@id":"{{ request.origin }}/#website"},"mainEntity":{"@type":"ItemList","numberOfItems":{{ collection.products_count }},"itemListElement":[{%- for p in collection.products limit: 24 -%}{"@type":"ListItem","position":{{ forloop.index }},"url":{{ request.origin | append: p.url | json }},"name":{{ p.title | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}}
</script>
