{%- comment -%}
  SEO 2026-11-03: FAQPage schema from the custom.faq_json metafield on collections and pages.
  Format: [{"q":"Fråga","a":"Svar"}, ...]
{%- endcomment -%}
{%- liquid
  assign faq = blank
  if template.name == 'collection' and collection.metafields.custom.faq_json != blank
    assign faq = collection.metafields.custom.faq_json.value
  elsif template.name == 'page' and page.metafields.custom.faq_json != blank
    assign faq = page.metafields.custom.faq_json.value
  endif
-%}
{%- if faq != blank and faq.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{%- for f in faq -%}{"@type":"Question","name":{{ f.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
</script>
{%- endif -%}
