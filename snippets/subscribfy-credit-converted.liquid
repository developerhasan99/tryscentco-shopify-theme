{%- comment -%}
  {% render 'subscribfy-credit-converted', amount: customer.metafields.exison.exison_st %}
{%- endcomment -%}
{%- assign exm_credit_usd = amount | default: 0 | times: 1.0 -%}
{%- assign exm_variant_id = shop.metafields.exison.exison_plan_settings.product_variant_id -%}
{%- assign exm_variant = all_products['tryscent-vip-membership'].variants | where: 'id', exm_variant_id | first -%}
{%- assign exm_usd_price = shop.metafields.exison.exison_plan_settings.product_price | times: 1.0 -%}

{%- if exm_variant and exm_usd_price > 0 -%}
  {%- assign exm_credit_cents = exm_credit_usd | times: exm_variant.price | divided_by: exm_usd_price -%}
  {{- exm_credit_cents | money -}}
{%- else -%}
  {{- exm_credit_usd | times: 100 | money -}}
{%- endif -%}
