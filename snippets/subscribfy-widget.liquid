{%- comment -%}
  V2.0
  This snippet is generated and updated by Subscribfy
  Do not modify or remove this snippet, we reserve the right to overwrite it at any moment to add improvements or new features so that customizations you made might be lost.
{%- endcomment -%}
{%- if request.page_type != 'cart' or 1 -%}
  {%- assign exm_plan_settings = shop.metafields.exison.exison_plan_settings -%}

  {%- assign customer_subscription1 = customer.metafields.exison.customer_subscription1 -%}
  {%- assign customer_subscription2 = customer.metafields.exison.customer_subscription2 -%}

  {%- for item in cart.items -%}
    {%- if item.product.variants[0].id == exm_plan_settings.product_variant_id -%}
      {%- assign data-exison-type1-cart = item.product.variants[0].id -%}
      {%- assign type1-cart-qty = item.quantity -%}
    {%- endif -%}
    {%- if item.product.variants[0].id == shop.metafields.exison.exison_plan_settings2.product_variant_id -%}
      {%- assign data-exison-type2-cart = item.product.variants[0].id -%}
      {%- assign type2-cart-qty = item.quantity -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if exm_plan_settings.plan_id > 0 -%}
    {%- assign exm_header_font_medium = settings.type_header_font_family | font_modify: 'weight', '500' -%}
    {%- if exm_header_font_medium -%}
      {%- style -%}
        {{ exm_header_font_medium | font_face: font_display: 'swap' }}
      {%- endstyle -%}
    {%- endif -%}

    <div class="exison-widget__Containe_Wrapper">
      <div
        id="data-exison-type1-cart"
        data-exison-type1-cart="{{data-exison-type1-cart}}"
        data-qty="{{type1-cart-qty}}"
      ></div>
      <div
        id="data-exison-type2-cart"
        data-exison-type2-cart="{{data-exison-type2-cart}}"
        data-qty="{{type2-cart-qty}}"
      ></div>

      {%- if customer_subscription1.status == 'ACTIVE' or customer_subscription2.status == 'ACTIVE' -%}
        <div class="exison-widget__Container" id="cartExisonWidgetContainer" style="display:block;">
          <div id="cartAlreadyExisonWidget" class="exison-widget">
            <div class="exm-titleWrapper">
              <div class="exm_widget_title">
                <div class="exm_widget_title_logo">
                  Tryscent <span class="exm_widget_plus">+</span>
                </div>
                <div class="exm_widget_title_member">
                  Medlem
                </div>
              </div>
              <div class="exm-widget-manage-mem">
                <a class="exm-widget-mm-link" href="/apps/subscribfy-api/store/pages/portal">Hantera medlemskap</a>
              </div>
            </div>
            <div class="exison-widget__description">
              <div id="exisonDesc" class="">
               <div class="exison-widget_info">Medlemsrabatt: <div class="exison-widget_value">Upp till 30% rabatt</div></div>
               <div class="exison-widget_info">Tillgänglig butikskredit: <div class="exison-widget_value">{% render 'subscribfy-credit-converted', amount: customer.metafields.exison.exison_st %}</div> </div>
              </div>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- liquid
        assign exm_vip_variant_id = exm_plan_settings.product_variant_id
        assign exm_vip_variant_key = exm_vip_variant_id | append: ''
        assign exm_plan2_variant_key = shop.metafields.exison.exison_plan_settings2.product_variant_id | append: ''

        assign exm_is_member = false
        if customer_subscription1.status == 'ACTIVE' or customer_subscription2.status == 'ACTIVE'
          assign exm_is_member = true
        endif

        assign exm_goods_qty = 0
        assign exm_has_other_subscription = false

        for item in cart.items
          assign exm_item_key = item.variant.id | append: ''
          if exm_item_key == exm_vip_variant_key or exm_item_key == exm_plan2_variant_key
            continue
          endif
          if item.selling_plan_allocation.selling_plan.id
            assign exm_has_other_subscription = true
          endif
          assign exm_goods_qty = exm_goods_qty | plus: item.quantity
        endfor

        assign exm_tier = 10
        if exm_goods_qty >= 6
          assign exm_tier = 30
        elsif exm_goods_qty >= 3
          assign exm_tier = 25
        endif

        assign exm_show_choice = false
        if exm_plan_settings.status == '1' and exm_vip_variant_id != blank and exm_is_member == false and exm_goods_qty > 0 and exm_has_other_subscription == false
          assign exm_show_choice = true
        endif

        assign exm_proxy_id = 'checkoutExison'
        if exm_is_member
          assign exm_proxy_id = 'checkoutMemberExison'
        endif

        assign exm_checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/'
      -%}

      {%- capture exm_monthly_price -%}
        {%- render 'subscribfy-price-converted', price: exm_plan_settings.product_price -%}
      {%- endcapture -%}
      {%- assign exm_monthly_price = exm_monthly_price | strip -%}

      {%- assign exm_trial_price = '' -%}
      {%- if exm_plan_settings.ft == '1' and exm_plan_settings.ft_price != blank -%}
        {%- assign exm_ft_value = exm_plan_settings.ft_price | times: 1.0 -%}
        {%- if exm_ft_value > 0 -%}
          {%- capture exm_trial_price -%}
            {%- render 'subscribfy-credit-converted', amount: exm_plan_settings.ft_price -%}
          {%- endcapture -%}
          {%- assign exm_trial_price = exm_trial_price | strip -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign exm_trial_fallback = '20,95 kr' -%}
      {%- if cart.currency.iso_code == 'EUR' -%}
        {%- assign exm_trial_fallback = '1,95 €' -%}
      {%- endif -%}

      <div
        class="exm-cta"
        data-exm-cta-block
        data-exm-vip-variant="{{ exm_vip_variant_id }}"
        data-exm-vip-plan="{{ exm_plan_settings.plan_id }}"
      >
        <a
          class="exm-cta__btn exm-cta__btn--guest"
          href="{{ exm_checkout_url }}"
          data-exm-cta="{% if exm_show_choice %}guest{% else %}plain{% endif %}"
        >
          <span class="exm-cta__label">
            {%- if exm_show_choice -%}
              Gästkassa
            {%- else -%}
              {{ 'sections.cart.checkout' | t }}
            {%- endif -%}
          </span>
          <span class="exm-cta__pay">
            <img
              src="{{ 'Klarna_Payment_Badge.svg' | asset_url }}"
              alt="Klarna"
              width="46"
              height="19"
              loading="lazy">
