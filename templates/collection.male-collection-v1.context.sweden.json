Array.prototype.slice.call(track.children);\n    if (!cards.length) return;\n\n    function step(){ return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }\n    function positions(){ return Math.max(1, cards.length - Math.round(track.clientWidth / step()) + 1); }\n    function current(){\n      var max = track.scrollWidth - track.clientWidth;\n      if (track.scrollLeft >= max - 2) return positions() - 1;\n      return Math.round(track.scrollLeft / step());\n    }\n    function go(i){ track.scrollTo({left: i * step(), behavior: 'smooth'}); }\n\n    function buildDots(){\n      dotsWrap.innerHTML = '';\n      for (var i = 0; i < positions(); i++) {\n        var d = document.createElement('button');\n        d.type = 'button';\n        d.className = 'dot';\n        d.setAttribute('aria-label', 'Recension ' + (i + 1));\n        d.addEventListener('click', go.bind(null, i));\n        dotsWrap.appendChild(d);\n      }\n      update();\n    }\n    function update(){\n      var c = current(), n = positions();\n      Array.prototype.forEach.call(dotsWrap.children, function(d, i){ d.classList.toggle('active', i === c); });\n      prev.disabled = c <= 0;\n      next.disabled = c >= n - 1;\n    }\n\n    prev.addEventListener('click', function(){ go(Math.max(0, current() - 1)); });\n    next.addEventListener('click', function(){ go(Math.min(positions() - 1, current() + 1)); });\n    var t;\n    track.addEventListener('scroll', function(){ clearTimeout(t); t = setTimeout(update, 60); });\n    window.addEventListener('resize', buildDots);\n    buildDots();\n  });\n})();\n</script>"
