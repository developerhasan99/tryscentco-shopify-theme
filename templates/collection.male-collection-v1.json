</div>\n  </section>\n</div>\n\n<style>\n  .ts-m22{\n    --ts-hero-img:url('https://cdn.shopify.com/s/files/1/0086/7932/5753/files/tryscent-lp22-hero-male-v9.jpg?v=1787283606');\n    --ts-ink:#14181c;\n    --ts-muted:#5d666e;\n    --ts-accent:#8f6329;\n    width:100vw;\n    margin-left:calc(50% - 50vw);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  .ts-m22 *{box-sizing:border-box}\n  html,body{overflow-x:hidden}\n  .ts-m22-inner{max-width:1200px;margin:0 auto;padding:0 24px}\n\n  /* ---------- hero ---------- */\n  .ts-m22-hero{\n    position:relative;\n    display:flex;\n    align-items:center;\n    height:clamp(430px,33.33vw,600px);\n    background-color:#eef1f3;\n    background-image:var(--ts-hero-img);\n    background-size:cover;\n    background-position:50% 3%;\n    background-repeat:no-repeat;\n  }\n  .ts-m22-hero::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    background:linear-gradient(90deg,rgba(248,248,247,.97) 0%,rgba(248,248,247,.93) 30%,rgba(248,248,247,.72) 46%,rgba(248,248,247,0) 68%);\n  }\n  .ts-m22-hero .ts-m22-inner{position:relative;z-index:1;width:100%}\n  .ts-m22-eyebrow{\n    margin:0 0 10px;\n    font-size:12px;\n    font-weight:700;\n    letter-spacing:.16em;\n    text-transform:uppercase;\n    color:var(--ts-accent);\n  }\n  .ts-m22-eyebrow span{letter-spacing:.06em;margin-right:6px}\n  .ts-m22-hero h1{\n    margin:0 0 12px;\n    font-family:Georgia,\"Times New Roman\",serif;\n    font-weight:400;\n    font-size:clamp(28px,2.8vw,44px);\n    line-height:1.1;\n    letter-spacing:-.015em;\n    max-width:none;\n    white-space:nowrap;\n    color:var(--ts-ink);\n  }\n  .ts-m22-sub{\n    margin:0;\n    max-width:400px;\n    font-size:clamp(15px,1.05vw,17px);\n    line-height:1.5;\n    color:var(--ts-ink);\n  }\n\n  /* ---------- four feature blocks ---------- */\n  .ts-m22-feats{background:#fff;padding:44px 0 40px}\n  .ts-m22-grid{display:grid;grid-template-columns:repeat(4