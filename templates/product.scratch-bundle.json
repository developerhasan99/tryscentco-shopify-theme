    "massive_review_jpzJnz": {
      "type": "massive-review",
      "blocks": {
        "review_gF6wKD": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/ugc8.png",
            "content": "<p>\"Detta är mitt första köp och jag är fast. Jag kommer aldrig att köpa parfym någon annanstans igen. Jag har aldrig kunnat hitta en dupe-doft som verkligen luktade autentiskt och konsekvent.\"</p>",
            "author": "Killian P.",
            "date": "för 1 dag sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "bergamot-sage-cedar-50-ml"
          }
        },
        "review_ByDgLX": {
          "type": "review",
          "settings": {
            "content": "<p>\"Det här är den bästa doften jag har känt på väldigt länge, tonerna gör mig helt lycklig. Jag kommer att ha den här som en ständig favorit för alltid.\"</p>",
            "author": "Jenniffer W.",
            "date": "för 2 dagar sedan",
            "rating": 4,
            "show_verified_badge": true,
            "product": "3x-50ml-perfume-bottles"
          }
        },
        "review_YpX9h9": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/ugc15.png",
            "content": "<p>\"Den luktar väldigt gott, jag älskade den.\"</p>",
            "author": "Castillo B.",
            "date": "för 3 månader sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "tryscent-collection"
          }
        },
        "review_dKt8hn": {
          "type": "review",
          "settings": {
            "content": "<p>\"Alla tre dofterna jag fick är väldigt bra. De håller länge och luktar som de ska. Det enda jag inte var nöjd med var tiden det tog att få dem. Men ärligt talat gjorde jag en andra beställning, så räkna bara med lite väntetid. Haha!<br/>\"</p>",
            "author": "Clara P.",
            "date": "för 2 dagar sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "apple-cinnamon-sandalwood"
          }
        },
        "review_VrkHXh": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/dupestore_3221df98-e409-4141-82ec-bdbe62af3756.jpg",
            "content": "<p>\"Jag har försökt hitta dofter som luktar exklusivt och dessutom håller länge, utan framgång. Den här är precis vad jag letade efter..\"</p>",
