    "fmx_reviews": {
      "type": "fmx-reviews",
      "settings": {
        "color_scheme": "scheme-1",
        "heading": "Älskad av över 10 000 doftälskare",
        "review_text": "Över 10 000 verifierade doftälskare",
        "verified_text": "Verifierad köpare",
